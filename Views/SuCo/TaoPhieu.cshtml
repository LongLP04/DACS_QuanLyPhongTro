@model DACS_QuanLyPhongTro.Models.PhieuGhiNhanSuCo

@{
    ViewData["Title"] = "Tạo phiếu ghi nhận sự cố";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="tao-suco-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="tao-wrapper bg-white rounded-4 shadow-sm p-4 mx-auto" style="max-width: 700px;">
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color: #1ec36e;">Tạo phiếu ghi nhận sự cố</h2>
                <p class="text-muted">Vui lòng mô tả chi tiết sự cố để chủ trọ hỗ trợ xử lý nhanh chóng</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center rounded-4 shadow-sm" id="thongBao">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                </div>
            }

            <form asp-action="TaoPhieu" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MoTaSuCo" class="form-label fw-semibold">Mô tả sự cố</label>
                    <textarea asp-for="MoTaSuCo" class="form-control rounded-3 shadow-sm" rows="4"></textarea>
                    <span asp-validation-for="MoTaSuCo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="HienTrang" class="form-label fw-semibold">Hiện trạng</label>
                    <input asp-for="HienTrang" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="HienTrang" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="GhiChu" class="form-label fw-semibold">Ghi chú</label>
                    <input asp-for="GhiChu" class="form-control rounded-3 shadow-sm" />
                    <span asp-validation-for="GhiChu" class="text-danger small"></span>
                </div>

                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-sm">
                        <i class="bi bi-send-check me-2"></i> Gửi phiếu
                    </button>
                    <a asp-action="Index" asp-controller="SuCo" class="btn btn-outline-secondary rounded-pill px-4 py-2 ms-2 fw-semibold">
                        <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
    document.addEventListener("DOMContentLoaded", () => {
        const thongBao = document.getElementById("thongBao");
        if (thongBao) {
            setTimeout(() => {
                thongBao.style.transition = "opacity 0.5s";
                thongBao.style.opacity = "0";
                setTimeout(() => thongBao.remove(), 500);
            }, 4000);
        }
    });
    </script>
}

<style>
/* === FORM === */
.tao-wrapper {
    border: 1.4px solid #e0e0e0;
    transition: all 0.3s ease;
}
.tao-wrapper:hover {
    border-color: #1ec36e;
    box-shadow: 0 8px 20px rgba(30,195,110,0.15);
}
.form-control:focus {
    border-color: #1ec36e;
    box-shadow: 0 0 0 0.15rem rgba(30,195,110,0.25);
}

/* === BUTTONS === */
.btn-success {
    background-color: #1ec36e;
    border: none;
}
.btn-success:hover {
    background-color: #17a75c;
    transform: scale(1.05);
    box-shadow: 0 8px 14px rgba(30,195,110,0.3);
}
.btn-outline-secondary:hover {
    background-color: #eee;
    transform: scale(1.03);
}
</style>
