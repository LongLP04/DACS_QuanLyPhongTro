@model List<DACS_QuanLyPhongTro.Models.PhieuGhiNhanSuCo>

@{
    ViewData["Title"] = "Danh sách phiếu sự cố";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="suco-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="suco-wrapper bg-white rounded-4 shadow-sm p-4 mx-auto" style="max-width: 1200px;">
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color: #1ec36e;">Danh sách phiếu sự cố</h2>
                <p class="text-muted">Theo dõi các sự cố bạn đã báo với chủ trọ</p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center rounded-4 shadow-sm" id="thongBao">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert alert-light text-center border rounded-4 py-4 shadow-sm">
                    <i class="bi bi-info-circle text-success me-2"></i>Hiện tại không có phiếu sự cố nào.
                </div>
            }
            else
            {
                <div class="table-responsive shadow-sm rounded-4">
                    <table class="table table-hover align-middle suco-table mb-0">
                        <thead class="text-white">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Ngày ghi nhận</th>
                                <th>Mô tả sự cố</th>
                                <th>Hiện trạng</th>
                                <th>Ghi chú</th>
                                <th>Tình trạng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var phieu in Model)
                            {
                                <tr>
                                    <td><strong>@phieu.MaPhieuSuCo</strong></td>
                                    <td>@phieu.NgayGhiNhan.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@phieu.MoTaSuCo</td>
                                    <td>@phieu.HienTrang</td>
                                    <td>@phieu.GhiChu</td>
                                    <td>
                                        @if (phieu.TinhTrang == "Đã xử lý")
                                        {
                                            <span class="badge bg-success text-white px-3 py-2 rounded-pill">
                                                <i class="bi bi-check2-circle me-1"></i> Đã xử lý
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Đang xử lý
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-center mt-4 d-flex justify-content-center gap-3 flex-wrap">
                <a asp-action="TaoPhieu" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-plus-circle me-2"></i> Tạo phiếu mới
                </a>
                <a asp-controller="Phongtrocuatoi" asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay về phòng trọ của tôi
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const thongBao = document.getElementById("thongBao");
    if (thongBao) {
        setTimeout(() => {
            thongBao.style.transition = "opacity 0.5s";
            thongBao.style.opacity = "0";
            setTimeout(() => thongBao.remove(), 500);
        }, 4000);
    }
});
</script>
}

<style>
.suco-page { margin-top: 10px; margin-bottom: 10px; }

/* === TABLE === */
.suco-table thead {
    background-color: #1ec36e;
}
.suco-table th {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 14px;
}
.suco-table td { color: #333; padding: 12px; }
.suco-table tr:hover td {
    background-color: #e8fff1;
    transition: 0.3s ease;
}

/* === BUTTONS === */
.btn-success {
    background-color: #1ec36e;
    border: none;
}
.btn-success:hover {
    background-color: #17a75c;
    transform: scale(1.05);
    box-shadow: 0 8px 14px rgba(30,195,110,0.3);
}
.btn-outline-secondary:hover {
    background-color: #eee;
    transform: scale(1.03);
}
</style>
