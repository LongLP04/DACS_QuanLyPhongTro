@model DACS_QuanLyPhongTro.ViewModels.PhieuDangKyDichVuViewModel

@{
    ViewData["Title"] = "Đăng ký dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="register-service-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="service-wrapper bg-white rounded-4 shadow-sm mx-auto" style="max-width: 1200px;">
            
            <!-- Tiêu đề -->
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color:#1ec36e;">Đăng ký dịch vụ</h2>
                <p class="text-muted">Chọn dịch vụ bạn muốn sử dụng cho phòng trọ hiện tại</p>
            </div>

            <!-- Thông báo -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success text-center rounded-pill shadow-sm">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger text-center rounded-pill shadow-sm">
                    <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
                </div>
            }

            <form asp-action="DangKyNhieu" method="post">
                <!-- Ngày bắt đầu & kết thúc -->
                <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 my-4">
                    <div class="date-input text-center">
                        <label class="fw-semibold mb-1 text-secondary"><i class="bi bi-calendar-event me-2"></i>Ngày bắt đầu</label>
                        <input asp-for="NgayBatDau" type="date" class="form-control text-center border-success shadow-sm" required />
                    </div>
                    <div class="date-input text-center">
                        <label class="fw-semibold mb-1 text-secondary"><i class="bi bi-calendar-check me-2"></i>Ngày kết thúc  </label>
                        <input asp-for="NgayKetThuc" type="date" class="form-control text-center border-secondary shadow-sm" readonly />
                        @* <small class="text-danger fst-italic d-block mt-1">* Kết thúc sau 1 tháng kể từ ngày bắt đầu</small> *@
                    </div>
                </div>

                <!-- Danh sách dịch vụ -->
                <div class="service-grid">
                    @for (int i = 0; i < Model.DichVus.Count; i++)
                    {
                        var dichVu = Model.DichVus[i];
                        <div class="service-card card shadow-sm border-0">
                            <div class="card-body text-center">
                                <input type="hidden" name="SelectedDichVus[@i].MaDichVu" value="@dichVu.MaDichVu" />

                                <div class="service-icon mx-auto mb-3">
                                    <i class="fas fa-concierge-bell"></i>
                                </div>

                                <h5 class="fw-bold text-success">@dichVu.TenDichVu</h5>
                                <p class="text-muted small mb-2">@dichVu.MoTa</p>
                                <p class="fw-semibold text-danger mb-3">
                                    <i class="bi bi-currency-exchange me-1"></i>@dichVu.DonGiaDichVu.ToString("N0") VND
                                </p>

                                <div class="d-flex justify-content-center align-items-center mb-3">
                                    <label class="fw-semibold me-2"><i class="bi bi-sort-numeric-up"></i> Số lượng:</label>
                                    <input type="number" name="SelectedDichVus[@i].SoLuong" value="1" min="1" class="form-control form-control-sm w-25 text-center shadow-sm">
                                </div>

                                <div class="form-check d-inline-flex align-items-center justify-content-center">
                                    <input type="checkbox" class="form-check-input service-checkbox me-2" name="SelectedDichVus[@i].IsSelected" value="true" />
                                    <label class="form-check-label fw-semibold">Chọn dịch vụ này</label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Nút đăng ký -->
                <div class="text-center mt-5">
                    <button id="btnDangKy" type="submit" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-semibold" style="display:none;">
                        <i class="bi bi-check2-circle me-2"></i>Đăng ký các dịch vụ đã chọn
                    </button>
                </div>
            </form>

            <!-- Nút quay lại -->
            <div class="text-center mt-4 mb-3">
                <a asp-controller="Phongtrocuatoi" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-arrow-left-circle me-2"></i>Quay lại phòng trọ của tôi
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const ngayBatDauInput = document.querySelector('input[name="NgayBatDau"]');
            const ngayKetThucInput = document.querySelector('input[name="NgayKetThuc"]');
            const checkboxes = document.querySelectorAll('.service-checkbox');
            const btnDangKy = document.getElementById('btnDangKy');

            function updateNgayKetThuc() {
                const ngayBatDau = new Date(ngayBatDauInput.value);
                if (!isNaN(ngayBatDau)) {
                    const ngayKetThuc = new Date(ngayBatDau);
                    ngayKetThuc.setMonth(ngayKetThuc.getMonth() + 1);
                    const yyyy = ngayKetThuc.getFullYear();
                    const mm = String(ngayKetThuc.getMonth() + 1).padStart(2, '0');
                    const dd = String(ngayKetThuc.getDate()).padStart(2, '0');
                    ngayKetThucInput.value = `${yyyy}-${mm}-${dd}`;
                } else {
                    ngayKetThucInput.value = '';
                }
            }

            function toggleButton() {
                const anyChecked = Array.from(checkboxes).some(chk => chk.checked);
                btnDangKy.style.display = anyChecked ? 'inline-block' : 'none';
            }

            ngayBatDauInput.addEventListener('change', updateNgayKetThuc);
            updateNgayKetThuc();

            checkboxes.forEach(chk => chk.addEventListener('change', toggleButton));
            toggleButton();
        });
    </script>
}

<style>
/* ===== PAGE LAYOUT ===== */
.register-service-page {
    margin-top: 10px;
    margin-bottom: 10px;
}

/* ===== GRID DỊCH VỤ ===== */
.service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

/* ===== THẺ DỊCH VỤ ===== */
.service-card {
    border-radius: 18px;
    transition: all 0.3s ease;
    cursor: pointer;
}
.service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
}
.service-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #e8fff1;
    color: #1ec36e;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    transition: 0.3s;
}
.service-card:hover .service-icon {
    background: #1ec36e;
    color: #fff;
}

/* ===== FORM CONTROL ===== */
.form-control {
    border-radius: 10px !important;
}
.form-control:focus {
    border-color: #1ec36e;
    box-shadow: 0 0 6px rgba(30, 195, 110, 0.3);
}

/* ===== NÚT ===== */
.btn-success {
    background-color: #1ec36e;
    border: none;
}
.btn-success:hover {
    background-color: #17a75c;
}

/* ===== RESPONSIVE ===== */
@@media (max-width: 768px) {
    .service-grid {
        grid-template-columns: 1fr;
    }
}
</style>
