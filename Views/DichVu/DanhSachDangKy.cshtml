@model List<DACS_QuanLyPhongTro.Models.PhieuDangKyDichVu>
@{
    ViewData["Title"] = "Lịch sử đăng ký dịch vụ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="service-history-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="service-history-wrapper bg-white rounded-4 shadow-sm mx-auto" style="max-width: 1250px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary-color">Lịch sử đăng ký dịch vụ</h2>
                <p class="text-muted">Các phiếu đăng ký dịch vụ mà bạn đã thực hiện</p>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-light border text-center py-4 rounded-4 shadow-sm alert-primary-style-empty">
                    <i class="bi bi-info-circle text-primary-color fs-4 d-block mb-2"></i>
                    <span class="fs-5 text-secondary">Bạn chưa đăng ký dịch vụ nào.</span>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var phieu in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card shadow-sm border-0 rounded-4 service-card h-100">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <h5 class="fw-bold text-primary-color mb-0">
                                            <i class="bi bi-receipt-cutoff me-2"></i>Phiếu #@phieu.MaDangKyDichVu
                                        </h5>
                                        @if (phieu.TrangThai == "Đã xác nhận")
                                        {
                                            <span class="badge badge-confirmed rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i>@phieu.TrangThai
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-pending rounded-pill px-3 py-2">
                                                <i class="bi bi-hourglass-split me-1"></i>@phieu.TrangThai
                                            </span>
                                        }
                                    </div>

                                    <div class="small text-muted mb-2">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        Bắt đầu: <strong>@phieu.NgayBatDau.ToString("dd/MM/yyyy")</strong><br />
                                        <i class="bi bi-calendar-check me-1"></i>
                                        Kết thúc: <strong>@phieu.NgayKetThuc.ToString("dd/MM/yyyy")</strong>
                                    </div>

                                    <ul class="list-group mt-3 mb-3 service-detail-list">
                                        @foreach (var ct in phieu.ChiTietPhieuDangKyDichVus)
                                        {
                                            <li class="list-group-item border-0 d-flex justify-content-between align-items-center service-detail-item">
                                                <div class="text-start">
                                                    <strong class="text-dark">@ct.DichVu?.TenDichVu</strong><br />
                                                    <small class="text-muted">Số lượng: @ct.SoLuong</small>
                                                </div>
                                                <span class="fw-bold text-danger">@ct.TongTienDichVu.ToString("N0") VND</span>
                                            </li>
                                        }
                                    </ul>

                                    <div class="mt-auto text-end">
                                        <span class="fw-bold text-secondary small">Tổng: </span>
                                        <span class="fw-bold text-danger fs-5">
                                            @phieu.ChiTietPhieuDangKyDichVus.Sum(x => x.TongTienDichVu).ToString("N0") VND
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="Phongtrocuatoi" asp-action="Index"
                   class="btn btn-outline-primary-color rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay lại phòng trọ của tôi
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --muted: #64748b;
    }

    /* Lớp hỗ trợ màu */
    .text-primary-color {
        color: var(--primary) !important;
    }

    /* === PAGE === */
    .service-history-page {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .alert-primary-style-empty {
        background-color: var(--surface-alt) !important;
        border-color: var(--primary) !important;
    }

    /* === CARD === */
    .service-card {
        border-radius: 16px;
        border: 2px solid var(--surface-alt); /* Viền rất nhẹ */
        transition: all 0.3s ease;
        cursor: default;
        background-color: var(--surface);
    }

        .service-card:hover {
            transform: translateY(-5px);
            /* Khi hover: viền và bóng xanh dương nhạt */
            border-color: var(--primary);
            box-shadow: 0 10px 22px rgba(168, 213, 226, 0.4);
        }

    /* === DANH SÁCH DỊCH VỤ === */
    .service-detail-list {
        max-height: 150px;
        overflow-y: auto;
        background-color: var(--surface-alt);
        border-radius: 12px;
        border: 1px solid var(--primary); /* Viền nhẹ bao ngoài list */
        padding: 6px 0;
    }

    .service-detail-item {
        border-radius: 10px;
        border: 1px solid var(--surface-alt);
        background: var(--surface);
        margin: 6px 10px;
        padding: 10px 14px;
        transition: background 0.2s ease, border-color 0.2s ease;
    }

        .service-detail-item:hover {
            background: var(--surface-alt);
            border-color: var(--primary); /* Khi hover: viền Primary */
        }

    /* === SCROLLBAR NHỎ ĐẸP === */
    .service-detail-list::-webkit-scrollbar {
        width: 6px;
    }

    .service-detail-list::-webkit-scrollbar-thumb {
        background-color: var(--primary-dark);
        border-radius: 8px;
    }

    /* === BADGE TRẠNG THÁI MỚI === */
    /* Đã xác nhận (trước là xanh lá) -> Primary Color */
    .badge-confirmed {
        background-color: var(--primary) !important;
        color: var(--text-dark) !important;
        border: 1px solid var(--primary-dark) !important;
    }
    /* Chờ xác nhận (trước là vàng) -> Accent Color (tím nhạt) */
    .badge-pending {
        background-color: var(--accent) !important;
        color: var(--text-dark) !important;
        border: 1px solid var(--primary-dark) !important;
    }

    /* === NÚT QUAY LẠI (btn-outline-success) -> btn-outline-primary-color */
    .btn-outline-primary-color {
        border-color: var(--primary);
        color: var(--primary);
        transition: all 0.3s;
    }

        .btn-outline-primary-color:hover {
            background-color: var(--primary);
            color: white;
        }

    /* === RESPONSIVE === */
    @@media (max-width: 768px) {
        .service-card {
            margin-bottom: 20px;
        }
    }
</style>