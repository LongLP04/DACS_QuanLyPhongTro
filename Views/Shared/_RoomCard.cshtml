@model dynamic
@{
    // CÁC LOGIC GIỮ NGUYÊN ĐỂ KHÔNG LỖI CHƯƠNG TRÌNH
    var currentArea = (string?)ViewContext.RouteData.Values["area"];
    var areaRoute = string.IsNullOrEmpty(currentArea) ? null : currentArea;
    int? maPhong = null;
    string soPhong = "";
    decimal giaThue = 0;
    string trangThai = "";
    string hinhanh = null;
    string khachThueName = string.Empty;

    try { maPhong = (int?)Model.MaPhong; } catch { }
    try { soPhong = (string?)Model.SoPhong ?? string.Empty; } catch { }
    try { giaThue = (decimal?)(Model.GiaThue) ?? 0m; } catch { }
    try { trangThai = (string?)Model.TrangThai ?? string.Empty; } catch { }
    try { hinhanh = (string?)Model.Hinhanh; } catch { }
    try { khachThueName = (string?)(Model.KhachThueName ?? Model.KhachThue?.HoTen ?? Model.KhachThue?.Hoten) ?? string.Empty; } catch { }

    var trimmedStatus = (trangThai ?? string.Empty).Trim();
    var isEmptyStatus = string.IsNullOrEmpty(trimmedStatus) || string.Equals(trimmedStatus, "Trống", System.StringComparison.OrdinalIgnoreCase);
    var isRented = !isEmptyStatus;

    int? maHopDong = null;
    int? latestChiSoId = null;
    int? latestHoaDonId = null;
    try { maHopDong = (int?)Model.MaHopDong; } catch { }
    try { latestChiSoId = (int?)Model.LatestChiSoId; } catch { }
    try { latestHoaDonId = (int?)Model.LatestHoaDonId; } catch { }

    var detailsUrl = Url.Action("Details", "PhongTro", new { id = maPhong, area = areaRoute });
    var imgSrc = string.IsNullOrEmpty(hinhanh) ? Url.Content("~/img/default-product.jpg") : Url.Content("~/" + hinhanh);
}

<div class="card h-100 room-card lofi-room-container shadow-sm border-0">
    @* Hình ảnh vuông (Ratio 1:1) *@
    <div class="room-thumbnail-square">
        <img src="@imgSrc" class="img-fluid" alt="Ảnh phòng" />
        <div class="thumbnail-overlay"></div>
        <div class="price-overlay">@giaThue.ToString("N0") <small>VNĐ</small></div>
    </div>

    <div class="room-details-content p-4 d-flex flex-column flex-grow-1">
        <h5 class="room-title-text mb-3">Phòng @soPhong</h5>

        <div class="mb-3">
            @{
                var statusBg = isRented ? "rgba(255, 183, 178, 0.2)" : "rgba(193, 225, 193, 0.2)";
                var statusColor = isRented ? "#d63031" : "#2d6a4f";
            }
            <span class="status-pill-modern" style="background: @statusBg; color: @statusColor;">
                <span class="dot-blink" style="background: @statusColor;"></span>
                @trangThai
            </span>
        </div>

        <div class="info-row-modern mb-2">
            <i class="fas fa-user-tag info-icon"></i>
            <span class="info-label">Khách thuê:</span>
            <span class="info-value text-truncate">
                @if (!string.IsNullOrEmpty(khachThueName) && isRented)
                {
                    <strong>@khachThueName</strong>
                }
                else
                {
                    <span class="text-muted">Chưa có</span>
                }
            </span>
        </div>

        <div class="room-action-footer mt-auto pt-3 border-top">
            <div class="d-flex justify-content-end gap-2">
                <a href="@detailsUrl" class="btn-room-action blue" title="Xem chi tiết"><i class="fas fa-eye"></i></a>

                @if (!isRented)
                {
                    <a href="@Url.Action("Create", "HopDong", new { area = "ChuTroArea", maPhong = maPhong })" class="btn-room-action orange" title="Lập hợp đồng"><i class="fas fa-file-signature"></i></a>
                }
                else
                {
                    string? hoaDonUrl = latestHoaDonId != null ? Url.Action("Details", "HoaDon", new { area = "ChuTroArea", id = latestHoaDonId.Value }) : Url.Action("Create", "HoaDon", new { area = "ChuTroArea", maPhong = maPhong ?? 0 });
                    string? hopDongUrl = maHopDong != null ? Url.Action("Details", "HopDong", new { area = "ChuTroArea", id = maHopDong.Value }) : Url.Action("Index", "HopDong", new { area = "ChuTroArea" });
                    string? chiSoUrl = latestChiSoId != null ? Url.Action("Details", "ChiSoDienNuoc", new { area = "ChuTroArea", id = latestChiSoId.Value }) : Url.Action("Create", "ChiSoDienNuoc", new { area = "ChuTroArea", maPhong = maPhong ?? 0 });
                    string? phieuDichVuUrl = Url.Action("Index", "PhieuDichVu", new { area = "ChuTroArea", maPhong = maPhong ?? 0 });

                    <a href="@hoaDonUrl" class="btn-room-action" title="Hóa đơn"><i class="fas fa-file-invoice-dollar"></i></a>
                    <a href="@hopDongUrl" class="btn-room-action" title="Hợp đồng"><i class="fas fa-file-contract"></i></a>
                    <a href="@chiSoUrl" class="btn-room-action" title="Điện nước"><i class="fas fa-tachometer-alt"></i></a>
                    <a href="@phieuDichVuUrl" class="btn-room-action" title="Dịch vụ"><i class="fas fa-concierge-bell"></i></a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-red: #ffb7b2;
        --p-green: #c1e1c1;
        --text-main: #2d3748;
    }

    .lofi-room-container {
        border-radius: 28px !important;
        background: #ffffff;
        transition: all 0.4s ease;
        border: 1px solid #f1f5f9 !important;
    }

        .lofi-room-container:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(168, 213, 226, 0.4) !important;
        }

    /* Thumbnail Hình Vuông (Square) */
    .room-thumbnail-square {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1; /* Ép khung hình vuông */
        overflow: hidden;
        border-radius: 28px 28px 0 0;
        background-color: #f8faff;
    }

        .room-thumbnail-square img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* Cắt ảnh để vừa khít hình vuông mà không bị méo */
            transition: 0.6s ease;
        }

    .thumbnail-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40%;
        background: linear-gradient(transparent, rgba(0,0,0,0.15));
    }

    .lofi-room-container:hover .room-thumbnail-square img {
        transform: scale(1.08);
    }

    .price-overlay {
        position: absolute;
        bottom: 15px;
        right: 15px;
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(4px);
        padding: 6px 16px;
        border-radius: 14px;
        font-weight: 850;
        font-size: 0.9rem;
        color: var(--text-main);
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        z-index: 2;
    }

    .room-title-text {
        font-weight: 900;
        color: var(--text-main);
        font-size: 1.35rem;
    }

    .status-pill-modern {
        display: inline-flex;
        align-items: center;
        padding: 5px 14px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.8rem;
        text-transform: uppercase;
    }

    .dot-blink {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        margin-right: 8px;
        display: inline-block;
    }

    .info-row-modern {
        display: flex;
        align-items: center;
        font-size: 0.95rem;
        color: #718096;
    }

    .info-icon {
        width: 20px;
        color: var(--p-blue);
        margin-right: 10px;
        font-size: 0.9rem;
    }

    .info-label {
        margin-right: 5px;
    }

    .info-value {
        color: var(--text-main);
    }

    .btn-room-action {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ffffff;
        color: #94a3b8;
        border: 1.5px solid #edf2f7;
        transition: 0.3s;
        text-decoration: none !important;
    }

        .btn-room-action:hover {
            background: var(--p-blue);
            color: white !important;
            transform: scale(1.15);
            border-color: transparent;
        }

        .btn-room-action.blue {
            background: rgba(59, 130, 246, 0.05);
            color: #3b82f6;
        }

        .btn-room-action.orange {
            background: rgba(246, 173, 85, 0.05);
            color: #dd6b20;
        }

    .gap-2 {
        gap: 12px !important;
    }
</style>