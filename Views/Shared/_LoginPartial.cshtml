@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

<div class="dropdown">
    @{
        var displayName = ViewData["ChuTroHoTen"] as string;
        if (string.IsNullOrEmpty(displayName))
        {
            displayName = UserManager.GetUserName(User) ?? User?.Identity?.Name ?? "Tài khoản";
        }
    }

    <button class="btn btn-sm btn-light dropdown-toggle"
            type="button"
            id="accountDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        <i class="fas fa-user me-1"></i> @displayName
    </button>

    <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="accountDropdown">
        @if (SignInManager.IsSignedIn(User))
        {
            <li><h6 class="dropdown-header text-success fw-bold">Xin chào, @UserManager.GetUserName(User)</h6></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post" class="m-0">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                    </button>
                </form>
            </li>
        }
        else
        {
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-2"></i> Đăng nhập</a></li>
            <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register"><i class="bi bi-person-plus me-2"></i> Đăng ký</a></li>
        }
    </ul>
</div>
