    <style>
      :root {
        --primary: #1ec36e;
        --primary-dark: #169a55;
        --accent: #17a2ff;
        --text-dark: #1c1e21;
        --muted: #8f9bb3;
        --surface: #ffffff;
        --surface-alt: #f4f7fb;
      }

      body {
        font-family: "Poppins", "Roboto", sans-serif;
        background: var(--surface-alt);
        color: var(--text-dark);
      }

      header, .navbar, .btn-group {
        overflow: visible !important;
        z-index: 9999 !important;
      }

      #mainNavbar {
        border-bottom: 1px solid rgba(18, 38, 63, 0.08);
        background: rgba(255, 255, 255, 0.98) !important;
        transition: box-shadow 0.2s ease, background 0.2s ease;
      }

      #mainNavbar.scrolled {
        box-shadow: 0 8px 24px rgba(18, 38, 63, 0.08);
        background: #ffffff !important;
      }

      #mainNavbar .navbar-brand {
        display: inline-flex;
        align-items: baseline;
        gap: 0.55rem;
        padding: 0.4rem 1.2rem;
        border-radius: 14px;
        background: linear-gradient(120deg, #ffffff, #effdf5);
        box-shadow: 0 10px 20px rgba(30, 195, 110, 0.15);
        font-family: "Raleway", "Poppins", sans-serif;
        text-transform: none;
        letter-spacing: 0;
        line-height: 1.1;
      }

      #mainNavbar .brand-mark,
      #mainNavbar .brand-text {
        line-height: 1;
      }

      #mainNavbar .brand-mark {
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--primary);
        letter-spacing: 1.2px;
      }

      #mainNavbar .brand-text {
        font-weight: 700;
        font-size: 1.8rem;
        color: var(--text-dark);
        letter-spacing: 1.2px;
        margin-bottom: -0.05rem;
      }

      .navbar-nav .nav-link {
        position: relative;
        padding: 0.75rem 0.5rem;
        color: var(--text-dark);
        transition: color 0.2s ease;
      }

      .navbar-nav .nav-link:hover,
      .navbar-nav .nav-link.active {
        color: var(--primary);
      }

      .navbar-nav .nav-link::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%);
        width: 0;
        height: 3px;
        background: var(--primary);
        border-radius: 999px;
        transition: width 0.2s ease;
      }

      .navbar-nav .nav-link:hover::after,
      .navbar-nav .nav-link.active::after {
        width: 60%;
      }

      .btn-group .dropdown-toggle {
        border-radius: 999px;
        border: 1px solid rgba(18, 38, 63, 0.15);
        padding: 0.4rem 0.9rem;
        transition: border-color 0.2s ease;
        color: var(--text-dark);
      }

      .btn-group .dropdown-toggle:hover {
        border-color: var(--primary);
        color: var(--primary);
      }

      main.main {
        min-height: 70vh;
        padding-top: 10px;
      }

      footer.footer {
        background: #06142e;
        color: #d6e4ff;
        padding: 60px 0 40px;
      }

      footer .icon {
        color: var(--primary);
        background: rgba(30, 195, 110, 0.12);
        border-radius: 12px;
        padding: 12px;
        margin-right: 12px;
      }

      footer h4 {
        color: #ffffff;
        margin-bottom: 12px;
        font-weight: 600;
      }

      footer .social-links a {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.3);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        transition: all 0.2s ease;
      }

      footer .social-links a:hover {
        border-color: var(--primary);
        color: var(--primary);
        transform: translateY(-2px);
      }

      #scroll-top {
        background: var(--primary);
        color: #fff;
        box-shadow: 0 12px 24px rgba(30, 195, 110, 0.3);
      }
        
    </style>
</head>

<body class="index-page">

  
<header id="mainNavbar" class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm py-2">
    <div class="container-xl d-flex align-items-center justify-content-between">

        <!-- LOGO (trái) -->
        <a class="navbar-brand fw-bold me-auto" asp-controller="Home" asp-action="Index">
          <span class="brand-mark">Trọ</span>
          <span class="brand-text ">Quanh Ta</span>
        </a>

        <!-- TOGGLE (mobile) -->
        <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        @inject DACS_QuanLyPhongTro.Services.IUserService userService
        @{
            var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            bool hasRental = false;
            if (User.Identity.IsAuthenticated && !string.IsNullOrEmpty(userId))
            {
                hasRental = await userService.HasActiveRentalAsync(userId);
            }
        }

        <!-- MENU (phải) -->
        <div class="collapse navbar-collapse justify-content-end" id="navbarCollapse">
            <ul class="navbar-nav align-items-center fw-semibold small text-dark ms-auto">

                <!-- Trang chủ -->
                <li class="nav-item mx-2">
                    <a asp-controller="Home" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active text-success" : "")">
                        Trang chủ
                    </a>
                </li>

                <!-- Phòng trọ -->
                <li class="nav-item mx-2">
                    <a asp-controller="PhongTro" asp-action="Index"
                       class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PhongTro" ? "active text-success" : "")">
                        Phòng trọ
                    </a>
                </li>

                <!-- Hiển thị tùy theo trạng thái đăng nhập -->
                @if (!User.Identity.IsAuthenticated)
                {
                    <li class="nav-item mx-2">
                        <span class="nav-link fst-italic text-muted">
                            Hãy
                            <a asp-area="Identity" asp-page="/Account/Register" class="text-success fw-bold">
                                đăng ký
                            </a> /
                            <a asp-area="Identity" asp-page="/Account/Login" class="text-success fw-bold">
                                đăng nhập
                            </a> để xem thêm tiện ích
                        </span>
                    </li>
                }
                @* else if (!hasRental)
                {
                    <li class="nav-item mx-2">
                        <a asp-controller="Notifications" asp-action="Index" asp-route-categoryId="1" class="nav-link">Thông báo lịch hẹn</a>
                    </li>
                    <li class="nav-item mx-2">
                        <a asp-controller="HopDong" asp-action="XacNhan" class="nav-link">Xác nhận hợp đồng</a>
                    </li>
                }
                *@
                else if (hasRental)
                {
                    
                    <li class="nav-item mx-2">
                        <a asp-controller="PhongTroCuaToi" asp-action="Index" class="nav-link">Phòng trọ của tôi </a>
                    </li>
                } 

                @if (User.Identity.IsAuthenticated)
                {
                    <!-- ICON HỢP ĐỒNG -->
                    <li class="nav-item mx-2 position-relative">
                        <a asp-controller="HopDong" asp-action="XacNhan"
                           class="nav-link d-flex align-items-center justify-content-center p-0"
                           title="Hợp đồng chờ xác nhận">
                            <i class="bi bi-file-earmark-text fs-5 text-dark position-relative"></i>
                            <span id="contractBadge"
                                  class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none"></span>
                        </a>
                    </li>

                    <!-- ICON THÔNG BÁO -->
                    <li class="nav-item mx-2 position-relative">
                        <a asp-controller="Notifications" asp-action="Index" asp-route-categoryId="1"
                           class="nav-link d-flex align-items-center justify-content-center p-0"
                           title="Thông báo lịch hẹn">
                            <i class="bi bi-bell fs-5 text-dark position-relative notification-icon"></i>
                            <span id="notificationBadge"
                                  class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle d-none"></span>
                        </a>
                    </li>
                }
            </ul>

            <!-- Dropdown tài khoản (ngoài cùng bên phải) -->
            @if (User.Identity.IsAuthenticated)
            {
                <div class="btn-group ms-3 me-2">
                    <partial name="_LoginPartial" />
                </div>
            }
        </div>
    </div>
</header>


  <main class="main">

    @RenderBody()

  </main>

  <footer id="footer" class="footer light-background">

    <div class="container">
      <div class="row gy-3">
        <div class="col-lg-3 col-md-6 d-flex">
          <i class="bi bi-geo-alt icon"></i>
          <div class="address">
            <h4>Address</h4>
            <p>188/10B Tô Ngọc Vân</p>
            <p>phường Linh Đông, thành phố Hồ Chí Minh</p>
            <p></p>
          </div>

        </div>

        <div class="col-lg-3 col-md-6 d-flex">
          <i class="bi bi-telephone icon"></i>
          <div>
            <h4>Contact</h4>
            <p>
              <strong>Phone:</strong> <span>+84 862 357 096</span><br>
              <strong>Email:</strong> <span>trami27012004@gmail.com</span><br>
            </p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6 d-flex">
          <i class="bi bi-clock icon"></i>
          <div>
            <h4>Support hours</h4>
            <p>
              <strong>Mon-Sat:</strong> <span>11AM - 23PM</span><br>
              <strong>Sunday</strong>: <span>Closed</span>
            </p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6">
          <h4>Follow Us</h4>
          <div class="social-links d-flex">
            <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
            <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
            <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
            <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

      </div>
    </div>

    

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="~/assets/vendor/php-email-form/validate.js"></script>
  <script src="~/assets/vendor/aos/aos.js"></script>
  <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
  <!-- Bootstrap JS (bundle chứa Popper) -->
  <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


  <!-- Main JS File -->
  <script src="~/assets/js/main.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
      document.addEventListener("scroll", () => {
      const header = document.querySelector("#mainNavbar");
      if (!header) return; // tránh lỗi
      if (window.scrollY > 50) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    });

    </script>

</body>

</html>