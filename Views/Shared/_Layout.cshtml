@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = currentController == "Home" && currentAction == "Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>Trọ quanh ta</title>
    <meta name="description" content="Tìm trọ dễ dàng, phong cách Lofi Chill.">
    <meta name="keywords" content="phòng trọ, lofi, pastel, tìm trọ">
    <link href="~/assets/img/images.ico" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Pacifico&display=swap" rel="stylesheet">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/assets/css/main.css" rel="stylesheet">

    <style>
        :root {
            --primary: #a8d5e2;
            --primary-dark: #94c8db;
            --accent: #c7ceea;
            --text-dark: #2d3748;
            --muted: #64748b;
            --surface: #ffffff;
            --surface-alt: #f8faff;
        }

        /* THAY ĐỔI: Cập nhật Font-Family chung cho toàn bộ dự án */
        body {
            background: linear-gradient(135deg, #f0f4f8, #e0eafc, #f2e9f8);
            background-attachment: fixed;
            font-family: "Montserrat", sans-serif !important; /* Font Montserrat thay cho Poppins */
            font-size: 18px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Đảm bảo tất cả các thẻ tiêu đề và in đậm dùng chung font Montserrat để không lỗi dấu */
        h1, h2, h3, h4, h5, h6, .fw-bold, .fw-semibold, strong, b {
            font-family: "Montserrat", sans-serif !important;
        }

        .text-muted, .fst-italic {
            font-size: 0.95em;
        }

        .small {
            font-size: 0.85em;
        }

        .main {
            flex-grow: 1;
            padding-top: 75px;
        }

        body.home-page .main {
            padding-top: 0;
        }

        #mainNavbar {
            background: rgba(255,255,255,0.95) !important;
            backdrop-filter: blur(10px);
        }

            #mainNavbar.scrolled {
                background: #ffffff !important;
                box-shadow: 0 8px 25px rgba(168,213,226,0.25);
            }

        .navbar-brand .brand-mark {
            color: var(--primary);
        }

        .navbar-brand .brand-text {
            color: var(--text-dark);
        }

        .navbar-nav .nav-link:hover {
            color: var(--primary-dark) !important;
        }

        .navbar-nav .nav-link.active {
            background-color: var(--primary);
            color: var(--text-dark) !important;
            padding: 0.5rem 1rem !important;
            border-radius: 0.5rem;
            transition: background-color 0.3s;
        }

        .navbar-nav .nav-link::after {
            background: var(--primary);
        }

        .nav-link.fst-italic a {
            color: var(--primary) !important;
            text-decoration: underline;
        }

            .nav-link.fst-italic a:hover {
                color: var(--primary-dark) !important;
            }

        .notification-badge-color {
            background-color: var(--primary) !important;
            border-color: var(--surface) !important;
        }

        .navbar-nav .bi {
            color: var(--text-dark) !important;
            transition: color 0.3s;
        }

        .navbar-nav .nav-link:hover .bi {
            color: var(--primary-dark) !important;
        }

        .hero-lofi {
            padding: 140px 0 100px;
            text-align: center;
            background: linear-gradient(135deg, #e0eafc, #cfdef3, #f2e9f8);
        }

            .hero-lofi h1 {
                font-family: "Pacifico", cursive !important; /* Giữ nguyên font nghệ thuật cho tiêu đề Hero */
                font-size: 4.5rem;
                font-weight: 400;
                color: var(--text-dark);
                margin-bottom: 0.8rem;
            }

                .hero-lofi h1 span {
                    background: linear-gradient(120deg, var(--accent), var(--primary-dark));
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                    font-size: 1.1em;
                }

            .hero-lofi p.lead {
                font-size: 1.3rem;
                margin-bottom: 0.5rem !important;
            }

            .hero-lofi .btn-lg {
                margin-bottom: 2rem;
            }

        .hero-images {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr;
            grid-template-rows: 200px 200px;
            gap: 1.2rem;
            max-width: 1200px;
            margin: 0 auto 0;
            border: none;
            border-radius: 0;
            box-shadow: none;
        }

            .hero-images > div {
                overflow: hidden;
                border-radius: 1.2rem;
                box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                position: relative;
                transition: transform 0.3s ease;
            }

            .hero-images .large {
                grid-row: span 2;
                grid-column: span 2;
                border-radius: 1.5rem;
            }

            .hero-images > div:nth-child(2), .hero-images > div:nth-child(3),
            .hero-images > div:nth-child(4), .hero-images > div:nth-child(5) {
                border-radius: 1.5rem;
            }

            .hero-images img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 0;
                transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            }

            .hero-images > div:hover img {
                transform: scale(1.05);
            }

            .hero-images > div:hover {
                box-shadow: 0 5px 20px rgba(168, 213, 226, 0.9);
                transform: translateY(-2px);
            }

        .btn-primary {
            background-color: var(--primary);
            border-color: var(--primary);
            color: var(--text-dark);
            font-weight: 600;
        }

            .btn-primary:hover, .btn-primary:active, .btn-primary:focus {
                background-color: var(--primary-dark) !important;
                border-color: var(--primary-dark) !important;
                color: var(--text-dark) !important;
                box-shadow: 0 4px 15px rgba(168,213,226,0.5) !important;
            }

        .footer {
            background-color: var(--surface);
            border-top: 1px solid var(--primary);
            padding: 30px 0;
            width: 100%;
        }

            .footer .icon {
                color: var(--primary);
                font-size: 1.8rem;
                margin-right: 15px;
            }

            .footer h4 {
                font-weight: 700;
            }

            .footer p {
                font-size: 1em;
            }

            .footer .social-links a {
                background: var(--surface-alt);
                color: var(--muted);
                transition: background-color 0.3s, color 0.3s;
            }

                .footer .social-links a:hover {
                    background: var(--primary);
                    color: var(--surface);
                }

        #scroll-top {
            background: var(--primary);
        }

            #scroll-top:hover {
                background: var(--primary-dark);
            }
        /* Style cho slideshow trong khung lớn */
        #slideshow-container {
            position: relative;
            width: 100%;
            height: 100%;
        }

        .slide-img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0; /* Mặc định ẩn */
            transition: opacity 1.5s ease-in-out; /* Hiệu ứng mờ dần trong 1.5 giây */
            z-index: 1;
        }

            .slide-img.active {
                opacity: 1; /* Hiện ảnh có class active */
                z-index: 2;
            }

    </style>
</head>
<body class="@(isHomePage ? "index-page home-page" : "")">

    <header id="mainNavbar" class="navbar navbar-expand-lg navbar-light bg-white fixed-top shadow-sm py-2">
        <div class="container-xl d-flex align-items-center justify-content-between">
            <a class="navbar-brand fw-bold me-auto" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">Trọ</span>
                <span class="brand-text ">Quanh Ta</span>
            </a>
            <button class="navbar-toggler ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse"
                    aria-controls="navbarCollapse" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            @inject DACS_QuanLyPhongTro.Services.IUserService userService
            @{
                var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                bool hasRental = false;
                if (User.Identity.IsAuthenticated && !string.IsNullOrEmpty(userId))
                {
                    hasRental = await userService.HasActiveRentalAsync(userId);
                }
            }

            <div class="collapse navbar-collapse justify-content-end" id="navbarCollapse">
                <ul class="navbar-nav align-items-center fw-semibold small text-dark ms-auto">
                    <li class="nav-item mx-2">
                        <a asp-controller="Home" asp-action="Index"
                           class="nav-link @(currentController == "Home" ? "active" : "")">
                            Trang chủ
                        </a>
                    </li>
                    <li class="nav-item mx-2">
                        <a asp-controller="PhongTro" asp-action="Index"
                           class="nav-link @(currentController == "PhongTro" ? "active" : "")">
                            Phòng trọ
                        </a>
                    </li>
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item mx-2">
                            <span class="nav-link fst-italic text-muted">
                                Hãy
                                <a asp-area="Identity" asp-page="/Account/Register">đăng ký</a> /
                                <a asp-area="Identity" asp-page="/Account/Login">đăng nhập</a> để xem thêm tiện ích
                            </span>
                        </li>
                    }
                    else if (hasRental)
                    {
                        <li class="nav-item mx-2">
                            <a asp-controller="PhongTroCuaToi" asp-action="Index" class="nav-link">Phòng trọ của tôi </a>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item mx-2 position-relative">
                            <a asp-controller="HopDong" asp-action="XacNhan"
                               class="nav-link d-flex align-items-center justify-content-center p-0"
                               title="Hợp đồng chờ xác nhận">
                                <i class="bi bi-file-earmark-text fs-5 text-dark position-relative"></i>
                                <span id="contractBadge"
                                      class="position-absolute top-0 start-100 translate-middle p-1 border border-light rounded-circle d-none notification-badge-color"></span>
                            </a>
                        </li>
                        <li class="nav-item mx-2 position-relative">
                            <a asp-controller="Notifications" asp-action="Index" asp-route-categoryId="1"
                               class="nav-link d-flex align-items-center justify-content-center p-0"
                               title="Thông báo lịch hẹn">
                                <i class="bi bi-bell fs-5 text-dark position-relative notification-icon"></i>
                                <span id="notificationBadge"
                                      class="position-absolute top-0 start-100 translate-middle p-1 border border-light rounded-circle d-none notification-badge-color"></span>
                            </a>
                        </li>
                    }
                </ul>
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="btn-group ms-3 me-2">
                        <partial name="_LoginPartial" />
                    </div>
                }
            </div>
        </div>
    </header>

    @if (isHomePage)
    {
        <section class="hero-lofi">
            <div class="container">
                <h1>Tìm trọ thật dễ<br><span>Chỉ cần chill và chọn ♡</span></h1>
                <p class="lead mb-4">Những căn trọ xinh xắn, giá mềm, chủ nhà dễ thương đang chờ bạn</p>
                <a asp-controller="PhongTro" asp-action="Index" class="btn btn-primary btn-lg">Bắt đầu tìm trọ ngay</a>

                <div class="hero-images">
                    @* THAY ĐỔI TẠI ĐÂY: Thêm ID và danh sách ảnh vào khung ảnh lớn *@
                    <div class="large" id="slideshow-container">
                        <img src="https://i.pinimg.com/736x/3f/ae/fe/3faefeaf542d08f9c01b8e60e2f5abb0.jpg" class="slide-img active" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/736x/a8/72/ed/a872edfc1cccb7480d7449550af90bdd.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/1200x/90/1a/76/901a76722d9ce3448652d27267c01e2a.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/736x/85/12/c5/8512c58abde73440a0d7fd74279afc8d.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/1200x/97/a3/bb/97a3bbc8b1a62b883542395c555ccee8.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/1200x/fe/e5/23/fee5237c9e4dc0ed16f8efe61280a472.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/736x/37/c4/bc/37c4bc165038f2533bae72bdb455f69f.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/736x/db/d0/3a/dbd03afe6eff4df7e293239d5e7e875b.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/736x/b8/e5/7a/b8e57aa9b06ee74a3f228bc8677e0ffa.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/1200x/49/7a/b1/497ab125c3b8a23fe6e27e6180f02bbc.jpg" class="slide-img" alt="Phòng lớn">
                        <img src="https://i.pinimg.com/1200x/de/be/52/debe52c9de680cfda084de595a7bb8cb.jpg" class="slide-img" alt="Phòng lớn">
                    </div>

                    <div><img src="https://i.pinimg.com/1200x/e4/2d/10/e42d10a1857b3cb588e58aa3e01c3aef.jpg" alt="Ảnh nhỏ 1"></div>
                    <div><img src="https://i.pinimg.com/736x/c7/86/99/c786992cc869423b6b92e1bbf7ab1235.jpg" alt="Ảnh nhỏ 2"></div>
                    <div><img src="https://i.pinimg.com/1200x/23/98/3a/23983a26a13563d318a27143ffc7dd3d.jpg" alt="Ảnh nhỏ 3"></div>
                    <div><img src="https://i.pinimg.com/736x/93/af/ed/93afed7192a35372d2085ac2bdebbf21.jpg" alt="Ảnh nhỏ 4"></div>
                </div>
            </div>
        </section>
    }

    <main class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer light-background">
        <div class="container">
            <div class="row gy-3">
                <div class="col-lg-3 col-md-6 d-flex">
                    <i class="bi bi-geo-alt icon"></i>
                    <div class="address">
                        <h4>Address</h4>
                        <p>188/10B Tô Ngọc Vân</p>
                        <p>phường Linh Đông, thành phố Hồ Chí Minh</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex">
                    <i class="bi bi-telephone icon"></i>
                    <div>
                        <h4>Contact</h4>
                        <p>
                            <strong>Phone:</strong> <span>+84 862 357 096</span><br>
                            <strong>Email:</strong> <span>trami27012004@gmail.com</span>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 d-flex">
                    <i class="bi bi-clock icon"></i>
                    <div>
                        <h4>Support hours</h4>
                        <p>
                            <strong>Mon-Sat:</strong> <span>11AM - 23PM</span><br>
                            <strong>Sunday</strong>: <span>Closed</span>
                        </p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h4>Follow Us</h4>
                    <div class="social-links d-flex">
                        <a href="#" class="twitter"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="linkedin"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
    <div id="preloader"></div>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/main.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("scroll", () => {
            const header = document.querySelector("#mainNavbar");
            if (!header) return;
            if (window.scrollY > 50) header.classList.add("scrolled");
            else header.classList.remove("scrolled");
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const slides = document.querySelectorAll("#slideshow-container .slide-img");
            let currentSlide = 0;

            function nextSlide() {
                // Xóa class active của ảnh hiện tại
                slides[currentSlide].classList.remove("active");

                // Tính toán ảnh tiếp theo
                currentSlide = (currentSlide + 1) % slides.length;

                // Thêm class active cho ảnh tiếp theo
                slides[currentSlide].classList.add("active");
            }

            // Chạy hàm đổi ảnh mỗi 3000ms (3 giây)
            if(slides.length > 0) {
                setInterval(nextSlide, 3000);
            }
        });
    </script>
</body>
</html>