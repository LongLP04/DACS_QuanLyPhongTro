@model DACS_QuanLyPhongTro.Models.HoaDon

@{
    ViewData["Title"] = "Thanh toán hóa đơn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="payment-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="payment-wrapper bg-white rounded-5 shadow-sm p-4 mx-auto" style="max-width: 900px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary-color">Thanh toán hóa đơn</h2>
                <p class="text-muted">Vui lòng kiểm tra thông tin và chọn phương thức thanh toán</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 payment-detail-card mb-4">
                <div class="card-body">
                    <p><strong>Phòng:</strong> @Model.PhongTro.SoPhong</p>
                    <p><strong>Ngày lập:</strong> @Model.NgayLap.ToString("dd/MM/yyyy")</p>
                    <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TongTien.ToString("N0") VNĐ</span></p>
                    <p>
                        <strong>Trạng thái:</strong>
                        @if (@Model.TrangThai == "Chưa thanh toán")
                        {
                            <span class="badge badge-pending px-3 py-2 rounded-pill">Chưa thanh toán</span>
                        }
                        else
                        {
                            <span class="badge badge-confirmed px-3 py-2 rounded-pill">Đã thanh toán</span>
                        }
                    </p>
                </div>
            </div>

            <div class="payment-method-container mb-4">
                <h5 class="fw-bold text-primary-color">
                    <i class="bi bi-credit-card me-2"></i>Chọn phương thức thanh toán
                </h5>

                <div class="payment-method-options">
                    @foreach (var pt in ViewBag.PhuongThuc as List<DACS_QuanLyPhongTro.Models.PhuongThucThanhToan>)
    {
        @if (pt.TenPhuongThuc.ToLower().Contains("vnpay"))
        {
            @* Form VNPay: Giữ nguyên logic submit chuẩn *@
            <form method="post" action="@Url.Action("CreatePaymentUrlVnpay", "Payment")" class="d-flex">
                <input type="hidden" name="invoiceId" value="@Model.MaHoaDon" />
                <button type="submit" class="payment-method vnpay-button-custom">
                    <img src="@Url.Content("~/images/vnpay.png")" alt="VNPay" class="payment-method-img mb-2" />
                    <span class="fw-semibold d-block text-dark">Thanh toán VNPay</span>
                </button>
            </form>
        }
        else
        {
            @* Các phương thức còn lại hiện ô vuông chọn như cũ *@
            <div class="payment-method text-center" onclick="selectPaymentMethod(@pt.MaPhuongThuc, '@pt.TenPhuongThuc')">
                <img src="@Url.Content("~/images/" + pt.TenPhuongThuc + ".png")" alt="@pt.TenPhuongThuc" class="payment-method-img mb-2" />
                <span class="fw-semibold d-block">@pt.TenPhuongThuc</span>
            </div>
        }
    }
                </div>
            </div>

            <form method="post" asp-action="XacNhanThanhToan" asp-route-id="@Model.MaHoaDon">
                <input type="hidden" name="maPhuongThuc" id="selectedPaymentMethod" />
                <div id="confirmation" class="confirmation-box text-center mt-4" style="display:none;">
                    <p id="confirmationMessage" class="text-dark mb-3"></p>
                    <button type="submit" class="btn btn-primary-filled rounded-pill px-4 shadow-sm fw-semibold me-2">
                        <i class="bi bi-check-circle me-1"></i> Xác nhận thanh toán
                    </button>
                    <button type="button" class="btn btn-outline-muted rounded-pill px-4 shadow-sm" onclick="cancelPayment()">
                        <i class="bi bi-x-circle me-1"></i> Hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --muted: #64748b;
    }

    /* Lớp hỗ trợ màu */
    .text-primary-color {
        color: var(--primary) !important;
    }

    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
    }

    .btn-outline-muted {
        border-color: var(--muted);
        color: var(--muted);
        transition: all 0.3s;
    }

        .btn-outline-muted:hover {
            background-color: var(--muted);
            color: white;
        }

    /* Badge */
    .badge-confirmed {
        background-color: var(--primary) !important;
        color: var(--text-dark) !important;
    }

    .badge-pending {
        background-color: var(--accent) !important;
        color: var(--text-dark) !important;
    }

    .payment-wrapper {
        border-radius: 1.5rem !important;
        border: 1.5px solid var(--surface-alt);
    }

    .payment-detail-card {
        border: 1px solid var(--primary-dark) !important;
        background-color: var(--surface-alt) !important;
    }


    /* === PHƯƠNG THỨC THANH TOÁN === */
    .payment-method-options {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .payment-method {
        width: 130px;
        padding: 15px;
        background-color: var(--surface);
        border: 2px solid var(--surface-alt);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .payment-method:hover, .payment-method.selected {
            border-color: var(--primary);
            box-shadow: 0 6px 15px rgba(168, 213, 226, 0.4);
            transform: translateY(-3px);
        }

    .payment-method-img {
        width: 70px;
        height: 70px;
        object-fit: contain;
    }

    /* === KHUNG XÁC NHẬN === */
    .confirmation-box {
        background-color: var(--surface-alt);
        border: 1px solid var(--primary);
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 4px 15px rgba(168, 213, 226, 0.2);
    }

    /* === NÚT === */
    .btn-primary-filled:hover {
        background-color: var(--primary-dark);
        transform: scale(1.03);
        box-shadow: 0 8px 14px rgba(168, 213, 226, 0.5);
    }
    /* Custom button VNPay (trước là btn-info) */
    .btn-vnpay-custom {
        background-color: var(--primary-dark) !important;
        color: var(--text-dark) !important;
    }

        .btn-vnpay-custom:hover {
            background-color: var(--primary) !important;
        }

</style>

@section Scripts {
    <script>
        let selectedMethodId = null;

        function selectPaymentMethod(methodId, methodName) {
            // Remove 'selected' class from all methods
            document.querySelectorAll('.payment-method').forEach(el => {
                el.classList.remove('selected');
                el.style.borderColor = 'var(--surface-alt)';
            });

            // Add 'selected' class to the clicked method
            const clickedMethod = event.currentTarget;
            clickedMethod.classList.add('selected');
            clickedMethod.style.borderColor = 'var(--primary)';


            selectedMethodId = methodId;
            document.getElementById("selectedPaymentMethod").value = selectedMethodId;

            const box = document.getElementById("confirmation");
            const msg = document.getElementById("confirmationMessage");
            msg.textContent = `Bạn có chắc chắn muốn thanh toán bằng ${methodName}?`;
            box.style.display = 'block';
        }

        function cancelPayment() {
            selectedMethodId = null;
            document.getElementById("confirmation").style.display = 'none';
            // Reset border color of selected item if cancelled
            document.querySelectorAll('.payment-method').forEach(el => {
                el.classList.remove('selected');
                el.style.borderColor = 'var(--surface-alt)';
            });
        }
    </script>
}