@model IEnumerable<DACS_QuanLyPhongTro.Models.PhieuThanhToan>
@{
    ViewData["Title"] = "Lịch sử thanh toán";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var vnd = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<section class="history-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="history-wrapper bg-white rounded-5 shadow-sm p-4 mx-auto" style="max-width: 1100px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary-color">Lịch sử thanh toán</h2>
                <p class="text-muted">Theo dõi các giao dịch thanh toán của bạn</p>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-light text-center border rounded-4 py-4 shadow-sm alert-primary-style-empty">
                    <i class="bi bi-receipt-cutoff text-primary-color me-2"></i>Bạn chưa có giao dịch nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle shadow-sm rounded-4 overflow-hidden history-table">
                        <thead class="text-dark">
                            <tr>
                                <th>Phòng</th>
                                <th>Ngày thanh toán</th>
                                <th>Phương thức</th>
                                <th>Số tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ptt in Model)
                            {
                                <tr>
                                    <td><strong>@ptt.HoaDon?.PhongTro?.SoPhong</strong></td>
                                    <td>@ptt.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                                    <td>@ptt.PhuongThucThanhToan?.TenPhuongThuc</td>
                                    <td class="text-danger fw-semibold">@ptt.SoTienThanhToan.ToString("C0", vnd)</td>
                                    <td>
                                        @if (ptt.HoaDon?.TrangThai == "Chờ xác nhận")
                                        {
                                            <span class="badge badge-pending px-3 py-2 rounded-pill">
                                                <i class="bi bi-hourglass-split me-1"></i> Chờ xác nhận
                                            </span>
                                        }
                                        else if (ptt.HoaDon?.TrangThai == "Đã thanh toán")
                                        {
                                            <span class="badge badge-confirmed px-3 py-2 rounded-pill">
                                                <i class="bi bi-check2-circle me-1"></i> Đã xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white px-3 py-2 rounded-pill">
                                                @ptt.HoaDon?.TrangThai
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="PhieuThanhToan" asp-action="Index"
                   class="btn btn-primary-filled rounded-pill px-4 py-2 shadow-sm fw-semibold btn-hover-scale">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay về hóa đơn thanh toán
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --muted: #64748b;
    }

    /* Lớp hỗ trợ màu */
    .text-primary-color {
        color: var(--primary) !important;
    }

    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
    }

    /* Badge */
    .badge-confirmed {
        background-color: var(--primary) !important;
        color: var(--text-dark) !important;
    }

    .badge-pending {
        background-color: var(--accent) !important;
        color: var(--text-dark) !important;
    }

    .alert-primary-style-empty {
        background-color: var(--surface-alt) !important;
        border-color: var(--primary) !important;
    }


    .history-page {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .history-wrapper {
        border-radius: 1.5rem !important; /* Bo góc lớn hơn */
        border: 1.5px solid var(--surface-alt);
    }

        .history-wrapper:hover {
            border-color: var(--primary);
            box-shadow: 0 8px 20px rgba(168, 213, 226, 0.4);
        }


    /* === BẢNG === */
    .history-table {
        border: 1px solid var(--surface-alt);
        border-radius: 14px;
        background-color: var(--surface);
    }

        .history-table thead {
            background-color: var(--primary-dark);
        }

        .history-table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.5px;
            padding: 14px;
            color: var(--text-dark);
        }

        .history-table td {
            color: #333;
            padding: 12px;
        }

        .history-table tr:hover td {
            background-color: var(--surface-alt);
            transition: background-color 0.3s ease;
        }

    /* === NÚT === */
    .btn-hover-scale {
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .btn-primary-filled:hover {
        background-color: var(--primary-dark);
        transform: scale(1.05);
        box-shadow: 0 8px 14px rgba(168, 213, 226, 0.5);
    }
</style>