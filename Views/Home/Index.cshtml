@model dynamic
@{
    ViewData["Title"] = "Trọ Quanh Ta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ThongBao"] != null)
{
    <div class="alert text-center mt-3" id="thongBao" role="alert"
         style="background-color: var(--primary); color: var(--text-dark); border-color: var(--primary-dark);">
        @TempData["ThongBao"]
    </div>
}

<section id="featured" class="services section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Phòng trọ nổi bật ✨</h2>
        <p>Những lựa chọn được yêu thích nhất, được chọn lọc bởi team Lofi</p>
    </div>

    <div class="container">
        <div class="row gy-4">

            <div class="col-lg-3 col-md-6" data-aos="fade-right" data-aos-delay="50">
                <div class="product-offer feature-equal">
                    <img src="https://i.pinimg.com/736x/7e/ea/25/7eea25a3818fd43c8466b24a9d910d24.jpg"
                         alt="Special Offer" class="offer-img">

                    <div class="offer-text offer-text-body">
                        <h6 class="text-white text-uppercase">Ưu đãi độc quyền</h6>
                        <h3 class="text-white mb-3">Save 20% ✨</h3>
                        <a asp-controller="PhongTro" asp-action="Index" class="btn-get-started">Tham khảo ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="150">
                <div class="product-offer feature-equal">
                    <img src="https://i.pinimg.com/736x/00/9c/aa/009caa356cdafcdd850e8c765581086c.jpg"
                         alt="Căn hộ cao cấp" class="offer-img">

                    <div class="offer-text offer-text-body">
                        <h6 class="text-white text-uppercase">Căn hộ Mini</h6>
                        <h3 class="text-white mb-3">Thiết kế ấn tượng 🎨</h3>
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-searchTerm="trung tâm"
                           class="btn-get-started">Tham khảo ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-down" data-aos-delay="250">
                <div class="product-offer feature-equal">
                    <img src="https://i.pinimg.com/1200x/aa/7e/c2/aa7ec2d34dbf13dbb645844b1b401139.jpg"
                         alt="Hot Deal" class="offer-img">

                    <div class="offer-text offer-text-body">
                        <h6 class="text-white text-uppercase">Deal nóng</h6>
                        <h3 class="text-white mb-3">Giảm 15%</h3>
                        <a asp-controller="PhongTro" asp-action="Index" class="btn-get-started">Tham khảo ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-left" data-aos-delay="350">
                <div class="product-offer feature-equal">
                    <img src="https://i.pinimg.com/736x/c4/b0/6b/c4b06b55113622d33a9795e8e0ed6f7e.jpg"
                         alt="Phòng trọ giá rẻ" class="offer-img">

                    <div class="offer-text offer-text-body">
                        <h6 class="text-white text-uppercase">Tiết kiệm</h6>
                        <h3 class="text-white mb-3">Chỉ từ 1.5 triệu 💸</h3>
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-maxPrice="1500000"
                           class="btn-get-started">Tham khảo ngay</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section id="categories" class="services section light-background">
    <div class="container section-title" data-aos="fade-up">
        <h2>Phân loại phòng trọ 🏡</h2>
        <p>Chọn loại phòng phù hợp với nhu cầu của bạn</p>
    </div>

    <div class="container">
        <div class="row gy-4">

            <div class="col-lg-3 col-md-6" data-aos="fade-up">
                <div class="service-item lofi-card-category text-center">
                    <img src="https://i.pinimg.com/736x/a8/9d/7b/a89d7b5c9a53835d78bd7de9dadb8aea.jpg"
                         class="category-img" alt="Trọ truyền thống">

                    <div class="card-content-body">
                        <h4 class="category-title">Trọ truyền thống</h4>
                        <p class="category-desc">Giá hợp lý, chỉ từ 2 triệu đồng.</p>
                    </div>

                    <div class="card-button-footer">
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-maxPrice="2000000"
                           class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="service-item lofi-card-category text-center">
                    <img src="https://i.pinimg.com/1200x/0b/1a/00/0b1a00fd7eacdc51b572735242d4f690.jpg"
                         class="category-img" alt="Trọ cao cấp">

                    <div class="card-content-body">
                        <h4 class="category-title">Trọ cao cấp</h4>
                        <p class="category-desc">Không gian hiện đại, tiện nghi, giá từ 4 triệu đồng.</p>
                    </div>

                    <div class="card-button-footer">
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-minPrice="4000000"
                           class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="service-item lofi-card-category text-center">
                    <img src="https://i.pinimg.com/736x/da/54/4c/da544cf5f49bb8d273b1b0979035fa13.jpg"
                         class="category-img" alt="Căn hộ Mini">

                    <div class="card-content-body">
                        <h4 class="category-title">Căn hộ Mini</h4>
                        <p class="category-desc">Thiết kế phá cách, trung tâm Quận 1.</p>
                    </div>

                    <div class="card-button-footer">
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-searchTerm="Quận 1"
                           class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="service-item lofi-card-category text-center">
                    <img src="https://i.pinimg.com/736x/52/01/3f/52013fad7fecccf02ba7bf957eb8ca4c.jpg"
                         class="category-img" alt="Trọ gia đình">

                    <div class="card-content-body">
                        <h4 class="category-title">Trọ gia đình</h4>
                        <p class="category-desc">Không gian rộng rãi, phù hợp cho gia đình.</p>
                    </div>

                    <div class="card-button-footer">
                        <a asp-controller="PhongTro" asp-action="Index" asp-route-minArea="40" asp-route-maxArea="60"
                           class="btn btn-primary">Xem ngay</a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section id="features" class="features section">
    <div class="container section-title" data-aos="fade-up">
        <h2>Tiêu chí của chúng tôi ♡</h2>
        <p>Những lý do bạn nên chọn Trọ Quanh Ta</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">

            <div class="col-lg-3 col-md-6">
                <div class="service-item lofi-feature-card text-center">
                    <div class="icon"><i class="bi bi-house-door"></i></div>
                    <h4>Phòng trọ chất lượng</h4>
                    <p>Đầy đủ tiện nghi, an toàn và sạch sẽ.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item lofi-feature-card text-center">
                    <div class="icon"><i class="bi bi-eye"></i></div>
                    <h4>Xem phòng trực tiếp</h4>
                    <p>Trải nghiệm thực tế trước khi thuê.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item lofi-feature-card text-center">
                    <div class="icon"><i class="bi bi-tag"></i></div>
                    <h4>Giá cả hợp lý</h4>
                    <p>Phù hợp với mọi đối tượng sinh viên và người đi làm.</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="service-item lofi-feature-card text-center">
                    <div class="icon"><i class="bi bi-headset"></i></div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Đội ngũ tư vấn, hỗ trợ khách thuê mọi lúc.</p>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --muted: #64748b;
        --surface: #ffffff;
        --surface-alt: #f8faff;
    }

    .section {
        padding: 70px 0;
    }

    .section-title h2 {
        font-weight: 700;
        color: var(--text-dark);
        position: relative;
        display: inline-block;
    }

        .section-title h2::after {
            content: "";
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 80px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 2px;
        }

    .section-title p {
        color: var(--muted);
        font-size: 1.1em; /* Tinh chỉnh cỡ chữ mô tả */
    }

    .btn-primary,
    .btn-get-started {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark)) !important;
        border: none !important;
        color: var(--text-dark) !important;
        font-weight: 600;
        border-radius: 50px !important;
        padding: 10px 28px !important;
        box-shadow: 0 6px 20px rgba(168,213,226,0.4);
        transition: all .3s;
    }

        .btn-primary:hover,
        .btn-get-started:hover {
            opacity: .9;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(168,213,226,0.6);
        }

    /* === FEATURED ROOMS STYLING === */
    .product-offer {
        position: relative;
        overflow: hidden;
        border-radius: 2rem;
        box-shadow: 0 8px 25px rgba(168,213,226,0.3);
        transition: .3s;
        height: 380px; /* TĂNG CHIỀU CAO CHO PHÒNG NỔI BẬT */
    }

        .product-offer:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(168,213,226,0.7);
        }

    .offer-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: .5s;
    }

    .product-offer:hover .offer-img {
        transform: scale(1.08);
    }

    .offer-text {
        position: absolute;
        inset: 0;
        background: rgba(45,55,72,0.4);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        padding: 20px;
        color: #fff;
        transition: .3s;
    }

    .product-offer:hover .offer-text {
        background: rgba(45,55,72,0.5);
    }

    .feature-equal {
        height: 380px; /* Chiều cao cố định */
    }

    /* === CATEGORY CARD STYLING === */
    .lofi-card-category {
        background: var(--surface);
        border-radius: 2rem;
        box-shadow: 0 8px 30px rgba(199,206,234,.4);
        border: 2px solid var(--surface-alt);
        overflow: hidden;
        transition: .4s;
        height: 100%;
        display: flex;
        flex-direction: column; /* Quan trọng để căn chỉnh nút */
    }

        .lofi-card-category:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(168,213,226,.8);
            border-color: var(--primary);
        }

    .category-img {
        width: 100%;
        height: 250px; /* TĂNG KÍCH THƯỚC HÌNH ẢNH */
        object-fit: cover;
        border-radius: 2rem 2rem 0 0;
        transition: .5s;
    }

    .lofi-card-category:hover .category-img {
        transform: scale(1.1);
    }

    .card-content-body {
        flex-grow: 1; /* Cho phép nội dung mô tả mở rộng */
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .card-button-footer {
        padding: 0 20px 20px 20px;
        margin-top: auto; /* Đẩy footer chứa nút xuống đáy */
    }

    .category-title {
        font-weight: 800;
        color: var(--text-dark);
        margin: 20px 0 8px;
        font-size: 1.5rem;
    }

    .category-desc {
        color: var(--muted);
        padding-bottom: 5px;
        font-size: 1em;
    }

    /* === FEATURE CARD STYLING (Tiêu chí) === */
    .lofi-feature-card {
        background: var(--surface);
        border-radius: 1.5rem;
        padding: 30px 20px;
        box-shadow: 0 4px 15px rgba(0,0,0,.05);
        transition: .3s;
    }

        .lofi-feature-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(168,213,226,.4);
        }

        .lofi-feature-card .icon {
            font-size: 40px;
            margin-bottom: 15px;
            color: var(--primary);
        }
</style>