@model IEnumerable<DACS_QuanLyPhongTro.Models.HopDong>

@{
    ViewData["Title"] = "Hợp đồng chờ xác nhận";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contract-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="contract-wrapper bg-white rounded-5 shadow-sm p-4 mx-auto" style="max-width: 1100px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary-color">Hợp đồng chờ xác nhận</h2>
                <p class="text-muted">Xem và xác nhận các hợp đồng thuê trọ đang chờ phản hồi của bạn</p>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-light border-0 text-center py-4 rounded-4 shadow-sm alert-primary-style-empty">
                    <i class="bi bi-file-earmark-excel fs-3 text-primary-dark mb-2 d-block"></i>
                    <span class="fs-5 text-muted">Hiện không có hợp đồng nào chờ xác nhận.</span>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var hopDong in Model)
                    {
                        var isConfirmed = hopDong.TrangThai == "Đã Xác Nhận";

                        // Định nghĩa style động dựa trên trạng thái (sử dụng màu Pastel)
                        var listItemBackground = isConfirmed ? "var(--surface-alt)" : "var(--primary)";
                        var listItemBorder = isConfirmed ? "var(--muted)" : "var(--primary-dark)";
                        var listItemColor = isConfirmed ? "var(--muted)" : "var(--text-dark)";
                        var listItemWeight = isConfirmed ? "400" : "600";

                        <li class="list-group-item d-flex flex-wrap justify-content-between align-items-center py-3 px-3 rounded-4 mb-3 border-0 shadow-sm list-item-custom-style"
                            style="
                                        background-color: @listItemBackground;
                                        border-left: 6px solid @listItemBorder;
                                        color: @listItemColor;
                                        font-weight: @listItemWeight;
                                    ">
                            <div class="contract-info mb-3 mb-md-0">
                                <p><i class="bi bi-file-earmark-text me-2 icon-primary"></i><strong>Mã hợp đồng:</strong> @hopDong.MaHopDong</p>
                                <p><i class="bi bi-door-open me-2 icon-primary"></i><strong>Phòng:</strong> @hopDong.PhongTro?.SoPhong</p>
                                <p>
                                    <i class="bi bi-info-circle me-2 icon-primary"></i><strong>Trạng thái:</strong>
                                    <span class="badge @(isConfirmed ? "badge-confirmed" : "badge-pending")">
                                        @hopDong.TrangThai
                                    </span>
                                </p>
                            </div>

                            <form asp-controller="HopDong" asp-action="XacNhan" method="post" class="d-flex gap-2 justify-content-end flex-wrap">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maHopDong" value="@hopDong.MaHopDong" />

                                @if (!isConfirmed)
                                {
                                    <button type="submit" name="dongY" value="true" class="btn btn-primary-filled rounded-pill px-4 py-2 btn-hover">
                                        <i class="bi bi-check-circle me-2"></i> Xác nhận
                                    </button>
                                    <button type="submit" name="dongY" value="false" class="btn btn-danger-pastel rounded-pill px-4 py-2 btn-hover">
                                        <i class="bi bi-x-circle me-2"></i> Từ chối
                                    </button>
                                }
                                else
                                {
                                    <a href="@Url.Action("Details", "HopDong", new { id = hopDong.MaHopDong })" class="btn btn-outline-muted rounded-pill px-4 py-2">
                                        <i class="bi bi-eye me-2"></i> Xem chi tiết
                                    </a>
                                }
                            </form>
                        </li>
                    }
                </ul>
            }

            <div class="text-center mt-4">
                <a asp-controller="Phongtrocuatoi" asp-action="Index"
                   class="btn btn-primary-filled rounded-pill px-4 py-2 shadow-sm btn-hover">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay về phòng trọ của tôi
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --muted: #64748b;
    }

    /* Lớp hỗ trợ màu */
    .text-primary-color {
        color: var(--primary) !important;
    }

    .text-primary-dark {
        color: var(--primary-dark) !important;
    }

    .icon-primary {
        color: var(--primary);
    }

    /* === MÀU BADGE === */
    /* Đã xác nhận (trước là xanh lá) -> Primary Color */
    .badge-confirmed {
        background-color: var(--primary) !important;
        color: var(--text-dark) !important;
        border: 1px solid var(--primary-dark);
    }
    /* Chờ xác nhận (trước là vàng) -> Accent Color (tím nhạt) */
    .badge-pending {
        background-color: var(--accent) !important;
        color: var(--text-dark) !important;
        border: 1px solid var(--primary-dark);
    }

    /* === CÁC NÚT === */
    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
    }

    /* Đổi màu đỏ mặc định (danger) sang màu đỏ pastel nhẹ nhàng hơn */
    .btn-danger-pastel {
        background-color: #ff9999 !important; /* Đỏ pastel */
        color: var(--text-dark) !important;
        border: none;
    }

        .btn-danger-pastel:hover {
            background-color: #ff7777 !important;
        }

    /* Nút outline muted (xem chi tiết khi đã xác nhận) */
    .btn-outline-muted {
        border: 1px solid var(--primary-dark) !important;
        color: var(--primary-dark) !important;
        background: none;
    }

        .btn-outline-muted:hover {
            background: var(--surface-alt) !important;
            color: var(--primary-dark) !important;
        }

    /* === CÁC KHUNG CHỨA === */
    .contract-page {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .contract-wrapper {
        border-radius: 1.5rem !important; /* Bo góc lớn hơn cho khung chính */
        border: 1.5px solid var(--surface-alt);
    }

    /* Khung rỗng */
    .alert-primary-style-empty {
        background-color: var(--surface-alt) !important;
        border-color: var(--primary) !important;
    }

    /* Danh sách hợp đồng */
    .list-group-item {
        background: var(--surface);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.3s ease;
    }

    /* Tinh chỉnh list item để có bo góc 4 góc */
    .list-item-custom-style {
        border-radius: 1rem !important;
        border: 1px solid var(--surface-alt);
    }

        .list-item-custom-style:hover {
            transform: translateY(-2px);
            background: var(--surface-alt) !important;
            box-shadow: 0 4px 10px rgba(168, 213, 226, 0.2);
        }

    .contract-info p {
        margin: 0.25rem 0;
        font-size: 1rem;
    }

    /* Nút hành động */
    .btn-hover {
        transition: all 0.3s ease;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

        .btn-hover:hover {
            /* Đã được định nghĩa trong .btn-primary-filled và .btn-danger-pastel */
            box-shadow: 0 8px 15px rgba(168, 213, 226, 0.4);
        }

        .btn-hover:active {
            transform: scale(0.96);
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .list-group-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .contract-info {
            margin-bottom: 15px;
        }

        .btn-hover {
            width: 100%;
        }
    }
</style>