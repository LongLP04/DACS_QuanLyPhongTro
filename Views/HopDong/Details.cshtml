@model DACS_QuanLyPhongTro.Models.HopDong

@{
    ViewData["Title"] = "Chi tiết hợp đồng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="contract-detail-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="contract-wrapper bg-white rounded-4 shadow-sm p-4 mx-auto" style="max-width: 1100px;">

            <!-- Tiêu đề -->
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color: #1ec36e;">Chi tiết hợp đồng</h2>
                <p class="text-muted">Thông tin chi tiết hợp đồng thuê phòng của bạn</p>
            </div>

            <!-- Hợp đồng + Phòng -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                            <i class="bi bi-file-earmark-text me-2"></i>Thông tin hợp đồng
                        </div>
                        <div class="card-body p-3">
                            <table class="table table-sm align-middle table-borderless contract-table">
                                <tbody>
                                    <tr>
                                        <th><i class="bi bi-calendar-event me-2 text-success"></i>Ngày lập:</th>
                                        <td>@Model.NgayLap.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                    <tr>
                                        <th><i class="bi bi-flag me-2 text-success"></i>Trạng thái:</th>
                                        <td>
                                            @if (Model.TrangThai == "Đã Xác Nhận")
                                            {
                                                <span class="badge bg-success-subtle text-success border rounded-pill px-3 py-2">
                                                    <i class="bi bi-check2-circle me-1"></i>@Model.TrangThai
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-dark border rounded-pill px-3 py-2">
                                                    <i class="bi bi-hourglass-split me-1"></i>@Model.TrangThai
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm border-0 rounded-4">
                        <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                            <i class="bi bi-house-door me-2"></i>Thông tin phòng trọ
                        </div>
                        <div class="card-body p-3">
                            <table class="table table-sm align-middle table-borderless contract-table">
                                <tbody>
                                    <tr><th>Số phòng:</th><td>@Model.PhongTro?.SoPhong</td></tr>
                                    <tr><th>Tòa nhà:</th><td>@Model.PhongTro?.ToaNha?.TenToaNha</td></tr>
                                    <tr><th>Giá thuê:</th><td class="text-danger fw-semibold">@Model.PhongTro?.GiaThue.ToString("N0") VNĐ</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Khách thuê -->
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                    <i class="bi bi-person-circle me-2"></i>Thông tin khách thuê
                </div>
                <div class="card-body p-3">
                    <table class="table table-sm align-middle table-borderless contract-table">
                        <tbody>
                            <tr><th>Họ tên:</th><td>@Model.KhachThue?.HoTen</td></tr>
                            <tr><th>Email:</th><td>@Model.KhachThue?.Email</td></tr>
                            <tr><th>Số điện thoại:</th><td>@Model.KhachThue?.SoDienThoai</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Chủ trọ -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-success text-white fw-semibold rounded-top-4">
                    <i class="bi bi-person-badge me-2"></i>Thông tin chủ trọ
                </div>
                <div class="card-body p-3">
                    <table class="table table-sm align-middle table-borderless contract-table">
                        <tbody>
                            <tr><th>Họ tên:</th><td>@Model.PhongTro?.ToaNha?.ChuTro?.HoTen</td></tr>
                            <tr><th>Email:</th><td>@Model.PhongTro?.ToaNha?.ChuTro?.Email</td></tr>
                            <tr><th>Số điện thoại:</th><td>@Model.PhongTro?.ToaNha?.ChuTro?.SoDienThoai</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Nút quay lại -->
            <div class="text-center mt-5">
                <a asp-controller="Phongtrocuatoi" asp-action="Index" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-semibold">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay lại phòng trọ của tôi
                </a>
            </div>
        </div>
    </div>
</section>

<style>
.contract-table th {
    width: 40%;
    color: #444;
    font-weight: 600;
}
.contract-table td {
    color: #555;
}

.contract-wrapper {
    border: 1.5px solid #dcdcdc;
}

/* === CARD VIỀN & HOVER === */
.card {
    border: 1px solid #dcdcdc !important;
    transition: all 0.3s ease;
}
.card:hover {
    border-color: #1ec36e !important;
    box-shadow: 0 6px 18px rgba(30,195,110,0.15);
}

/* === BADGE MÀU MỚI === */
.bg-success-subtle {
    background-color: #e8fff1 !important;
}
.bg-warning-subtle {
    background-color: #fff8e1 !important;
}

/* === NÚT QUAY LẠI === */
.btn-success {
    background-color: #1ec36e;
    border: none;
}
.btn-success:hover {
    background-color: #17a75c;
    transform: scale(1.05);
    box-shadow: 0 8px 14px rgba(30,195,110,0.3);
}

/* === TOÀN TRANG === */
.contract-detail-page {
    margin-top: 10px;
    margin-bottom: 10px;
}
</style>
