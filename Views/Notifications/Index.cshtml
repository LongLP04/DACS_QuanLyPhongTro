@model List<DACS_QuanLyPhongTro.Models.Notification>

@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<section class="notifications-page section">
    <div class="container py-5">
        <div class="notifications-wrapper mx-auto">

            <div class="welcome-header mb-5 p-5 text-left position-relative overflow-hidden shadow-sm">
                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-md-9">
                        <h2 class="welcome-title">Trung tâm Thông báo 🔔</h2>
                        <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">Cập nhật những tin tức và hoạt động mới nhất từ hệ thống Trọ Quanh Ta.</p>
                    </div>
                    <div class="col-md-3 text-right d-none d-md-block opacity-20">
                        <i class="bi bi- megaphone fa-5x text-white"></i>
                    </div>
                </div>
                <div class="decoration-circle"></div>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="card empty-state-card p-5 text-center shadow-sm border-0">
                    <div class="mb-4">
                        <div class="empty-icon-wrapper mx-auto">
                            <i class="bi bi-bell-slash"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Hộp thư trống</h4>
                    <p class="text-muted">Hiện tại bạn chưa có thông báo nào mới. Hãy quay lại sau nhé!</p>
                </div>
            }
            else
            {
                <div class="notification-list">
                    @foreach (var notification in Model.OrderByDescending(n => n.CreatedAt))
                    {
                        var isRead = notification.IsRead;

                        <div class="notification-item @(isRead ? "read" : "unread") d-flex align-items-start p-4 mb-4 shadow-sm">
                            <div class="notif-icon-wrapper me-4 shadow-sm">
                                <i class="bi @(isRead ? "bi-bell" : "bi-bell-fill")"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge @(isRead ? "bg-light text-muted" : "bg-primary-pastel text-primary-dark") px-3 py-2 rounded-pill">
                                        @(isRead ? "Đã xem" : "Mới")
                                    </span>
                                    <small class="text-muted font-weight-bold uppercase" style="letter-spacing: 0.5px;">
                                        <i class="bi bi-clock me-1"></i> @notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                                <p class="notif-message mb-0 text-dark">@notification.Message</p>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="Home" asp-action="Index" class="btn btn-back-home shadow-sm px-5 py-3">
                    <i class="bi bi-house-door me-2"></i> QUAY LẠI TRANG CHỦ
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --primary-dark: #2c5282;
    }

    .notifications-page {
        background-color: #f8faff;
        font-family: "Montserrat", sans-serif;
        min-height: 80vh;
    }

    .notifications-wrapper {
        max-width: 900px;
    }

    /* Welcome Header */
    .welcome-header {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple));
        border-radius: 30px;
        color: white;
    }

    .welcome-title {
        font-family: "Pacifico", cursive;
        font-size: 2.5rem;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
    }

    .decoration-circle {
        position: absolute;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        top: -50px;
        right: -50px;
    }

    /* Notification Items */
    .notification-item {
        background: var(--surface);
        border-radius: 25px;
        transition: all 0.3s ease;
        border: 2px solid transparent;
        position: relative;
    }

        .notification-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.25) !important;
            border-color: var(--p-blue);
        }

        .notification-item.unread {
            border-left: 8px solid var(--p-blue);
        }

        .notification-item.read {
            opacity: 0.8;
            border-left: 8px solid #edf2f7;
        }

    .notif-icon-wrapper {
        width: 55px;
        height: 55px;
        background: var(--surface-alt);
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--p-blue);
        transition: transform 0.4s ease;
    }

    .notification-item:hover .notif-icon-wrapper {
        transform: rotate(15deg);
        background: var(--p-blue);
        color: white;
    }

    .notif-message {
        font-weight: 600;
        line-height: 1.6;
        font-size: 1.05rem;
    }

    .bg-primary-pastel {
        background-color: var(--p-blue);
        opacity: 0.8;
    }

    /* Empty State */
    .empty-state-card {
        border-radius: 30px;
        background: white;
    }

    .empty-icon-wrapper {
        width: 100px;
        height: 100px;
        background: var(--surface-alt);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #cbd5e1;
    }

    /* Buttons */
    .btn-back-home {
        background: var(--text-dark);
        color: white;
        border-radius: 15px;
        font-weight: 700;
        border: none;
        transition: all 0.3s ease;
        letter-spacing: 1px;
    }

        .btn-back-home:hover {
            background: black;
            transform: scale(1.05);
            color: white;
        }
</style>