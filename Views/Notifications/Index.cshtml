@model List<DACS_QuanLyPhongTro.Models.Notification>

@{
    ViewData["Title"] = "Thông báo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="notifications-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="notifications-wrapper bg-white rounded-5 shadow-sm p-4 mx-auto" style="max-width: 1100px;">

            <div class="text-center mb-4">
                <h2 class="fw-bold text-primary-color">Thông báo của bạn</h2>
                <p class="text-muted">Xem các cập nhật mới nhất từ hệ thống Trọ Quanh Ta</p>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-light border-0 text-center py-4 rounded-4 shadow-sm alert-primary-style-empty">
                    <i class="bi bi-bell-slash fs-3 text-primary-dark mb-2 d-block"></i>
                    <span class="fs-5 text-muted">Hiện tại bạn chưa có thông báo nào.</span>
                </div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var notification in Model.OrderByDescending(n => n.CreatedAt))
                    {
                        var isRead = notification.IsRead;

                        // Định nghĩa style động dựa trên trạng thái (sử dụng màu Pastel)
                        var listItemBackground = isRead ? "var(--surface)" : "var(--surface-alt)";
                        var listItemBorder = isRead ? "var(--muted)" : "var(--primary)";
                        var listItemColor = isRead ? "var(--muted)" : "var(--text-dark)";
                        var listItemWeight = isRead ? "400" : "600";

                        <li class="list-group-item d-flex justify-content-between align-items-start py-3 px-3 rounded-4 mb-2 border-0 shadow-sm list-item-custom-style"
                            style="
                                        background-color: @listItemBackground;
                                        border-left: 6px solid @listItemBorder;
                                        color: @listItemColor;
                                        font-weight: @listItemWeight;
                                    ">
                            <div class="me-3">
                                <i class="bi @(isRead ? "bi-bell" : "bi-bell-fill") me-2 text-primary-color"></i>
                                @notification.Message
                            </div>
                            <small class="text-muted text-nowrap">@notification.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </li>
                    }
                </ul>
            }

            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-primary-filled rounded-pill px-4 py-2 shadow-sm btn-hover">
                    <i class="bi bi-arrow-left-circle me-2"></i> Quay lại trang chủ
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
        --muted: #64748b;
    }

    /* Lớp hỗ trợ màu */
    .text-primary-color {
        color: var(--primary) !important;
    }

    .text-primary-dark {
        color: var(--primary-dark) !important;
    }

    .icon-primary {
        color: var(--primary);
    }

    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
    }

    /* === CÁC KHUNG CHỨA === */
    .notifications-page {
        margin-top: 10px;
        margin-bottom: 10px;
    }

    .notifications-wrapper {
        border-radius: 1.5rem !important; /* Bo góc lớn hơn cho khung chính */
        border: 1.5px solid var(--surface-alt);
    }

    /* Khung rỗng */
    .alert-primary-style-empty {
        background-color: var(--surface-alt) !important;
        border-color: var(--primary) !important;
    }

    /* Danh sách thông báo */
    .list-group-item {
        background: var(--surface);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.3s ease;
        cursor: default;
    }

    /* Tinh chỉnh list item để có bo góc 4 góc */
    .list-item-custom-style {
        border-radius: 1rem !important;
        border: 1px solid var(--surface-alt);
    }


        .list-item-custom-style:hover {
            transform: translateY(-2px);
            background: var(--surface-alt) !important;
            box-shadow: 0 4px 10px rgba(168, 213, 226, 0.2);
        }

    /* Nút quay lại */
    .btn-hover {
        transition: all 0.3s ease;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

        .btn-hover:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 8px 15px rgba(168, 213, 226, 0.5);
        }

        .btn-hover:active {
            transform: scale(0.96);
        }

    /* Icon */
    .bi-bell-fill {
        font-size: 1.1rem;
    }
</style>