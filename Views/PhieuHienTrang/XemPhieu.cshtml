@model DACS_QuanLyPhongTro.Models.PhieuHienTrangNhanPhong

@{
    ViewData["Title"] = "Phiếu hiện trạng nhận phòng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="status-page section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="status-wrapper bg-white rounded-4 shadow-sm p-4 mx-auto" style="max-width: 1100px;">
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color: #1ec36e;">Phiếu hiện trạng khi nhận phòng</h2>
                <p class="text-muted">Vui lòng kiểm tra kỹ các thông tin bên dưới và xác nhận tình trạng</p>
            </div>

            <!-- Thông tin phiếu -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <p class="mb-2"><strong>Ngày nhận phòng:</strong> @Model.NgayNhanPhong.ToString("dd/MM/yyyy")</p>
                    <p class="mb-2"><strong>Ghi chú:</strong> @Model.GhiChu</p>
                    <p class="mb-0 fw-semibold">
                        <strong>Tình trạng:</strong>
                        <span class="badge @(Model.TinhTrang == "Đã xác nhận" ? "bg-success" : "bg-warning text-dark") px-3 py-2">
                            @Model.TinhTrang
                        </span>
                    </p>
                </div>
            </div>

            <!-- Danh sách vật dụng -->
            <h5 class="fw-bold text-success mb-3">
                <i class="bi bi-box-seam me-2"></i>Danh sách vật dụng trong phòng
            </h5>
            <div class="table-responsive shadow-sm rounded-4 overflow-hidden mb-4">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead class="text-white">
                        <tr>
                            <th>Tên vật dụng</th>
                            <th>Tình trạng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.HienTrangVatDungs)
                        {
                            <tr>
                                <td class="fw-semibold">@item.TenVatDung</td>
                                <td class="@(item.TinhTrang.Contains("Tốt") ? "text-success" : "text-warning") fw-semibold">@item.TinhTrang</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Xác nhận -->
            @if (Model.TinhTrang == "Chưa xác nhận")
            {
                <form asp-action="XacNhan" method="post" class="text-center">
                    <input type="hidden" name="maPhieu" value="@Model.MaPhieuHienTrang" />
                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 shadow-sm fw-semibold me-2">
                        <i class="bi bi-check-circle me-1"></i> Tôi xác nhận hiện trạng
                    </button>
                    <a asp-controller="Phongtrocuatoi" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 shadow-sm">
                        <i class="bi bi-arrow-left-circle me-1"></i> Quay lại
                    </a>
                </form>
            }
            else
            {
                <div class="alert alert-success mt-4 text-center rounded-4 shadow-sm py-3 fw-semibold">
                    <i class="bi bi-check2-circle me-2"></i> Bạn đã xác nhận phiếu này.
                </div>
            }
        </div>
    </div>
</section>

<style>
/* === PAGE === */
.status-page { margin-top: 10px; margin-bottom: 10px; }

/* === BẢNG === */
table thead {
    background-color: #1ec36e;
}
table th {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 0.4px;
    padding: 14px;
}
table td {
    padding: 12px;
    color: #333;
}
table tr:hover td {
    background-color: #e8fff1;
    transition: background-color 0.25s ease;
}

/* === CARD === */
.status-wrapper {
    border: 1.4px solid #dcdcdc;
    transition: all 0.3s ease;
}
.status-wrapper:hover {
    border-color: #1ec36e;
    box-shadow: 0 8px 20px rgba(30,195,110,0.15);
}

/* === BUTTONS === */
.btn-success {
    background-color: #1ec36e;
    border: none;
}
.btn-success:hover {
    background-color: #17a75c;
    transform: scale(1.05);
    box-shadow: 0 8px 14px rgba(30,195,110,0.3);
}
.btn-outline-secondary:hover {
    background-color: #eee;
    transform: scale(1.03);
}
</style>
