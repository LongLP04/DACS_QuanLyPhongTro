@using Microsoft.AspNetCore.Mvc.Localization
@model dynamic

@{
    ViewData["Title"] = "Phiếu hiện trạng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="status-empty section">
    <div class="container-fluid px-xl-5 py-5">
        <div class="empty-wrapper bg-white rounded-5 shadow-sm p-5 mx-auto text-center" style="max-width: 700px;">
            <i class="bi bi-exclamation-triangle-fill text-warning mb-3 icon-pastel-warning" style="font-size: 3rem;"></i>
            <h4 class="fw-bold text-dark mb-2">Hiện tại bạn chưa có phiếu hiện trạng nào được tạo</h4>
            <p class="text-muted mb-4">Phiếu sẽ được hiển thị khi bạn nhận phòng và xác nhận với chủ trọ.</p>
            <a asp-controller="Phongtrocuatoi" asp-action="Index"
               class="btn btn-primary-filled rounded-pill px-4 py-2 shadow-sm fw-semibold btn-hover-scale">
                <i class="bi bi-arrow-left-circle me-2"></i> Quay về phòng trọ của tôi
            </a>
        </div>
    </div>
</section>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --text-dark: #2d3748;
        --surface-alt: #f8faff;
        --warning-pastel: #ffe0a3; /* Vàng pastel */
    }

    /* Icon cảnh báo (text-warning) */
    .icon-pastel-warning {
        color: var(--warning-pastel) !important;
    }

    /* === CARD WRAPPER === */
    .empty-wrapper {
        border: 1.4px solid var(--surface-alt);
        border-radius: 1.5rem !important; /* Bo góc lớn hơn */
        transition: all 0.3s ease;
    }

        .empty-wrapper:hover {
            border-color: var(--primary);
            /* Đổ bóng màu Primary */
            box-shadow: 0 8px 20px rgba(168, 213, 226, 0.4);
        }

    /* === NÚT HÀNH ĐỘNG === */
    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
    }

    .btn-hover-scale {
        transition: all 0.3s ease;
        font-weight: 600;
    }

    .btn-primary-filled:hover {
        background-color: var(--primary-dark);
        transform: scale(1.05);
        /* Đổ bóng màu Primary */
        box-shadow: 0 8px 14px rgba(168, 213, 226, 0.5);
    }

    /* Reset margin cho section */
    .status-empty {
        padding-top: 100px;
        padding-bottom: 100px;
    }
</style>