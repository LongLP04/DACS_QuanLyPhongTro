@model DACS_QuanLyPhongTro.Models.PhongTro
@{
    ViewData["Title"] = "Phòng trọ của tôi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
        --surface-alt: #f8faff;
    }

    /* === CHỈ CHỈNH SỬA 3 THẺ TỔNG QUAN DƯỚI ĐÂY === */
    .dashboard-card-custom {
        background: white;
        border-radius: 25px !important;
        padding: 30px 20px;
        border: 1px solid #f1f5f9;
        transition: all 0.4s ease;
        text-align: center;
        height: 100%;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .dashboard-card-custom:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

    .dashboard-icon-wrapper {
        width: 70px;
        height: 70px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 20px;
        color: white;
        transition: transform 0.4s ease;
    }

    /* Hiệu ứng xoay icon 15 độ khi hover card dashboard */
    .dashboard-card-custom:hover .dashboard-icon-wrapper {
        transform: rotate(15deg) scale(1.1);
    }

    .bg-pst-red {
        background: var(--p-red) !important;
        color: #742a2a !important;
    }

    .bg-pst-blue {
        background: var(--p-blue) !important;
        color: #2c5282 !important;
    }

    .bg-pst-purple {
        background: var(--p-purple) !important;
        color: #44337a !important;
    }

    .dashboard-card-custom .card-title {
        font-size: 1.8rem;
        font-weight: 800;
        margin-bottom: 5px;
        color: var(--text-dark);
    }

    .dashboard-card-custom .card-label {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.8rem;
        color: #64748b;
        letter-spacing: 0.5px;
    }
    /* === KẾT THÚC PHẦN CHỈNH SỬA THẺ TỔNG QUAN === */

    /* GIỮ NGUYÊN CÁC STYLE CÒN LẠI */
    .my-room-page {
        font-family: "Montserrat", sans-serif !important;
    }

    .room-wrapper {
        border-radius: 1.5rem !important;
        border: 1.5px solid var(--surface-alt);
    }

    .room-info-row {
        margin-bottom: 8px;
        font-size: 16px;
        color: var(--text-dark);
    }

        .room-info-row strong {
            color: var(--muted);
            min-width: 90px;
            display: inline-block;
        }

    .room-details-card {
        background-color: var(--surface-alt) !important;
        border: 1px solid var(--primary);
    }

    .btn-action-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 16px;
        margin-top: 10px;
    }

        .btn-action-grid .btn {
            border-radius: 12px;
            font-weight: 600;
            padding: 15px 18px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            color: #444 !important;
        }

    .btn-pst-1 {
        background-color: #D4F1F4 !important;
        border: 2px solid transparent;
    }

    .btn-pst-2 {
        background-color: #FFDEE9 !important;
        border: 2px solid transparent;
    }

    .btn-pst-3 {
        background-color: #FFF9C4 !important;
        border: 2px solid transparent;
    }

    .btn-pst-4 {
        background-color: #E2F0CB !important;
        border: 2px solid transparent;
    }

    .btn-pst-5 {
        background-color: #E1BEE7 !important;
        border: 2px solid transparent;
    }

    .btn-pst-6 {
        background-color: #FFE0B2 !important;
        border: 2px solid transparent;
    }

    .btn-pst-7 {
        background-color: #B2DFDB !important;
        border: 2px solid transparent;
    }

    .btn-pst-8 {
        background-color: #D1D9E6 !important;
        border: 2px solid transparent;
    }

    .action-btn:hover {
        background-color: #ffffff !important;
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.1) !important;
    }

    #floatingChatBtn {
        position: fixed;
        bottom: 25px;
        right: 25px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: #94c8db;
        color: #2d3748;
        border: 2px solid #a8d5e2;
        box-shadow: 0 4px 12px rgba(168,213,226,0.6);
        z-index: 2147483000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .chat-card, .chat-popup {
        position: fixed;
        right: 25px;
        z-index: 2147483000;
        border-radius: 1rem !important;
        box-shadow: 0 6px 25px rgba(0,0,0,0.1);
    }

    .chat-popup {
        bottom: 100px;
        width: 320px;
        background: white;
        border: 1px solid #a8d5e2;
        display: none;
    }

        .chat-popup.show {
            display: block;
        }

    .chat-card {
        bottom: 100px;
        width: 330px;
    }

    .dashboard-card {
        border-radius: 1rem !important;
    }
</style>

<section class="my-room-page section pt-1">
    <div class="container-fluid px-xl-5 py-2">
        <div class="room-wrapper bg-white rounded-5 shadow-sm p-4 mx-auto" style="max-width: 1250px;">

            <div class="text-center mb-2">
                <h2 class="fw-bold text-primary-color mb-1">Phòng trọ của tôi</h2>
                <p class="text-muted small">Thông tin phòng bạn đang thuê và các chức năng liên quan</p>
            </div>

            @if (Model == null)
            {
                <div class="alert alert-info text-center fs-5 py-4 rounded-4 shadow-sm">
                    <i class="bi bi-house-door me-2"></i> Bạn chưa thuê phòng trọ nào.
                </div>
            }
            else
            {
                <div class="row gx-4 gy-4 align-items-stretch mb-4">
                    <div class="col-12 col-md-7">
                        <div class="img-card overflow-hidden rounded-4 shadow-sm h-100">
                            <img src="@Url.Content("~/" + (string.IsNullOrEmpty(Model.Hinhanh) ? "img/default-product.jpg" : Model.Hinhanh))"
                                 class="img-fluid w-100 h-100" style="max-height: 450px; object-fit: cover;" />
                        </div>
                    </div>

                    <div class="col-12 col-md-5">
                        <div class="room-details-card p-4 rounded-4 shadow-sm room-info-card h-100 d-flex flex-column justify-content-center">
                            <h4 class="fw-bold text-primary-color mb-3">Phòng @Model.SoPhong</h4>
                            <div class="room-info-row"><strong>Giá thuê:</strong> <span class="text-danger fw-bold">@Model.GiaThue.ToString("#,##0 VNĐ")</span></div>
                            <div class="room-info-row"><strong>Diện tích:</strong> <span>@Model.DienTich m²</span></div>
                            <div class="room-info-row"><strong>Tầng:</strong> <span>@Model.Tang</span></div>
                            <hr class="my-3" />
                            <div class="room-info-row"><strong>Tòa nhà:</strong> <span>@Model.ToaNha?.TenToaNha</span></div>
                            <div class="room-info-row"><strong>Địa chỉ:</strong> <span>@Model.ToaNha?.DiaChi</span></div>
                        </div>
                    </div>
                </div>

                <div class="mt-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-tools me-2"></i>Chức năng</h5>
                        <input type="text" id="searchAction" class="form-control form-control-sm" placeholder="🔍 Tìm chức năng..." style="border-radius: 50px; width: 250px;">
                    </div>

                    <div id="actionGrid" class="btn-action-grid">
                        <a href="@Url.Action("DangKy", "DichVu")" class="btn action-btn btn-pst-1"><i class="fas fa-clipboard-list me-2"></i> Đăng ký dịch vụ</a>
                        <a asp-controller="DichVu" asp-action="DanhSachDangKy" class="btn action-btn btn-pst-2"><i class="fas fa-file-alt me-2"></i> Xem phiếu đăng ký</a>
                        <a asp-controller="HopDong" asp-action="Details" asp-route-id="@ViewBag.MaHopDong" class="btn action-btn btn-pst-3"><i class="fas fa-file-signature me-2"></i> Hợp đồng</a>
                        <a asp-controller="ChiSoDienNuoc" asp-action="Index" class="btn action-btn btn-pst-4"><i class="fas fa-tachometer-alt me-2"></i> Chỉ số điện nước</a>
                        <a asp-controller="PhieuThanhToan" asp-action="Index" class="btn action-btn btn-pst-5"><i class="fas fa-file-invoice-dollar me-2"></i> Hóa đơn</a>
                        <a asp-controller="PhieuHienTrang" asp-action="XemPhieu" class="btn action-btn btn-pst-6"><i class="fas fa-clipboard-check me-2"></i> Xác nhận hiện trạng</a>
                        <a asp-controller="Phongtrocuatoi" asp-action="IndexChat" class="btn action-btn btn-pst-7"><i class="fas fa-comments me-2"></i> Chat với chủ trọ</a>
                        <a asp-controller="SuCo" asp-action="Index" class="btn action-btn btn-pst-8"><i class="fas fa-exclamation-triangle me-2"></i> Báo sự cố</a>
                    </div>
                </div>

                <div class="dashboard-section mt-5">
                    <h3 class="text-center fw-bold mb-5 text-primary-color">Tổng quan</h3>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="dashboard-card-custom shadow-sm">
                                <div class="dashboard-icon-wrapper bg-pst-red">
                                    <i class="fas fa-receipt"></i>
                                </div>
                                <div class="card-label">Hóa đơn chưa đóng</div>
                                <div class="card-title">@ViewBag.HoaDonChuaThanhToan</div>
                                <p class="small text-muted mb-0">Cần được thanh toán ngay</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="dashboard-card-custom shadow-sm">
                                <div class="dashboard-icon-wrapper bg-pst-blue">
                                    <i class="fas fa-concierge-bell"></i>
                                </div>
                                <div class="card-label">Dịch vụ đang dùng</div>
                                <div class="card-title">@ViewBag.DichVuDaSuDung</div>
                                <p class="small text-muted mb-0">Đăng ký trong tháng này</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="dashboard-card-custom shadow-sm">
                                <div class="dashboard-icon-wrapper bg-pst-purple">
                                    <i class="fas fa-door-open"></i>
                                </div>
                                <div class="card-label">Thông tin phòng</div>
                                <div class="card-title">Phòng @Model.SoPhong</div>
                                <p class="small text-muted mb-0">@Model.GiaThue.ToString("#,##0") đ/tháng</p>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="card dashboard-card shadow-sm border-0">
                                <div class="card-header bg-white fw-bold">Mức tiêu thụ điện/nước</div>
                                <div class="card-body">
                                    <canvas id="consumptionChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<div id="chatContainer">
    <button id="floatingChatBtn"><i class="fas fa-comments"></i><span id="chatBadge" class="chat-badge d-none">0</span></button>
</div>
<div id="chatPopup" class="chat-popup">
    <div class="toast-body position-relative">
        <button type="button" class="btn-close position-absolute top-0 end-0 m-2" id="closePopup"></button>
        <span class="fw-bold text-dark"><i class="fas fa-envelope-open-text me-2"></i><strong>Tin nhắn mới</strong></span>
        <p id="popupMsg" class="mb-3 text-secondary small"></p>
        <button id="viewChatBtn" class="btn btn-sm btn-pst-1 w-100"><i class="fas fa-comments me-1"></i> Mở trang chat</button>
    </div>
</div>
<div class="card chat-card d-none" id="chatCard">
    <div class="card-header bg-primary text-dark d-flex justify-content-between align-items-center">
        <span id="chatWith">Chủ trọ: @(Model?.ToaNha?.ChuTro?.HoTen ?? "N/A")</span>
        <button type="button" class="btn-close" id="closeChat"></button>
    </div>
    <div class="card-body" id="chatMessages" style="overflow-y: auto; height: 280px;"></div>
    <div class="card-footer">
        <form id="chatForm" class="d-flex gap-2">
            <input type="text" id="messageInput" class="form-control" placeholder="Nhập tin nhắn..." autocomplete="off" />
            <button type="submit" class="btn btn-pst-7">Gửi</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // JS TOÀN BỘ GIỮ NGUYÊN TỪ FILE CŨ CỦA BẠN
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("searchAction");
            const buttons = document.querySelectorAll("#actionGrid .action-btn");
            searchInput.addEventListener("input", () => {
                const keyword = searchInput.value.toLowerCase().trim();
                buttons.forEach(btn => btn.style.display = btn.innerText.toLowerCase().includes(keyword) ? "flex" : "none");
            });
        });

        document.addEventListener('DOMContentLoaded', async () => {
            const chatCard = document.getElementById('chatCard');
            if (!chatCard) return;
            const chatMessages = document.getElementById('chatMessages');
            const messageInput = document.getElementById('messageInput');
            const chatPopup = document.getElementById('chatPopup');
            const floatingChatBtn = document.getElementById('floatingChatBtn');
            const closePopup = document.getElementById('closePopup');
            const closeChat = document.getElementById('closeChat');
            const landlordId = '@(Model?.ToaNha?.ChuTro?.ApplicationUserId ?? "")';
            const landlordName = '@(Model?.ToaNha?.ChuTro?.HoTen ?? "Chủ trọ")';
            const connection = new signalR.HubConnectionBuilder().withUrl("/chathub").withAutomaticReconnect().build();
            try { await connection.start(); } catch (err) { console.error(err); }

            function appendMessage(message, isSender) {
                const div = document.createElement('div');
                div.className = isSender ? 'message-row right text-end mb-2' : 'message-row mb-2';
                div.innerHTML = `<div class="p-2 rounded-3 d-inline-block ${isSender ? 'bg-info text-dark' : 'bg-light'}">${message}</div>`;
                chatMessages.appendChild(div);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            connection.on("ReceiveMessage", (senderId, message) => {
                if (senderId !== landlordId) return;
                if (chatCard.classList.contains('d-none')) {
                    document.getElementById('popupMsg').innerHTML = `<strong>${landlordName}:</strong> ${message}`;
                    chatPopup.classList.add('show');
                }
                appendMessage(message, false);
            });

            document.getElementById('chatForm').addEventListener('submit', e => {
                e.preventDefault();
                const msg = messageInput.value.trim();
                if (!msg) return;
                connection.invoke("SendPrivateMessage", landlordId, msg);
                appendMessage(msg, true);
                messageInput.value = '';
            });

            floatingChatBtn.addEventListener('click', () => { chatCard.classList.remove('d-none'); chatPopup.classList.remove('show'); });
            closeChat.addEventListener('click', () => chatCard.classList.add('d-none'));
            closePopup.addEventListener('click', () => chatPopup.classList.remove('show'));
        });

        const ctx = document.getElementById('consumptionChart').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.ThangTieuThu)),
                datasets: [
                    { label: 'Điện (kWh)', data: @Html.Raw(Json.Serialize(ViewBag.DienTieuThu)), backgroundColor: '#B2E2F2', borderRadius: 8 },
                    { label: 'Nước (m³)', data: @Html.Raw(Json.Serialize(ViewBag.NuocTieuThu)), backgroundColor: '#F2C6DE', borderRadius: 8 }
                ]
            },
            options: { responsive: true, plugins: { legend: { position: 'top' } }, scales: { y: { beginAtZero: true } } }
        });
    </script>
}