@model DACS_QuanLyPhongTro.Models.PhongTro
@{
    ViewData["Title"] = Model?.SoPhong ?? "Chi tiết phòng trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (Model == null)
{
    <h2 class="text-danger text-center mt-5">Phòng trọ không tồn tại!</h2>
    return;
}

<section class="room-detail-section">
    <div class="container room-detail-wrapper" style="max-width: 1200px;">
        <div class="row g-4 align-items-stretch">

            <div class="col-lg-7 col-md-6 col-12">
                <div class="room-image-wrapper h-100">
                    <img src="@(!string.IsNullOrEmpty(Model.Hinhanh) ? Url.Content("~/" + Model.Hinhanh) : Url.Content("~/img/default-product.jpg"))"
                         alt="Hình ảnh phòng @Model.SoPhong"
                         class="room-main-img" />
                </div>
            </div>

            <div class="col-lg-5 col-md-6 col-12">
                <div class="room-info-card shadow-sm p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h2 class="text-primary-color fw-bold m-0">Phòng @Model.SoPhong</h2>
                        <span class="badge badge-status-primary px-3 py-2">@Model.TrangThai</span>
                    </div>

                    <div class="price-tag mb-4">
                        <span class="text-danger fw-bold fs-3">@Model.GiaThue.ToString("#,##0 VNĐ")</span>
                        <small class="text-muted">/ tháng</small>
                    </div>

                    <div class="row g-3 mb-4 room-quick-specs">
                        <div class="col-6">
                            <div class="spec-item p-2 rounded-3 bg-white border">
                                <small class="text-muted d-block">Diện tích</small>
                                <strong>@Model.DienTich m²</strong>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="spec-item p-2 rounded-3 bg-white border">
                                <small class="text-muted d-block">Vị trí tầng</small>
                                <strong>Tầng @Model.Tang</strong>
                            </div>
                        </div>
                    </div>

                    <div class="description-box mb-4 flex-grow-1">
                        <label class="fw-bold text-dark mb-1"><i class="fas fa-info-circle me-2"></i>Mô tả</label>
                        <p class="text-muted small mb-0">@Model.MoTa</p>
                    </div>

                    <hr class="my-3 opacity-25" />

                    <ul class="list-unstyled room-info-list mb-4">
                        <li class="mb-2"><i class="fas fa-building text-muted me-2"></i><strong>Tòa nhà:</strong> @Model.ToaNha?.TenToaNha</li>
                        <li class="mb-2"><i class="fas fa-map-marker-alt text-muted me-2"></i><strong>Địa chỉ:</strong> @Model.ToaNha?.DiaChi</li>

                        @* GIỮ NGUYÊN LOGIC VỊ TRÍ TRÊN BẢN ĐỒ *@
                        @if (!string.IsNullOrEmpty(Model.ToaNha?.ViTri))
                        {
                            <li class="mt-2">
                                <a href="https://www.google.com/maps/search/?api=1&query=@Model.ToaNha.ViTri"
                                   target="_blank" class="btn btn-outline-primary-color btn-sm rounded-pill px-3">
                                    <i class="fas fa-location-arrow me-1"></i> Xem vị trí trên bản đồ
                                </a>
                            </li>
                        }

                        @if (Model.ToaNha?.ChuTro != null)
                        {
                            <li class="mt-3 p-3 rounded-4 bg-white border border-info-subtle">
                                <div class="small text-muted mb-1 text-uppercase fw-semibold">Liên hệ chủ trọ</div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <strong>@Model.ToaNha.ChuTro.HoTen</strong>
                                    <span class="text-primary-color"><i class="fas fa-phone-alt me-1"></i> @Model.ToaNha.ChuTro.SoDienThoai</span>
                                </div>
                            </li>
                        }
                    </ul>

                    <div class="d-flex gap-2 mt-auto">
                        <a asp-controller="PhongTro" asp-action="Index"
                           class="btn btn-outline-muted rounded-pill px-3 py-2">
                            <i class="fas fa-arrow-left"></i>
                        </a>

                        <button type="button"
                                id="btnDatLichHen"
                                class="btn btn-primary-filled rounded-pill px-3 py-2 flex-grow-1 fw-bold"
                                data-bs-toggle="modal" data-bs-target="#appointmentModal"
                                @(Model.TrangThai == "Đã Thuê" ? "disabled title='Phòng đã được thuê, không thể đặt lịch.'" : "")>
                            <i class="fas fa-calendar-alt me-2"></i> Đặt lịch hẹn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="appointmentModal" tabindex="-1" aria-labelledby="appointmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header bg-primary-dark text-white rounded-top-4">
                <h5 class="modal-title fw-semibold text-dark"><i class="fas fa-calendar-check me-2"></i>Đặt lịch xem phòng @Model.SoPhong</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="appointmentForm" novalidate>
                    <div class="mb-3">
                        <label for="appointmentDate" class="form-label fw-semibold">Ngày hẹn</label>
                        <input type="date" class="form-control" id="appointmentDate" required>
                    </div>
                    <div class="mb-3">
                        <label for="appointmentTime" class="form-label fw-semibold">Giờ hẹn</label>
                        <input type="time" class="form-control" id="appointmentTime" required>
                    </div>
                    <div class="mb-3">
                        <label for="note" class="form-label fw-semibold">Ghi chú</label>
                        <textarea class="form-control" id="note" rows="3" placeholder="Thêm ghi chú (tùy chọn)..."></textarea>
                    </div>
                    <input type="hidden" id="phongTroId" value="@Model.MaPhong" />
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-muted rounded-pill" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-filled rounded-pill px-4" onclick="submitAppointment()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --text-dark: #2d3748;
        --muted: #64748b;
        --lofi-shadow: rgba(168, 213, 226, 0.4);
    }


    .room-detail-section {
        padding-top: 30px; /* Thu nhỏ khoảng cách trên sát menu */
        margin-bottom: 0px;
    }

    .room-image-wrapper {
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        display: flex;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

        /* Hiệu ứng Hover nâng ảnh và đổ bóng xanh nhạt */
        .room-image-wrapper:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px var(--lofi-shadow);
        }

    .room-main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        flex: 1;
    }

    .room-info-card {
        background: #fafafa;
        border-radius: 20px;
        border: 1px solid var(--primary);
    }

    .text-primary-color {
        color: var(--primary-dark) !important;
    }

    .badge-status-primary {
        background-color: var(--primary) !important;
        color: var(--text-dark) !important;
        border-radius: 12px;
    }

    .btn-primary-filled {
        background-color: var(--primary);
        color: var(--text-dark);
        border: none;
        transition: all 0.3s;
    }

        .btn-primary-filled:hover:not(:disabled) {
            background-color: var(--primary-dark);
            transform: scale(1.02);
        }

    .btn-outline-primary-color {
        border: 1px solid var(--primary);
        color: var(--primary-dark);
    }

        .btn-outline-primary-color:hover {
            background: var(--primary);
            color: var(--text-dark);
        }

    .room-info-list li {
        font-size: 0.95rem;
    }

    .bg-primary-dark {
        background-color: var(--primary-dark) !important;
    }

    /* Fix ảnh trên mobile để vẫn giữ cân đối */
    @@media (max-width: 991px) {
        .room-image-wrapper {
            min-height: 350px;
            margin-bottom: 20px;
        }
    }
</style>

@section Scripts {
    <script>
        // GIỮ NGUYÊN TOÀN BỘ LOGIC BOOKING GỐC
        function submitAppointment() {
            var date = document.getElementById("appointmentDate").value;
            var time = document.getElementById("appointmentTime").value;
            var note = document.getElementById("note").value;
            var phongTroId = document.getElementById("phongTroId").value;

            if (!date || !time) {
                alert("Vui lòng chọn ngày và giờ hẹn!");
                return;
            }

            fetch('/PhongTro/BookAppointment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    MaPhong: phongTroId,
                    NgayHen: date,
                    GioHen: time,
                    GhiChu: note
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Đặt lịch hẹn thành công! Bạn sẽ được thông báo khi chủ nhà xác nhận.");
                    $('#appointmentModal').modal('hide');
                } else {
                    alert("Lỗi: " + data.message);
                }
            })
            .catch(error => {
                console.error('Lỗi khi đặt lịch:', error);
                alert("Có lỗi xảy ra khi gửi yêu cầu đặt lịch hẹn.");
            });
        }
    </script>
}