@model IEnumerable<DACS_QuanLyPhongTro.Models.PhongTro>

@{
    ViewData["Title"] = "Danh sách phòng trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ======= Danh sách phòng trọ ======= -->
<section class="room-list section">
    <div class="container-fluid px-xl-5">

        <!-- ==== THANH BỘ LỌC NGANG ==== -->
        <div class="filter-toolbar bg-white shadow-sm rounded-3 p-3 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <!-- Nút Tìm trọ gần tôi -->
            <a href="@Url.Action("TimPhongGanToi", "PhongTro")"
               class="btn btn-highlighted d-flex align-items-center justify-content-center">
                <i class="fas fa-map-marker-alt me-2"></i> Tìm trọ gần tôi
            </a>

            <!-- Lọc theo giá -->
            <div class="filter-group d-flex align-items-center gap-2">
                <label class="fw-semibold text-dark">Giá:</label>
                <select id="priceSelect" class="form-select filter-select">
                    <option value="">Tất cả</option>
                    @foreach (var range in ViewBag.PriceRanges)
                    {
                        var rangeText = range.Range.Max != null
                            ? $"{range.Range.Min:N0} - {range.Range.Max:N0} VNĐ"
                            : $"Trên {range.Range.Min:N0} VNĐ";
                        <option value="@range.Range.Min-@range.Range.Max">@rangeText</option>
                    }
                </select>
            </div>

            <!-- Lọc theo diện tích -->
            <div class="filter-group d-flex align-items-center gap-2">
                <label class="fw-semibold text-dark">Diện tích:</label>
                <select id="areaSelect" class="form-select filter-select">
                    <option value="">Tất cả</option>
                    @foreach (var range in ViewBag.AreaRanges)
                    {
                        var rangeText = range.Range.Max != null
                            ? $"{range.Range.Min:N0} - {range.Range.Max:N0} m²"
                            : $"Trên {range.Range.Min:N0} m²";
                        <option value="@range.Range.Min-@range.Range.Max">@rangeText</option>
                    }
                </select>
            </div>
        </div>

        <!-- ==== DANH SÁCH PHÒNG ==== -->
        <div class="row g-4 justify-content-center product-row">
            @foreach (var product in Model)
            {
                <div class="col-lg-4 col-md-6 col-sm-6">
                    <div class="product-card">
                        <div class="product-img">
                            <img src="@(string.IsNullOrEmpty(product.Hinhanh) ? Url.Content("~/img/default-product.jpg") : Url.Content("~/" + product.Hinhanh))"
                                 alt="@product.SoPhong" />
                            <div class="product-action">
                                <a class="btn-action" href="javascript:void(0)" data-toggle="modal" data-target="#appointmentModal">
                                    <i class="fa fa-calendar"></i>
                                </a>
                                <a class="btn-action" href="@Url.Action("Details", "PhongTro", new { id = product.MaPhong })">
                                    <i class="fa fa-search"></i>
                                </a>
                            </div>
                        </div>

                        <div class="product-body text-center">
                            <a href="@Url.Action("Details", "PhongTro", new { id = product.MaPhong })"
                               class="room-title">Phòng @product.SoPhong</a>
                            <div class="price-status">
                                <h5>@product.GiaThue.ToString("#,##0 VNĐ")</h5>
                                <span class="badge badge-status mt-2">@product.TrangThai</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- ======= STYLE ======= -->
<style>
/* === ĐẨY XUỐNG DƯỚI HEADER === */
.room-list {
    margin-top: 10px;
    margin-bottom: 10px;
}

/* === Container giới hạn chiều rộng === */
.container-fluid {
    max-width: 1300px;
    margin: 0 auto;
}

/* === Thanh lọc ngang === */
.filter-toolbar {
    border: 1px solid #eee;
}

.filter-select {
    min-width: 200px;
    border-radius: 8px;
    border: 1px solid #ccc;
    padding: 6px 10px;
    transition: border 0.2s;
}

.filter-select:focus {
    border-color: #1ec36e;
    box-shadow: 0 0 0 0.2rem rgba(30, 195, 110, 0.2);
}

/* === Nút tìm trọ gần tôi === */
.btn-highlighted {
    background-color: #23cf3a;
    color: #fff;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 25px;
    box-shadow: 0 3px 8px rgba(255, 111, 0, 0.4);
    transition: all 0.3s;
}

.btn-highlighted:hover {
    background-color: #e65100;
    box-shadow: 0 5px 15px rgba(230, 81, 0, 0.6);
    color: #fff;
}

/* === CARD PHÒNG TRỌ === */
.product-row {
    margin-top: 5px;
}

/* --- Card bố cục giống trang chủ --- */
.product-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    height: 100%;
}

.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
}

/* --- Ảnh sản phẩm --- */
.product-img {
    position: relative;
    width: 100%;
    height: 230px;
    overflow: hidden;
}

.product-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.product-card:hover img {
    transform: scale(1.08);
}

/* --- Overlay --- */
.product-action {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(255, 255, 255, 0.8);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.product-card:hover .product-action {
    opacity: 1;
}

.btn-action {
    background: #fff;
    border: 1px solid #ddd;
    color: #333;
    width: 40px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 6px;
    font-size: 17px;
    border-radius: 6px;
    transition: all 0.3s ease;
}

.btn-action:hover {
    background: #1ec36e;
    color: #fff;
    border-color: #1ec36e;
}

/* --- Nội dung trong card --- */
.product-body {
    padding: 1.1rem;
    text-align: center;
}

.room-title {
    font-weight: 600;
    color: #0d2a4d;
    font-size: 1.05rem;
    margin-bottom: 6px;
    display: block;
    text-decoration: none;
    transition: color 0.25s;
}

.room-title:hover {
    color: #1ec36e;
}

.price-status h5 {
    color: #e67e22;
    font-weight: 700;
    margin-bottom: 5px;
    font-size: 1rem;
}

.badge-status {
    background-color: #17a2b8;
    color: #fff;
    border-radius: 30px;
    padding: 0.35em 0.75em;
    font-size: 0.85rem;
}

/* === RESPONSIVE === */
@@media (max-width: 1200px) {
    .product-img {
        height: 210px;
    }
}

@@media (max-width: 992px) {
    .col-lg-4 {
        flex: 0 0 50%;
        max-width: 50%;
    }
    .product-img {
        height: 200px;
    }
}

@@media (max-width: 768px) {
    .col-md-6 {
        flex: 0 0 100%;
        max-width: 100%;
    }
    .product-img {
        height: 180px;
    }
}

</style>

<!-- ======= SCRIPT LỌC GIỮ NGUYÊN LOGIC ======= -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Khi thay đổi giá hoặc diện tích
        $('#priceSelect, #areaSelect').change(function () {
            const url = new URL(window.location.href);
            url.searchParams.delete('minPrice');
            url.searchParams.delete('maxPrice');
            url.searchParams.delete('minArea');
            url.searchParams.delete('maxArea');

            const priceVal = $('#priceSelect').val();
            const areaVal = $('#areaSelect').val();

            if (priceVal) {
                const [minP, maxP] = priceVal.split('-');
                url.searchParams.set('minPrice', minP);
                if (maxP !== 'null') url.searchParams.set('maxPrice', maxP);
            }

            if (areaVal) {
                const [minA, maxA] = areaVal.split('-');
                url.searchParams.set('minArea', minA);
                if (maxA !== 'null') url.searchParams.set('maxArea', maxA);
            }

            window.location.href = url.toString();
        });

        // Đặt lại trạng thái selected khi reload
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('minPrice')) {
            const min = urlParams.get('minPrice');
            const max = urlParams.get('maxPrice') || 'null';
            $(`#priceSelect option[value="${min}-${max}"]`).prop('selected', true);
        }
        if (urlParams.has('minArea')) {
            const min = urlParams.get('minArea');
            const max = urlParams.get('maxArea') || 'null';
            $(`#areaSelect option[value="${min}-${max}"]`).prop('selected', true);
        }
    });
</script>
