@model IEnumerable<DACS_QuanLyPhongTro.Models.PhongTro>

@{
    ViewData["Title"] = "Danh sách phòng trọ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<section class="room-list section">
    <div class="container-fluid px-xl-5">

        <div class="filter-toolbar bg-white shadow-sm rounded-3 p-3 mb-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <a href="@Url.Action("TimPhongGanToi", "PhongTro")"
               class="btn btn-highlighted d-flex align-items-center justify-content-center">
                <i class="fas fa-map-marker-alt me-2"></i> Tìm trọ gần tôi
            </a>

            <div class="filter-group d-flex align-items-center gap-2">
                <label class="fw-semibold text-dark label-filter">Giá:</label>
                <select id="priceSelect" class="form-select filter-select">
                    <option value="">Tất cả</option>
                    @foreach (var range in ViewBag.PriceRanges)
                    {
                        var rangeText = range.Range.Max != null
                        ? $"{range.Range.Min:N0} - {range.Range.Max:N0} VNĐ"
                        : $"Trên {range.Range.Min:N0} VNĐ";
                        <option value="@range.Range.Min-@range.Range.Max">@rangeText</option>
                    }
                </select>
            </div>

            <div class="filter-group d-flex align-items-center gap-2">
                <label class="fw-semibold text-dark label-filter">Diện tích:</label>
                <select id="areaSelect" class="form-select filter-select">
                    <option value="">Tất cả</option>
                    @foreach (var range in ViewBag.AreaRanges)
                    {
                        var rangeText = range.Range.Max != null
                        ? $"{range.Range.Min:N0} - {range.Range.Max:N0} m²"
                        : $"Trên {range.Range.Min:N0} m²";
                        <option value="@range.Range.Min-@range.Range.Max">@rangeText</option>
                    }
                </select>
            </div>
        </div>

        <div class="row g-4 justify-content-center product-row">
            @foreach (var product in Model)
            {
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="product-card">
                        <div class="product-img">
                            <img src="@(string.IsNullOrEmpty(product.Hinhanh) ? Url.Content("~/img/default-product.jpg") : Url.Content("~/" + product.Hinhanh))"
                                 alt="@product.SoPhong" />
                            <div class="product-action">
                                <a class="btn-action" href="javascript:void(0)" data-toggle="modal" data-target="#appointmentModal">
                                    <i class="fa fa-calendar"></i>
                                </a>
                                <a class="btn-action" href="@Url.Action("Details", "PhongTro", new { id = product.MaPhong })">
                                    <i class="fa fa-search"></i>
                                </a>
                            </div>
                        </div>

                        <div class="product-body text-center d-flex flex-column justify-content-between">
                            <div>
                                <a href="@Url.Action("Details", "PhongTro", new { id = product.MaPhong })"
                                   class="room-title fw-bold">Phòng @product.SoPhong</a>
                            </div>
                            <div class="price-status mt-auto">
                                <h5 class="fw-bold">@product.GiaThue.ToString("#,##0 VNĐ")</h5>
                                <span class="badge badge-status mt-2 fw-semibold">@product.TrangThai</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    /* Áp dụng font chữ mới cho toàn bộ trang để không lỗi dấu tiếng Việt */
    body, section.room-list {
        font-family: 'Montserrat', sans-serif !important;
    }

    :root {
        --primary: #a8d5e2;
        --primary-dark: #94c8db;
        --accent: #c7ceea;
        --text-dark: #2d3748;
    }

    /* Định nghĩa độ đậm nhạt chuẩn theo Font Montserrat */
    .fw-bold {
        font-weight: 700 !important;
    }

    .fw-semibold {
        font-weight: 600 !important;
    }

    .room-list {
        margin-top: 0px;
        margin-bottom: 0px;
    }

    .container-fluid {
        max-width: 1300px;
        margin: 0 auto;
    }

    .filter-toolbar {
        border: 1px solid var(--primary);
    }

    .filter-select {
        font-family: 'Montserrat', sans-serif;
        min-width: 200px;
        border-radius: 8px;
    }

    .btn-highlighted {
        background-color: var(--primary);
        color: var(--text-dark);
        font-weight: 700;
        padding: 10px 18px;
        border-radius: 25px;
        box-shadow: 0 3px 8px rgba(168, 213, 226, 0.4);
        transition: all 0.3s ease;
    }

    .product-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(168, 213, 226, 0.4);
        }

    .product-img {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
    }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

    .product-action {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(255, 255, 255, 0.7);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-card:hover .product-action {
        opacity: 1;
    }

    .btn-action {
        background: #fff;
        border: 1px solid #ddd;
        color: var(--text-dark);
        width: 45px;
        height: 45px;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 8px;
        border-radius: 50%;
        transition: all 0.3s ease;
    }

        .btn-action:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

    .product-body {
        padding: 1.25rem;
        flex-grow: 1;
    }

    .room-title {
        color: var(--text-dark);
        font-size: 1.2rem;
        text-decoration: none;
        display: block;
        margin-bottom: 5px;
        transition: color 0.3s;
    }

        .room-title:hover {
            color: var(--primary-dark);
        }

    .price-status h5 {
        color: var(--primary-dark);
        font-size: 1.15rem;
        margin-top: 10px;
    }

    .badge-status {
        background-color: var(--primary);
        color: var(--text-dark);
        border-radius: 20px;
        padding: 6px 15px;
        font-size: 0.85rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        $('#priceSelect, #areaSelect').change(function () {
            const url = new URL(window.location.href);
            url.searchParams.delete('minPrice');
            url.searchParams.delete('maxPrice');
            url.searchParams.delete('minArea');
            url.searchParams.delete('maxArea');

            const priceVal = $('#priceSelect').val();
            const areaVal = $('#areaSelect').val();

            if (priceVal) {
                const [minP, maxP] = priceVal.split('-');
                url.searchParams.set('minPrice', minP);
                if (maxP !== 'null') url.searchParams.set('maxPrice', maxP);
            }

            if (areaVal) {
                const [minA, maxA] = areaVal.split('-');
                url.searchParams.set('minArea', minA);
                if (maxA !== 'null') url.searchParams.set('maxArea', maxA);
            }

            window.location.href = url.toString();
        });

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('minPrice')) {
            const min = urlParams.get('minPrice');
            const max = urlParams.get('maxPrice') || 'null';
            $(`#priceSelect option[value="${min}-${max}"]`).prop('selected', true);
        }
        if (urlParams.has('minArea')) {
            const min = urlParams.get('minArea');
            const max = urlParams.get('maxArea') || 'null';
            $(`#areaSelect option[value="${min}-${max}"]`).prop('selected', true);
        }
    });
</script>