@model List<DACS_QuanLyPhongTro.Models.ChiSoDienNuoc>
@{
    ViewData["Title"] = "Danh Sách Chỉ Số Điện Nước";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalRecords = Model?.Count() ?? 0;
    var thisMonthRecords = Model?.Count(c => c.NgayGhi.Month == DateTime.Now.Month && c.NgayGhi.Year == DateTime.Now.Year) ?? 0;
    var totalElectricity = Model?.Sum(c => c.SoDienTieuThu) ?? 0;
    var totalWater = Model?.Sum(c => c.SoNuocTieuThu) ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    /* 3. 4 CARDS THỐNG KÊ - XOAY ICON 15 ĐỘ */
    .custom-box-tenant {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .custom-box-tenant:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

        .custom-box-tenant .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-box-tenant:hover .icon-wrapper {
            transform: rotate(15deg) scale(1.1);
        }

    /* 4. CHỈ SỐ CARDS - DÃN RỘNG NỘI DUNG */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-blue) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important;
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .card-title-lg {
        font-weight: 850 !important;
        font-size: 1.5rem !important;
        color: #1a202c;
        margin-bottom: 12px;
    }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.4rem;
        transition: 0.4s;
    }

    .building-card:hover .minimal-icon-box {
        transform: rotate(15deg);
    }

    /* Phân loại màu viền pastel */
    .csdn-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .csdn-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-yellow) !important;
    }

    .csdn-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .csdn-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-red) !important;
    }

    .info-group-box {
        background: #f8fafc;
        border-radius: 15px;
        padding: 15px;
        margin-bottom: 15px;
        border: 1px solid #edf2f7;
    }

    .btn-action-circle {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.3s;
    }
</style>

<div class="container-fluid">
    @if (TempData["Error"] != null)
    {
        <div class="modal fade" id="errorModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 25px;">
                    <div class="modal-header bg-danger text-white border-0 pt-4 px-4" style="border-radius: 25px 25px 0 0;">
                        <h5 class="modal-title fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Lỗi Hệ Thống</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4 fw-bold text-center">@TempData["Error"]</div>
                </div>
            </div>
        </div>
        <script>document.addEventListener('DOMContentLoaded', () => new bootstrap.Modal(document.getElementById('errorModal')).show());</script>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4 text-left">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Chỉ số Điện & Nước </h2>
                        </div>
                        <div class="col-md-3 text-right">
                            <button class="btn btn-dark shadow px-4" style="border-radius:12px; height: 50px; font-weight: 700;" onclick="showPasswordModal('create')">
                                + GHI CHỈ SỐ MỚI
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-list"></i></div>
                <h3>@totalRecords</h3>
                <p>Tổng bản ghi</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-purple)"><i class="fas fa-calendar-alt"></i></div>
                <h3>@thisMonthRecords</h3>
                <p>Trong tháng</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-yellow); color:#856404"><i class="fas fa-bolt"></i></div>
                <h3>@totalElectricity</h3>
                <p>Tổng điện (kWh)</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-tint"></i></div>
                <h3>@totalWater</h3>
                <p>Tổng nước (m³)</p>
            </div>
        </div>
    </div>

    <div class="row mt-4" id="csdnGrid">
        @foreach (var chiSo in Model)
        {
            <div class="col-12 col-md-6 col-xl-4 csdn-item mb-5" data-room="@chiSo.PhongTro?.SoPhong" data-date="@chiSo.NgayGhi.ToString("yyyy-MM-dd")">
                <div class="card building-card shadow-sm h-100">
                    <div class="card-body text-left d-flex flex-column">
                        <div class="d-flex align-items-center mb-4 border-bottom pb-3">
                            <div class="minimal-icon-box shadow-sm mr-3">
                                <i class="fas fa-bolt"></i>
                            </div>
                            <div>
                                <h4 class="card-title-lg mb-0">Phòng @chiSo.PhongTro?.SoPhong</h4>
                                <small class="text-muted fw-bold uppercase">Ngày ghi: @chiSo.NgayGhi.ToString("dd/MM/yyyy")</small>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="info-group-box h-100 border-start border-primary border-4">
                                    <div class="small text-muted fw-bold uppercase mb-1" style="font-size:0.7rem">Điện tiêu thụ</div>
                                    <div class="fw-bold text-primary fs-5">@chiSo.SoDienTieuThu <small>kWh</small></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-group-box h-100 border-start border-warning border-4">
                                    <div class="small text-muted fw-bold uppercase mb-1" style="font-size:0.7rem">Đơn giá điện</div>
                                    <div class="fw-bold text-dark">@chiSo.DonGiaDien.ToString("N0")</div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="info-group-box h-100 border-start border-info border-4">
                                    <div class="small text-muted fw-bold uppercase mb-1" style="font-size:0.7rem">Nước tiêu thụ</div>
                                    <div class="fw-bold text-info fs-5">@chiSo.SoNuocTieuThu <small>m³</small></div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="info-group-box h-100 border-start border-green border-4">
                                    <div class="small text-muted fw-bold uppercase mb-1" style="font-size:0.7rem">Đơn giá nước</div>
                                    <div class="fw-bold text-dark">@chiSo.DonGiaNuoc.ToString("N0")</div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto pt-4 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@chiSo.MaChiSo" class="btn btn-primary btn-sm px-4" style="border-radius:10px; font-weight:700">CHI TIẾT</a>
                            <div class="d-flex gap-2">
                                <button onclick="showPasswordModal('edit', '@chiSo.MaChiSo')" class="btn btn-action-circle btn-outline-warning">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button onclick="showPasswordModal('delete', '@chiSo.MaChiSo')" class="btn btn-action-circle btn-outline-danger">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 30px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5">
                <i class="fas fa-shield-alt fa-3x text-warning mb-3"></i>
                <h5 class="modal-title fw-bold">XÁC MINH DANH TÍNH</h5>
            </div>
            <div class="modal-body px-5">
                <p class="text-center text-muted small mb-4">Vui lòng nhập mật khẩu chủ trọ để tiếp tục.</p>
                <input type="password" id="verifyPassword" class="form-control border-0 bg-light text-center shadow-sm" placeholder="Nhập mật khẩu..." style="border-radius:15px; height:60px; font-size: 1.1rem;">
                <div id="passwordError" class="text-danger mt-2 text-center small" style="display:none;"></div>
            </div>
            <div class="modal-footer border-0 px-5 pb-5">
                <button type="button" class="btn btn-dark w-100 fw-bold shadow" style="height:55px; border-radius:15px" onclick="submitPassword()">XÁC NHẬN</button>
                <button type="button" class="btn btn-link text-muted mt-2 mx-auto w-100" data-bs-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        let actionType = null;
        let recordId = null;

        function showPasswordModal(type, id = null) {
            actionType = type;
            recordId = id;
            document.getElementById("verifyPassword").value = "";
            document.getElementById("passwordError").style.display = "none";
            new bootstrap.Modal(document.getElementById('passwordModal')).show();
        }

        function submitPassword() {
            const password = document.getElementById("verifyPassword").value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("/ChuTroArea/ChiSoDienNuoc/VerifyPassword", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                body: JSON.stringify({ password: password })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (actionType === "create") window.location.href = "/ChuTroArea/ChiSoDienNuoc/Create";
                    else if (actionType === "edit") window.location.href = `/ChuTroArea/ChiSoDienNuoc/Edit/${recordId}`;
                    else if (actionType === "delete") {
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/ChuTroArea/ChiSoDienNuoc/Delete/${recordId}`;
                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden'; tokenInput.name = '__RequestVerificationToken'; tokenInput.value = token;
                        form.appendChild(tokenInput);
                        document.body.appendChild(form);
                        form.submit();
                    }
                } else {
                    const err = document.getElementById("passwordError");
                    err.innerText = data.message;
                    err.style.display = "block";
                }
            });
        }
    </script>
}