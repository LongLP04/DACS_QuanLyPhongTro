@model DACS_QuanLyPhongTro.Models.ChiSoDienNuoc
@{
    ViewData["Title"] = "Chi Tiết Chỉ Số Điện Nước";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    
    // Tính toán tổng tiền (Nếu có) để hiển thị nổi bật
    // Logic giả định: Tiêu thụ * Đơn giá
    decimal tongTienDien = Model.SoDienTieuThu * Model.DonGiaDien;
    decimal tongTienNuoc = Model.SoNuocTieuThu * Model.DonGiaNuoc;
    decimal tongCong = tongTienDien + tongTienNuoc;
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0"><i class="fas fa-bolt me-2 text-primary"></i> @ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay Lại
            </a>
            <button class="btn btn-primary btn-sm"><i class="fas fa-edit me-1"></i> Chỉnh sửa</button>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="card card-info card-outline shadow-lg csdn-detail-card">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">Chỉ số tháng: @Model.NgayGhi.ToString("MM/yyyy")</h4>
                <span class="badge bg-danger text-white px-3 py-2 fs-6">
                    Tổng tiền tạm tính: <strong>@tongCong.ToString("N0") VNĐ</strong>
                </span>
            </div>
            
            <div class="card-body p-4">
                
                <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-info-circle me-2"></i> Thông tin chung</h5>
                <dl class="row mb-4 border-bottom pb-3">
                    <dt class="col-sm-3 text-muted">Mã chỉ số:</dt>
                    <dd class="col-sm-3 fw-bold">@Model.MaChiSo</dd>

                    <dt class="col-sm-3 text-muted">Phòng:</dt>
                    <dd class="col-sm-3 fw-bold text-success">@Model.PhongTro?.SoPhong</dd>

                    <dt class="col-sm-3 text-muted">Ngày ghi:</dt>
                    <dd class="col-sm-3">@Model.NgayGhi.ToString("dd/MM/yyyy")</dd>
                    
                    
                </dl>

                <div class="row mb-4">
                    <div class="col-lg-6 border-right pr-4"> 
                        <h5 class="fw-bold mb-3 text-warning"><i class="fas fa-bolt me-2"></i> Chỉ số Điện (kWh)</h5>
                        <dl class="row">
                            <dt class="col-sm-6 text-muted">Điện cũ:</dt>
                            <dd class="col-sm-6 fw-bold">@Model.ChiSoDienCu</dd>

                            <dt class="col-sm-6 text-muted">Điện mới:</dt>
                            <dd class="col-sm-6 fw-bold text-warning">@Model.ChiSoDienMoi</dd>
                            
                            <hr class="mt-2 mb-2">
                            
                            <dt class="col-sm-6 text-muted">Tiêu thụ:</dt>
                            <dd class="col-sm-6 fw-bold text-danger">@Model.SoDienTieuThu kWh</dd>

                            <dt class="col-sm-6 text-muted">Đơn giá:</dt>
                            <dd class="col-sm-6">@Model.DonGiaDien.ToString("N0") VNĐ/kWh</dd>
                        </dl>
                    </div>

                    <div class="col-lg-6 pl-4">
                        <h5 class="fw-bold mb-3 text-success"><i class="fas fa-tint me-2"></i> Chỉ số Nước (m³)</h5>
                        <dl class="row">
                            <dt class="col-sm-6 text-muted">Nước cũ:</dt>
                            <dd class="col-sm-6 fw-bold">@Model.ChiSoNuocCu</dd>

                            <dt class="col-sm-6 text-muted">Nước mới:</dt>
                            <dd class="col-sm-6 fw-bold text-success">@Model.ChiSoNuocMoi</dd>
                            
                            <hr class="mt-2 mb-2">
                            
                            <dt class="col-sm-6 text-muted">Tiêu thụ:</dt>
                            <dd class="col-sm-6 fw-bold text-danger">@Model.SoNuocTieuThu m³</dd>

                            <dt class="col-sm-6 text-muted">Đơn giá:</dt>
                            <dd class="col-sm-6">@Model.DonGiaNuoc.ToString("N0") VNĐ/m³</dd>
                        </dl>
                    </div>
                </div>
                
            </div>
            
            <div class="card-footer bg-light border-top d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-1">
                    <i class="fas fa-arrow-left me-1"></i> Quay Lại Danh Sách
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS CŨ ĐƯỢC GIỮ LẠI VÀ CHỈNH SỬA */
    .csdn-detail-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 20px;
        background-color: #f8ffff; /* Nền trắng xanh nhạt */
        border: 1px solid #dee2e6;
    }
    .csdn-detail-card:hover {
        transform: translateY(-2px); 
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .card-header {
        background-color: #f7f9fc !important;
    }
    .card-title {
        color: #2c3e50 !important;
    }
    
    /* Tối ưu hóa dl/dt/dd cho bố cục */
    .row dt, .row dd {
        padding-top: 5px;
        padding-bottom: 5px;
    }
    .row dd {
        font-size: 1rem; 
    }
    
    /* Đường phân cách dọc giữa 2 cột thông tin */
    .border-right {
        border-right: 1px solid #e9ecef;
    }
</style>