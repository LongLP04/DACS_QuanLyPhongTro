@model DACS_QuanLyPhongTro.Models.ChiSoDienNuoc
@{
    ViewData["Title"] = "Xóa Chỉ Số Điện Nước";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD (DANGER STYLE) */
    .welcome-card-danger {
        background: linear-gradient(135deg, var(--p-red), #ff9a9e) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. CARD CUSTOM & LAYOUT */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px;
        border: 2px solid var(--p-red) !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    }

    .info-label {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 12px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
        margin-bottom: 25px;
        transition: 0.3s;
    }

    /* Hiệu ứng xoay icon khi hover card */
    .card-custom:hover .avatar-danger {
        transform: rotate(15deg);
    }

    .avatar-danger {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        background: linear-gradient(135deg, var(--p-red), #ff9a9e);
        transition: transform 0.4s ease;
    }

    /* 4. BUTTONS */
    .btn-delete-main {
        background: var(--p-red);
        color: #742a2a;
        border-radius: 18px;
        font-weight: 800;
        padding: 18px 60px;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

        .btn-delete-main:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 18px;
        font-weight: 700;
        padding: 18px 60px;
        border: 2.5px solid #edf2f7;
        transition: 0.3s;
        text-transform: uppercase;
    }

        .btn-custom-cancel:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
        }

    .btn-back-minimal {
        border-radius: 15px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 12px 30px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }
</style>

<div class="container-fluid text-left">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-danger shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Gỡ bỏ chỉ số </h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Bạn đang thực hiện xóa hồ sơ điện nước của <strong>Phòng @Model.PhongTro?.SoPhong</strong>.
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block text-white opacity-20">
                            <i class="fas fa-trash-alt fa-5x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> QUAY LẠI DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom shadow-sm">
                <div class="card-body p-0">
                    <div class="d-flex align-items-center mb-5">
                        <div class="avatar-danger shadow-sm mr-4">
                            <i class="fas fa-exclamation-triangle"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-1">Xác nhận xóa dữ liệu</h4>
                            <p class="text-danger mb-0 small font-weight-bold uppercase">Lưu ý: Hành động này không thể hoàn tác và sẽ ảnh hưởng đến báo cáo doanh thu.</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <label class="info-label text-primary"><i class="fas fa-door-open mr-2"></i> Đối tượng phòng</label>
                            <div class="info-value-box">
                                Phòng @Model.PhongTro?.SoPhong
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-success"><i class="fas fa-calendar-check mr-2"></i> Ngày ghi nhận</label>
                            <div class="info-value-box">
                                @Model.NgayGhi.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-warning"><i class="fas fa-bolt mr-2"></i> Điện tiêu thụ</label>
                            <div class="info-value-box">
                                @Model.SoDienTieuThu <small class="ml-2 font-weight-bold">kWh</small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-info"><i class="fas fa-tint mr-2"></i> Nước tiêu thụ</label>
                            <div class="info-value-box">
                                @Model.SoNuocTieuThu <small class="ml-2 font-weight-bold">m³</small>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="text-center mt-5 pt-4 border-top">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaChiSo" />

                        <button type="submit" class="btn btn-delete-main shadow-sm mr-4">
                            <i class="fas fa-trash-alt mr-2"></i> XÁC NHẬN XÓA
                        </button>

                        <a asp-action="Index" class="btn btn-custom-cancel shadow-sm">
                            HỦY BỎ
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>