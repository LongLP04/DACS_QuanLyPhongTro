@model DACS_QuanLyPhongTro.Models.ChiSoDienNuoc
@{
    ViewData["Title"] = "Chỉnh sửa chỉ số điện nước";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. FORM CARD - DÃN RỘNG KHUNG */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px;
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.1);
        transition: transform 0.3s ease;
    }

    .form-label {
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 12px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
    }

    .form-control-custom, .form-select-custom {
        border-radius: 18px !important;
        border: 1.5px solid #edf2f7 !important;
        padding: 15px 25px !important;
        height: auto !important;
        transition: all 0.3s ease;
        background-color: #fbfcfe;
        font-size: 1rem;
        font-weight: 600;
    }

        .form-control-custom:focus, .form-select-custom:focus {
            border-color: var(--p-blue) !important;
            box-shadow: 0 0 0 5px rgba(168, 213, 226, 0.25) !important;
            background-color: #fff;
        }

    /* 4. ICON EFFECT */
    .avatar-icon-wrapper {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple));
        transition: transform 0.4s ease;
    }

    .card-custom:hover .avatar-icon-wrapper {
        transform: rotate(15deg);
    }

    /* 5. BUTTONS */
    .btn-custom-update {
        background: var(--p-blue);
        color: #2c5282;
        border-radius: 18px;
        font-weight: 800;
        padding: 18px 60px;
        border: none;
        transition: all 0.4s ease;
        text-transform: uppercase;
    }

        .btn-custom-update:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(168, 213, 226, 0.45);
        }

    .btn-back-minimal {
        border-radius: 15px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 12px 30px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }
</style>

<div class="container-fluid text-left">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Cập Nhật Chỉ Số</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Chỉnh sửa thông tin tiêu thụ điện nước của <strong>Phòng @Model.PhongTro?.SoPhong</strong>
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block text-white opacity-20">
                            <i class="fas fa-edit fa-5x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> QUAY LẠI DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card card-custom shadow-sm mb-5">
                <div class="card-body p-0">
                    <div class="d-flex align-items-center mb-5">
                        <div class="avatar-icon-wrapper shadow-sm mr-4">
                            <i class="fas fa-tools"></i>
                        </div>
                        <h4 class="fw-bold text-dark mb-0">Hiệu chỉnh dữ liệu tháng @Model.NgayGhi.ToString("MM/yyyy")</h4>
                    </div>

                    <form asp-action="Edit" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaChiSo" />

                        <div class="row g-4">
                            <div class="col-md-12 mb-3">
                                <label asp-for="MaPhong" class="form-label text-primary"><i class="fas fa-door-open mr-2"></i> Phòng Trọ</label>
                                <select asp-for="MaPhong" class="form-select form-select-custom" asp-items="ViewBag.PhongTros" required></select>
                                <span asp-validation-for="MaPhong" class="text-danger small fw-bold"></span>
                            </div>

                            <hr class="opacity-10 my-2" />

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChiSoDienCu" class="form-label text-warning"><i class="fas fa-bolt mr-2"></i> Chỉ Số Điện Cũ</label>
                                <input asp-for="ChiSoDienCu" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="ChiSoDienCu" class="text-danger small fw-bold"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ChiSoDienMoi" class="form-label text-warning"><i class="fas fa-bolt mr-2"></i> Chỉ Số Điện Mới</label>
                                <input asp-for="ChiSoDienMoi" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="ChiSoDienMoi" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ChiSoNuocCu" class="form-label text-info"><i class="fas fa-tint mr-2"></i> Chỉ Số Nước Cũ</label>
                                <input asp-for="ChiSoNuocCu" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="ChiSoNuocCu" class="text-danger small fw-bold"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ChiSoNuocMoi" class="form-label text-info"><i class="fas fa-tint mr-2"></i> Chỉ Số Nước Mới</label>
                                <input asp-for="ChiSoNuocMoi" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="ChiSoNuocMoi" class="text-danger small fw-bold"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="DonGiaDien" class="form-label text-dark"><i class="fas fa-money-bill-wave mr-2"></i> Đơn Giá Điện (VNĐ)</label>
                                <input asp-for="DonGiaDien" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="DonGiaDien" class="text-danger small fw-bold"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DonGiaNuoc" class="form-label text-dark"><i class="fas fa-money-bill-wave mr-2"></i> Đơn Giá Nước (VNĐ)</label>
                                <input asp-for="DonGiaNuoc" class="form-control form-control-custom" type="number" step="0.01" required />
                                <span asp-validation-for="DonGiaNuoc" class="text-danger small fw-bold"></span>
                            </div>
                        </div>

                        <div class="text-center mt-5 pt-4 border-top">
                            <button type="submit" class="btn btn-custom-update shadow-sm mr-4">
                                <i class="fas fa-save mr-2"></i> CẬP NHẬT DỮ LIỆU
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 18px; padding: 18px 40px; font-weight: 700;">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}