@model DACS_QuanLyPhongTro.Models.ToaNha

@{
    ViewData["Title"] = "Xóa Tòa Nhà";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-purple: #c7ceea;
        --p-green: #c1e1c1;
        --p-red: #ffb7b2;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card Cảnh báo (Màu đỏ Pastel) */
    .welcome-card-danger {
        background: linear-gradient(135deg, var(--p-red), #ff9aa2) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
        margin-bottom: 5px;
    }

    .welcome-subtitle {
        font-weight: 500;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.95);
    }

    /* 3. Info Card - Khung bo tròn viền xanh nhạt */
    .card-custom {
        background: var(--surface);
        border-radius: 28px !important;
        padding: 20px;
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 8px 25px rgba(168, 213, 226, 0.15);
    }

    .info-box-display {
        background-color: #f8faff;
        border: 1.5px solid #edf2f7;
        border-radius: 15px;
        padding: 15px 20px;
        color: var(--text-dark);
        font-weight: 600;
        margin-bottom: 5px;
    }

    .form-label {
        font-weight: 800;
        color: #64748b;
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }

    /* 4. Buttons */
    .btn-custom-delete {
        background: #ff6b6b;
        color: white;
        border-radius: 15px;
        font-weight: 800;
        padding: 12px 40px;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-custom-delete:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(255, 107, 107, 0.4);
            background: #ee5253;
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 15px;
        font-weight: 700;
        padding: 12px 40px;
        border: 2px solid #edf2f7;
        transition: all 0.3s ease;
    }

        .btn-custom-cancel:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
            color: var(--text-dark);
        }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 8px 20px;
        transition: 0.3s;
    }

    /* 5. Modal Styling */
    .modal-content {
        border-radius: 28px !important;
        border: none !important;
        overflow: hidden;
    }

    .btn-confirm-lg {
        border-radius: 15px;
        padding: 14px;
        font-weight: 800;
        width: 100%;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-danger">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Xóa Tòa Nhà?</h2>
                            <p class="welcome-subtitle mb-0">Hành động này sẽ gỡ bỏ toàn bộ dữ liệu tòa nhà khỏi hệ thống vĩnh viễn.</p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-exclamation-triangle fa-4x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
            <i class="fas fa-chevron-left mr-2"></i> QUAY LẠI DANH SÁCH
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card card-custom shadow-sm">
                <div class="card-body p-md-4">
                    <form method="post" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaToaNha" />

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label">Tên tòa nhà</label>
                                <div class="info-box-display shadow-sm">
                                    <i class="fas fa-building mr-2 text-primary"></i> @Model.TenToaNha
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label">Địa chỉ</label>
                                <div class="info-box-display shadow-sm">
                                    <i class="fas fa-map-marker-alt mr-2 text-success"></i> @Model.DiaChi
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label">Tổng số tầng</label>
                                <div class="info-box-display shadow-sm">
                                    <i class="fas fa-layer-group mr-2 text-warning"></i> @Model.TongSoTang Tầng
                                </div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label">Mô tả</label>
                                <div class="info-box-display shadow-sm">
                                    <i class="fas fa-info-circle mr-2 text-info"></i> @(string.IsNullOrWhiteSpace(Model.MoTa) ? "Không có mô tả" : Model.MoTa)
                                </div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.ViTri))
                            {
                                <div class="col-12 mb-4">
                                    <label class="form-label">Vị trí tọa độ</label>
                                    <div class="info-box-display shadow-sm">
                                        <i class="fas fa-map mr-2 text-danger"></i> @Model.ViTri
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="alert alert-warning border-0 mt-2 mb-4" style="border-radius: 15px; background-color: rgba(255, 183, 178, 0.2); color: #d63031;">
                            <i class="fas fa-exclamation-circle mr-2"></i>
                            <strong>Lưu ý quan trọng:</strong> Tất cả phòng trọ, hợp đồng và hóa đơn liên quan đến tòa nhà này sẽ bị ảnh hưởng. Hãy chắc chắn trước khi xác nhận.
                        </div>

                        <div class="text-center pb-3">
                            <button type="button" class="btn btn-custom-delete shadow-sm mr-3" data-toggle="modal" data-target="#passwordConfirmModal">
                                <i class="fas fa-trash-alt mr-2"></i> XÁC NHẬN XÓA
                            </button>
                            <a asp-action="Index" class="btn btn-custom-cancel">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="passwordConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content shadow-lg">
            <div class="modal-header d-flex flex-column align-items-center">
                <i class="fas fa-shield-alt fa-3x text-danger mb-3"></i>
                <h5 class="modal-title font-weight-bold" style="letter-spacing: 1px;">XÁC MINH BẢO MẬT</h5>
            </div>
            <div class="modal-body px-5">
                <p class="text-center text-muted small mb-4">Để bảo mật, vui lòng nhập mật khẩu chủ trọ để xác nhận việc xóa tòa nhà này.</p>
                <div class="form-group">
                    <input type="password" class="form-control" id="confirmPassword" placeholder="Nhập mật khẩu..."
                           style="border-radius: 12px; height: 55px; text-align: center; border: 1.5px solid #eee;">
                    <div class="invalid-feedback text-center" id="passwordError">Mật khẩu không chính xác!</div>
                </div>
            </div>
            <div class="modal-footer px-5 flex-column">
                <button type="button" class="btn btn-danger btn-confirm-lg shadow" id="confirmPasswordBtn">XÁC NHẬN XÓA VĨNH VIỄN</button>
                <button type="button" class="btn btn-link text-muted mt-2" data-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const confirmPasswordBtn = document.getElementById('confirmPasswordBtn');
            const passwordInput = document.getElementById('confirmPassword');
            const passwordError = document.getElementById('passwordError');

            confirmPasswordBtn.addEventListener('click', function() {
                const password = passwordInput.value.trim();

                if (!password) {
                    passwordInput.classList.add('is-invalid');
                    return;
                }

                confirmPasswordBtn.disabled = true;
                confirmPasswordBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> ĐANG XÁC THỰC...';

                fetch('/ChuTroArea/ToaNha/VerifyPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ password: password })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        $('#passwordConfirmModal').modal('hide');
                        document.getElementById('deleteForm').submit();
                    } else {
                        passwordInput.classList.add('is-invalid');
                        passwordError.textContent = data.message || 'Mật khẩu không đúng.';
                        confirmPasswordBtn.disabled = false;
                        confirmPasswordBtn.innerHTML = 'XÁC NHẬN XÓA VĨNH VIỄN';
                    }
                })
                .catch(() => {
                    confirmPasswordBtn.disabled = false;
                    confirmPasswordBtn.innerHTML = 'XÁC NHẬN XÓA VĨNH VIỄN';
                });
            });

            // Reset modal when closed
            $('#passwordConfirmModal').on('hidden.bs.modal', function () {
                passwordInput.value = '';
                passwordInput.classList.remove('is-invalid');
            });
        });
    </script>
}