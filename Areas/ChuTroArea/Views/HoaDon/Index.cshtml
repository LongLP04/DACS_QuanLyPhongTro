@model List<DACS_QuanLyPhongTro.Models.HoaDon>
@{
    ViewData["Title"] = "Danh Sách Hóa Đơn";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    var vnd = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    
    var totalInvoices = Model?.Count() ?? 0;
    var pendingInvoices = Model?.Count(h => h.TrangThai == "Chờ xác nhận") ?? 0;
    var paidInvoices = Model?.Count(h => h.TrangThai == "Đã thanh toán") ?? 0;
    var totalRevenue = Model?.Where(h => h.TrangThai == "Đã thanh toán").Sum(h => h.TongTien) ?? 0;
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0">@ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm" onclick="showPasswordModal('create')">
                <i class="fas fa-plus me-1"></i> Tạo Hóa Đơn Mới
            </button>
        </div>
    </div>
</div>

<!-- Summary widgets -->
<div class="row px-2 px-md-3 mt-3 g-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-primary mb-0">
            <div class="inner">
                <h3>@totalInvoices</h3>
                <p>Tổng hóa đơn</p>
            </div>
            <div class="icon"><i class="fas fa-file-invoice"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-warning mb-0">
            <div class="inner">
                <h3>@pendingInvoices</h3>
                <p>Chờ xác nhận</p>
            </div>
            <div class="icon"><i class="fas fa-clock"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-success mb-0">
            <div class="inner">
                <h3>@paidInvoices</h3>
                <p>Đã thanh toán</p>
            </div>
            <div class="icon"><i class="fas fa-check-circle"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-info mb-0">
            <div class="inner">
                <h3>@string.Format("{0:N0}", totalRevenue)</h3>
                <p>Doanh thu (VND)</p>
            </div>
            <div class="icon"><i class="fas fa-money-bill-wave"></i></div>
        </div>
    </div>
    <div class="col-12"><hr class="my-2"></div>
</div>

<div class="row px-2 px-md-3 g-3" id="hoadonGrid">
    @if (Model != null && Model.Any())
    {
        @foreach (var hoaDon in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 hoadon-item" data-room="@hoaDon.ChiSoDienNuoc?.PhongTro?.SoPhong" data-date="@hoaDon.NgayLap.ToString("yyyy-MM-dd")">
                <div class="card shadow-sm border-0 h-100 hoadon-card d-flex flex-column">
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="room-indicator">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:35px;height:35px;">
                                    <i class="fas fa-file-invoice "></i>
                                </div>
                                <span class="room-name ms-2 fw-bold text-dark fs-6">Mã hóa đơn: @hoaDon.MaHoaDon</span>
                            </div>
                            <div>
                                @if (hoaDon.TrangThai == "Đã thanh toán")
                                {
                                    <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 small border-success border"><i class="fas fa-check me-1"></i>Đã thanh toán</span>
                                }
                                else if (hoaDon.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning-soft text-dark rounded-pill px-2 py-1 small border-warning border"><i class="fas fa-clock me-1"></i>Chờ xác nhận</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-soft text-danger rounded-pill px-2 py-1 small border-danger border"><i class="fas fa-times me-1"></i>Hủy</span>
                                }
                            </div>
                        </div>

                        <div class="info-block-tenant p-2 rounded mb-3 bg-light d-flex align-items-center">
                            
                            <div>
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Khách thuê</div>
                                <div class="fw-bold small">@(hoaDon.KhachThue?.HoTen ?? "N/A")</div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border-start border-primary border-4 h-100">
                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;"><i class="fas fa-door-open me-1"></i>Phòng</div>
                                    <div class="fw-bold small">P.@(hoaDon.ChiSoDienNuoc?.PhongTro?.SoPhong)</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border-start border-info border-4 h-100">
                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;"><i class="far fa-calendar-alt me-1"></i>Ngày lập</div>
                                    <div class="fw-bold small">@hoaDon.NgayLap.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="p-2 rounded bg-light mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Tiền điện:</span>
                                <span class="fw-bold">@hoaDon.TienDien.ToString("N0", vnd) đ</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Tiền nước:</span>
                                <span class="fw-bold">@hoaDon.TienNuoc.ToString("N0", vnd) đ</span>
                            </div>
                            <div class="d-flex justify-content-between small mb-1">
                                <span class="text-muted">Tiền phòng:</span>
                                <span class="fw-bold">@hoaDon.TienPhong.ToString("N0", vnd) đ</span>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Tiền dịch vụ:</span>
                                <span class="fw-bold">@hoaDon.TienDichVu.ToString("N0", vnd) đ</span>
                            </div>
                        </div>

                        @if (hoaDon.TrangThai != "Đã thanh toán")
                        {
                            var daysSinceCreation = (DateTime.Now - hoaDon.NgayLap).Days;
                            <div class="mb-3">
                                <span class="badge bg-danger-soft text-danger w-100 py-2 border border-danger border-opacity-25 rounded-3">
                                    <i class="fas fa-exclamation-circle me-1"></i>Quá hạn: @daysSinceCreation ngày
                                </span>
                            </div>
                        }

                        <div class="mt-auto p-2 rounded bg-light bg-opacity-10 text-center border border-success border-opacity-25">
                            <div class="text-dark small fw-bold text-uppercase" style="font-size: 0.65rem; opacity: 0.8;">Tổng thanh toán</div>
                            <div class="fw-bold text-success fs-5">@hoaDon.TongTien.ToString("N0", vnd) <small>VNĐ</small></div>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pt-0 pb-3 px-3">
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@hoaDon.MaHoaDon" class="btn btn-primary flex-fill btn-sm rounded-pill shadow-sm">
                                <i class="fas fa-eye me-1"></i>Xem
                            </a>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;" onclick="showPasswordModal('delete', '@hoaDon.MaHoaDon')">
                                <i class="fas fa-trash-alt small"></i>
                            </button>
                            
                            @if (hoaDon.TrangThai == "Chờ xác nhận")
                            {
                                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm" onclick="showPasswordModal('confirm', '@hoaDon.MaHoaDon')">
                                    <i class="fas fa-check me-1"></i>Duyệt
                                </button>
                            }
                            @if (hoaDon.TrangThai != "Đã thanh toán")
                            {
                                <a asp-area="ChuTroArea" asp-controller="Chat" asp-action="Index" 
                                   asp-route-userId="@hoaDon.KhachThue?.ApplicationUserId" 
                                   asp-route-hotenkhach="@hoaDon.KhachThue?.HoTen"
                                   class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center" style="width:32px;height:32px;">
                                    <i class="fas fa-comments small"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info text-center shadow-sm border-0 rounded-4 py-4">
                <i class="fas fa-info-circle fa-2x mb-3 d-block"></i>
                Không có hóa đơn nào để hiển thị.
            </div>
        </div>
    }
</div>

<!-- Password Confirmation Modal -->
<div class="modal fade" id="passwordModal" tabindex="-1" aria-labelledby="passwordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="passwordModalLabel">Xác minh mật khẩu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="password" id="verifyPassword" class="form-control" placeholder="Nhập mật khẩu của bạn" />
                <div id="passwordError" class="text-danger mt-2" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" onclick="submitPassword()">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<style>
@section Scripts {
    <script>
        let actionType = null;
        let recordId = null;
        function showPasswordModal(type, id = null) {
            actionType = type;
            recordId = id;
            document.getElementById("verifyPassword").value = "";
            document.getElementById("passwordError").style.display = "none";
            var modal = new bootstrap.Modal(document.getElementById('passwordModal'));
            modal.show();
        }

        function submitPassword() {
            const password = document.getElementById("verifyPassword").value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("/ChuTroArea/HoaDon/VerifyPassword", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "RequestVerificationToken": token
                },
                body: JSON.stringify({ password: password })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (actionType === "create") {
                        window.location.href = "/ChuTroArea/HoaDon/Create";
                    } else if (actionType === "edit" && recordId) {
                        window.location.href = `/ChuTroArea/HoaDon/Edit/${recordId}`;
                    } else if (actionType === "delete" && recordId) {
                        // Tạo form ẩn để submit delete request
                        const form = document.createElement('form');
                        form.method = 'POST';
                        form.action = `/ChuTroArea/HoaDon/Delete/${recordId}`;
                        const tokenInput = document.createElement('input');
                        tokenInput.type = 'hidden';
                        tokenInput.name = '__RequestVerificationToken';
                        tokenInput.value = token;
                        form.appendChild(tokenInput);
                        document.body.appendChild(form);
                        form.submit();
                    } else if (actionType === "confirm" && recordId) {
                        window.location.href = `/ChuTroArea/HoaDon/XacNhanThanhToan/${recordId}`;
                    }
                } else {
                    const err = document.getElementById("passwordError");
                    err.innerText = data.message;
                    err.style.display = "block";
                }
            })
            .catch(err => console.error("Error:", err));
        }

        document.addEventListener('DOMContentLoaded', function () {
            const remindButtons = document.querySelectorAll('.remind-btn');

            remindButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const invoiceId = this.dataset.id;

                    fetch(`/ChuTroArea/HoaDon/SendReminder/${invoiceId}`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Nhắc nhở đã được gửi thành công!');
                        } else {
                            alert('Có lỗi xảy ra khi gửi nhắc nhở.');
                        }
                    })
                    .catch(error => console.error('Error:', error));
                });
            });
        });
    </script>
}
    .hoadon-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 0;
        background-color: #f0f8ff;
    }
    .hoadon-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }
    .avatar {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    }
    .hoadon-card .card-title {
        font-size: 1.15rem;
        line-height: 1.3;
        color: #2c3e50;
    }
    .hoadon-card .badge {
        font-size: 0.875rem;
        font-weight: 500;
        background-color: unset !important;
        backdrop-filter: blur(10px);
    }
    .badge.bg-warning {
        background-color: #ffe066 !important;
        color: #333 !important;
    }
    .badge.bg-success {
        background-color: #51cf66 !important;
        color: #fff !important;
    }
    .badge.bg-danger {
        background-color: #ff6b6b !important;
        color: #fff !important;
    }
    .hoadon-card .btn {
        margin-left: 5px;
        font-size: 0.875rem;
        font-weight: 500;
    }
    .hoadon-card .card-body > * + * {
        margin-top: 1rem;
    }
    .hoadon-item {
        margin-bottom: 1rem;
    }
    .hoadon-item:nth-last-child(-n+4) {
        margin-bottom: 0;
    }
    .hoadon-item:nth-child(4n+1) .hoadon-card {
        background-color: #e3ffff;
    }
    .hoadon-item:nth-child(4n+2) .hoadon-card {
        background-color: #fff9f0;
    }
    .hoadon-item:nth-child(4n+3) .hoadon-card {
        background-color: #f0fff4;
    }
    .hoadon-item:nth-child(4n+4) .hoadon-card {
        background-color: #fff0f5;
    }
    .hoadon-card .card-title,
    .hoadon-card .text-muted,
    .hoadon-card .text-secondary {
        color: #2c3e50 !important;
    }
</style>
