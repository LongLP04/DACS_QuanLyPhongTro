@model DACS_QuanLyPhongTro.Models.HoaDon
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    var vnd = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    
    var phieuMoiNhat = Model.PhieuThanhToans?.Any() == true 
                         ? Model.PhieuThanhToans.OrderByDescending(p => p.NgayThanhToan).First() 
                         : null;

    decimal tongTienDien = Model.TienDien;
    decimal tongTienNuoc = Model.TienNuoc;
    decimal tongCong = Model.TongTien;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. DETAIL CARD - DÃN RỘNG */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px;
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.1);
    }

    .group-title {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 25px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
    }

    .info-label {
        font-weight: 700;
        color: #718096;
        font-size: 0.95rem;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
        transition: 0.3s;
        margin-bottom: 20px;
    }

    /* 4. TỔNG TIỀN NỔI BẬT */
    .total-revenue-box {
        background: linear-gradient(135deg, var(--p-red), #ff9a9e);
        border-radius: 25px;
        padding: 35px;
        color: white;
        text-align: center;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        margin-bottom: 45px;
    }

    /* 5. TABLE STYLING */
    .table-custom {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #edf2f7;
    }

    .table-custom thead th {
        background-color: #f8fafc;
        border-bottom: 2px solid #edf2f7;
        color: #64748b;
        text-transform: uppercase;
        font-size: 0.8rem;
        padding: 20px;
    }

    .table-custom tbody td {
        padding: 20px;
        font-weight: 600;
    }

    /* 6. BUTTONS */
    .btn-action-lg {
        border-radius: 18px;
        font-weight: 800;
        padding: 16px 35px;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }
</style>

<div class="container-fluid text-left">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Chi Tiết Hóa Đơn</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Hồ sơ thanh toán cho <strong>Phòng @Model.ChiSoDienNuoc?.PhongTro?.SoPhong</strong> - Khách hàng: @Model.KhachThue?.HoTen
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block text-white opacity-20">
                            <i class="fas fa-receipt fa-5x"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-chevron-left mr-2"></i> TRỞ VỀ DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom">
                <div class="card-body p-0">
                    
                    <div class="total-revenue-box shadow-sm">
                        <div class="d-flex justify-content-center align-items-center mb-2">
                            <span class="badge px-3 py-2 mr-3" style="background: rgba(255,255,255,0.2); border-radius: 10px;">
                                <i class="fas fa-file-invoice mr-1"></i> #@Model.MaHoaDon
                            </span>
                            <span class="text-white small fw-bold uppercase" style="letter-spacing: 2px;">Tổng giá trị hóa đơn</span>
                        </div>
                        <h2 class="fw-bold mb-0" style="font-size: 3.5rem;">@Model.TongTien.ToString("N0", vnd) <small style="font-size: 1.5rem;">VNĐ</small></h2>
                    </div>

                    <div class="row g-5">
                        <div class="col-lg-6">
                            <h5 class="group-title text-primary">
                                <i class="fas fa-info-circle mr-3 opacity-50"></i> Thông tin cơ bản
                            </h5>
                            
                            <label class="info-label">Ngày khởi tạo</label>
                            <div class="info-value-box">
                                <i class="fas fa-calendar-plus text-primary mr-3"></i> @Model.NgayLap.ToString("dd/MM/yyyy")
                            </div>

                            <label class="info-label">Trạng thái hiện tại</label>
                            <div class="info-value-box">
                                @if (Model.TrangThai == "Đã thanh toán") {
                                    <i class="fas fa-check-circle text-success mr-3"></i> <span class="text-success">@Model.TrangThai</span>
                                } else {
                                    <i class="fas fa-clock text-warning mr-3"></i> <span class="text-warning">@Model.TrangThai</span>
                                }
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <h5 class="group-title text-success">
                                <i class="fas fa-credit-card mr-3 opacity-50"></i> Lịch sử giao dịch
                            </h5>

                            <label class="info-label">Phương thức thanh toán</label>
                            <div class="info-value-box">
                                <i class="fas fa-wallet text-info mr-3"></i> @(phieuMoiNhat?.PhuongThucThanhToan?.TenPhuongThuc ?? "Đang chờ thanh toán")
                            </div>

                            <label class="info-label">Ngày xác nhận thanh toán</label>
                            <div class="info-value-box">
                                <i class="fas fa-calendar-check text-success mr-3"></i> @(phieuMoiNhat?.NgayThanhToan.ToString("dd/MM/yyyy") ?? "Chưa thực hiện")
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <h5 class="group-title text-purple">
                                <i class="fas fa-list-ol mr-3 opacity-50"></i> Bảng kê khai chi tiết các khoản phí
                            </h5>
                            <div class="table-responsive table-custom shadow-xs">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Danh mục khoản phí</th>
                                            <th class="text-right">Thành tiền (VNĐ)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><i class="fas fa-home mr-3 text-info"></i> Tiền thuê phòng trọ</td>
                                            <td class="text-right fw-bold">@Model.TienPhong.ToString("N0", vnd) đ</td>
                                        </tr>
                                        <tr>
                                            <td><i class="fas fa-bolt mr-3 text-warning"></i> Tiền điện tiêu thụ</td>
                                            <td class="text-right fw-bold">@Model.TienDien.ToString("N0", vnd) đ</td>
                                        </tr>
                                        <tr>
                                            <td><i class="fas fa-tint mr-3 text-primary"></i> Tiền nước tiêu thụ</td>
                                            <td class="text-right fw-bold">@Model.TienNuoc.ToString("N0", vnd) đ</td>
                                        </tr>
                                        <tr>
                                            <td><i class="fas fa-concierge-bell mr-3 text-success"></i> Tiền dịch vụ phát sinh</td>
                                            <td class="text-right fw-bold">@Model.TienDichVu.ToString("N0", vnd) đ</td>
                                        </tr>
                                    </tbody>
                                    <tfoot style="background-color: #f8fafc;">
                                        <tr>
                                            <td class="text-right fw-bold text-muted uppercase">Tổng cộng hóa đơn:</td>
                                            <td class="text-right fw-bold text-danger fs-4">@Model.TongTien.ToString("N0", vnd) VNĐ</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-5 border-top d-flex justify-content-end gap-3 flex-wrap">
                        <a asp-action="ExportPdf" asp-route-id="@Model.MaHoaDon" class="btn btn-action-lg shadow-sm" style="background: var(--p-red); color: #742a2a; border: none;">
                            <i class="fas fa-file-pdf mr-2"></i> XUẤT FILE PDF
                        </a>

                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <a asp-action="XacNhanThanhToan" asp-route-id="@Model.MaHoaDon" class="btn btn-action-lg shadow-sm" style="background: var(--p-green); color: #2d6a4f; border: none;"
                               onclick="return confirm('Hệ thống sẽ ghi nhận hóa đơn này đã hoàn tất thanh toán. Xác nhận?');">
                                <i class="fas fa-check-double mr-2"></i> DUYỆT THANH TOÁN
                            </a>
                        }

                        <a asp-action="Index" class="btn btn-action-lg shadow-sm" style="background: #f1f5f9; color: #64748b; border: none;">
                            <i class="fas fa-list mr-2"></i> DANH SÁCH
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>