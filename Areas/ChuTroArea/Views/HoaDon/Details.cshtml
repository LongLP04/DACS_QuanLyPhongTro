@model DACS_QuanLyPhongTro.Models.HoaDon
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    var vnd = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    
    // LOGIC CODE ĐƯỢC GIỮ NGUYÊN TỪ VIEW GỐC
    var phieuMoiNhat = Model.PhieuThanhToans?.Any() == true 
                         ? Model.PhieuThanhToans.OrderByDescending(p => p.NgayThanhToan).First() 
                         : null;
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0"><i class="fas fa-file-invoice me-2 text-primary"></i> @ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay Lại
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="card card-warning card-outline shadow-lg hoadon-detail-card">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">Hóa đơn số: @Model.MaHoaDon</h4>
                
                <div class="text-right">
                    <div>
                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="fas fa-clock me-1"></i> @Model.TrangThai</span>
                        }
                        else if (Model.TrangThai == "Đã thanh toán")
                        {
                            <span class="badge bg-success text-white px-3 py-2 fs-6"><i class="fas fa-check-circle me-1"></i> @Model.TrangThai</span>
                        }
                        else
                        {
                            <span class="badge bg-danger text-white px-3 py-2 fs-6"><i class="fas fa-times-circle me-1"></i> @Model.TrangThai</span>
                        }
                    </div>
                    <div class="mt-2">
                        <span class="text-muted small me-2">TỔNG TIỀN:</span>
                        <strong class="text-danger fs-5">@Model.TongTien.ToString("N0", vnd) VNĐ</strong>
                    </div>
                </div>
            </div>
            
            <div class="card-body p-4">
                
                <div class="row mb-4 border-bottom pb-3">
                    <div class="col-lg-6 border-right pr-4"> 
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-user me-2"></i> Thông tin chung</h5>
                        <dl class="row">
                            <dt class="col-sm-4 text-muted">Ngày lập:</dt>
                            <dd class="col-sm-8">@Model.NgayLap.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-4 text-muted">Khách thuê:</dt>
                            <dd class="col-sm-8 fw-bold text-info">@Model.KhachThue?.HoTen</dd>

                            <dt class="col-sm-4 text-muted">Phòng:</dt>
                            <dd class="col-sm-8 fw-bold text-success">@Model.ChiSoDienNuoc?.PhongTro?.SoPhong</dd>
                        </dl>
                    </div>

                    <div class="col-lg-6 pl-4"> 
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-credit-card me-2"></i> Chi tiết Thanh toán</h5>
                        <dl class="row">
                            <dt class="col-sm-5 text-muted">H.thức TT:</dt>
                            <dd class="col-sm-7 fw-bold">@(phieuMoiNhat?.PhuongThucThanhToan?.TenPhuongThuc ?? "Chưa rõ")</dd>

                            <dt class="col-sm-5 text-muted">Ngày TT:</dt>
                            <dd class="col-sm-7">@(phieuMoiNhat?.NgayThanhToan.ToString("dd/MM/yyyy") ?? "Chưa TT")</dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-list-ul me-2"></i> Chi tiết các khoản mục</h5>
                        <div class="border rounded bg-white overflow-hidden">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50%;">Khoản mục</th>
                                        <th style="width: 50%;" class="text-right">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td><i class="fas fa-home me-1 text-info"></i> Tiền phòng</td>
                                        <td class="text-right">@Model.TienPhong.ToString("N0", vnd) VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-bolt me-1 text-warning"></i> Tiền điện (Căn cứ chỉ số)</td>
                                        <td class="text-right">@Model.TienDien.ToString("N0", vnd) VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-tint me-1 text-primary"></i> Tiền nước (Căn cứ chỉ số)</td>
                                        <td class="text-right">@Model.TienNuoc.ToString("N0", vnd) VNĐ</td>
                                    </tr>
                                    <tr>
                                        <td><i class="fas fa-tools me-1 text-success"></i> Tiền dịch vụ (WiFi, vệ sinh...)</td>
                                        <td class="text-right">@Model.TienDichVu.ToString("N0", vnd) VNĐ</td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="fw-bold text-right">TỔNG CỘNG:</td>
                                        <td class="text-right fw-bold text-danger">@Model.TongTien.ToString("N0", vnd) VNĐ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-light border-top d-flex justify-content-end gap-2">
                
                <a asp-action="ExportPdf" asp-route-id="@Model.MaHoaDon" class="btn btn-danger btn-sm px-3 py-1">
                    <i class="fas fa-file-pdf me-1"></i> Xuất PDF
                </a>
                
                @if (Model.TrangThai == "Chờ xác nhận")
                {
                    <a asp-action="XacNhanThanhToan" asp-route-id="@Model.MaHoaDon" class="btn btn-success btn-sm px-3 py-1"
                       onclick="return confirm('Xác nhận hóa đơn đã được thanh toán?');">
                        <i class="fas fa-check me-1"></i> Xác nhận thanh toán
                    </a>
                }
                
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-1">
                    <i class="fas fa-list me-1"></i> Danh sách
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS CŨ ĐƯỢC GIỮ LẠI VÀ CHỈNH SỬA */
    .hoadon-detail-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 20px;
        background-color: #f8ffff; 
        border: 1px solid #dee2e6;
    }
    .hoadon-detail-card:hover {
        transform: translateY(-2px); 
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .card-header {
        background-color: #f7f9fc !important;
    }
    .card-title {
        color: #2c3e50 !important;
    }
    
    /* Tối ưu hóa dl/dt/dd cho bố cục */
    .row dt, .row dd {
        padding-top: 5px;
        padding-bottom: 5px;
    }
    .row dd {
        font-size: 1rem; 
    }
    
    /* Đường phân cách dọc giữa 2 cột thông tin */
    .border-right {
        border-right: 1px solid #e9ecef;
    }
    .table tfoot td {
        border-top: 2px solid #dee2e6;
    }
</style>