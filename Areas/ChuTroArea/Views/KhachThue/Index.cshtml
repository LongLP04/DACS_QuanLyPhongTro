@model IEnumerable<DACS_QuanLyPhongTro.Areas.ChuTroArea.Controllers.KhachThueController.TenantRow>

@{
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0">@ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <a class="btn btn-primary btn-sm" asp-area="ChuTroArea" asp-controller="KhachThue" asp-action="Index">Làm mới</a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <table id="tenantsTable" class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Họ tên</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th>Số phòng</th>
                    <th>Tầng</th>
                    <th>Tòa nhà</th>
                    <th>Địa chỉ</th>
                    <th>Trạng thái phòng</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var t in Model)
                {
                    <tr>
                        <td>@t.HoTen</td>
                        <td>@t.SoDienThoai</td>
                        <td>@t.Email</td>
                        <td>@t.SoPhong</td>
                        <td>@t.Tang</td>
                        <td>@t.TenToaNha</td>
                        <td>@t.DiaChi</td>
                        <td>@t.TrangThaiPhong</td>
                        <td>
                            <a asp-area="ChuTroArea" asp-controller="KhachThue" asp-action="Details" asp-route-id="@t.MaKhachThue" class="btn btn-sm btn-primary me-1">Chi tiết</a>
                            @if(!string.IsNullOrEmpty(t.ApplicationUserId))
                            {
                                <a class="btn btn-sm btn-outline-success" href="@Url.Action("Index", "Chat", new { area = "ChuTroArea", userId = t.ApplicationUserId, hotenkhach = t.HoTen })">Chat</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tenantsTable').DataTable({
                responsive: true
            });
        });
    </script>
}
