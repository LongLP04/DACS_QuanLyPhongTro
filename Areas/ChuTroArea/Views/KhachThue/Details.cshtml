@model DACS_QuanLyPhongTro.Areas.ChuTroArea.Controllers.KhachThueController.KhachThueDetailsViewModel

@{
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    ViewData["Title"] = "Chi tiết Khách thuê: " + Model.HoTen;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-purple: #c7ceea;
        --p-green: #c1e1c1;
        --p-red: #ffb7b2;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR 255PX Y HỆT DASHBOARD */
    .content-wrapper {
        margin-left: 255px !important;
        background-color: #f8faff !important; /* Đồng bộ màu nền dashboard */
        padding-top: 25px;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. TIÊU ĐỀ NGHỆ THUẬT */
    .lofi-header-details {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: var(--text-dark);
        margin-bottom: 0;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
    }

    .lofi-header-details span {
        background: linear-gradient(120deg, var(--p-purple), #94c8db);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* 3. CARD STYLE */
    .card-lofi-details {
        border-radius: 25px !important;
        border: none !important;
        background: #ffffff !important;
        box-shadow: 0 8px 25px rgba(0,0,0,0.05) !important;
        margin-bottom: 25px;
        transition: transform 0.3s ease;
    }

    .card-lofi-details:hover {
        transform: translateY(-5px);
    }

    .card-lofi-details .card-header {
        background-color: transparent !important;
        border-bottom: 1px solid #f1f5f9 !important;
        padding: 1.5rem 2rem;
    }

    .card-lofi-details .card-title {
        font-weight: 800 !important;
        color: var(--text-dark);
        text-transform: uppercase;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
    }

    /* 4. ĐỊNH DẠNG VĂN BẢN */
    dt {
        color: #94a3b8;
        font-weight: 700;
        margin-bottom: 10px;
    }

    dd {
        color: var(--text-dark);
        font-weight: 600;
        margin-bottom: 15px;
    }

    .info-highlight {
        font-size: 1.2rem;
        font-weight: 800 !important;
        color: var(--text-dark);
    }

    /* 5. NÚT QUAY LẠI */
    .btn-lofi-back {
        border-radius: 15px;
        font-weight: 800 !important;
        padding: 12px 25px;
        background: #fff;
        border: 1px solid #edf2f7 !important;
        color: #64748b;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .btn-lofi-back:hover {
        background: #f8fafc;
        transform: translateX(-5px);
        color: var(--text-dark);
    }

    /* 6. TABLE STYLE */
    .table {
        border-collapse: separate !important;
        border-spacing: 0 8px !important;
    }

    .table thead th {
        border: none !important;
        font-weight: 800;
        color: #94a3b8;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 12px 20px !important;
    }

    .table tbody td {
        background: #fbfcfe;
        border: none !important;
        padding: 15px 20px !important;
        vertical-align: middle;
    }

    .table tbody tr td:first-child { border-radius: 12px 0 0 12px; }
    .table tbody tr td:last-child { border-radius: 0 12px 12px 0; }

    .badge-pill-custom {
        padding: 6px 15px;
        border-radius: 50px !important;
        font-weight: 700;
        font-size: 0.7rem;
    }
</style>

<div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap pt-4 pb-4">
        <h2 class="lofi-header-details"><span>Hồ sơ</span> Khách thuê</h2>
        
        <a asp-action="Index" class="btn btn-lofi-back shadow-sm">
            <i class="fas fa-chevron-left mr-2"></i> QUAY LẠI
        </a>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card card-lofi-details h-100">
                <div class="card-header">
                    <h5 class="card-title"><i class="fas fa-id-badge mr-2 text-info"></i> Thông tin cá nhân</h5>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Họ tên:</dt>
                        <dd class="col-sm-8 info-highlight">@Model.HoTen</dd>

                        <dt class="col-sm-4">Email:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Điện thoại:</dt>
                        <dd class="col-sm-8 text-primary" style="font-weight: 800;">@Model.SoDienThoai</dd>

                        <dt class="col-sm-4">Số CCCD:</dt>
                        <dd class="col-sm-8">@Model.CCCD</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card card-lofi-details h-100">
                <div class="card-header">
                    <h5 class="card-title"><i class="fas fa-map-marker-alt mr-2 text-success"></i> Vị trí cư trú</h5>
                </div>
                <div class="card-body p-4">
                    @if (Model.Phong != null)
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Số phòng:</dt>
                            <dd class="col-sm-8 text-success" style="font-size: 1.3rem; font-weight: 900;">Phòng @Model.Phong.SoPhong</dd>

                            <dt class="col-sm-4">Vị trí:</dt>
                            <dd class="col-sm-8">Tầng @Model.Phong.Tang, @Model.Phong.TenToaNha</dd>

                            <dt class="col-sm-4">Địa chỉ:</dt>
                            <dd class="col-sm-8 small text-muted">@Model.Phong.DiaChi</dd>
                        </dl>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-ghost fa-3x text-muted mb-3 opacity-25"></i>
                            <p class="text-muted fw-bold mb-0">Chưa được gán phòng ở.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card card-lofi-details mt-4">
        <div class="card-header">
            <h5 class="card-title"><i class="fas fa-file-signature mr-2 text-warning"></i> Lịch sử hợp đồng</h5>
        </div>
        <div class="card-body p-4">
            @if (Model.HopDongs != null && Model.HopDongs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Mã HD</th>
                                <th>Ngày lập</th>
                                <th>Thời hạn</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center">Xem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.HopDongs)
                            {
                                <tr>
                                    <td class="font-weight-bold">#@h.MaHopDong</td>
                                    <td>@h.NgayLap.ToString("dd/MM/yyyy")</td>
                                    <td>@h.NgayBatDau.ToString("dd/MM") - @h.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        @{
                                            var statusClass = h.TrangThai == "Đang hiệu lực" ? "badge-success" : "badge-secondary";
                                        }
                                        <span class="badge badge-pill-custom @statusClass shadow-sm">@h.TrangThai</span>
                                    </td>
                                    <td class="text-center">
                                        <a class="btn btn-sm btn-light border shadow-sm" style="border-radius: 10px;" 
                                           asp-controller="HopDong" asp-action="Details" asp-route-id="@h.MaHopDong">
                                            <i class="fas fa-eye text-primary"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3 mb-0">Chưa có dữ liệu hợp đồng.</p>
            }
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card card-lofi-details">
                <div class="card-header" style="background: rgba(255, 183, 178, 0.1) !important;">
                    <h5 class="card-title text-danger"><i class="fas fa-exclamation-circle mr-2"></i> Chờ thanh toán</h5>
                </div>
                <div class="card-body p-0">
                    @{ var pending = Model.HoaDons.Where(x => x.TrangThai != "Đã thanh toán").ToList(); }
                    @if (pending.Any())
                    {
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var hd in pending)
                                {
                                    <tr>
                                        <td class="pl-4">#@hd.MaHoaDon</td>
                                        <td class="text-danger font-weight-bold">@hd.TongTien.ToString("N0")₫</td>
                                        <td class="text-right pr-4">
                                            <a asp-controller="HoaDon" asp-action="Details" asp-route-id="@hd.MaHoaDon" class="text-warning"><i class="fas fa-arrow-right"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Đã hoàn thành tất cả hóa đơn! ✨</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card card-lofi-details">
                <div class="card-header">
                    <h5 class="card-title text-success"><i class="fas fa-check-circle mr-2"></i> Lịch sử thanh toán</h5>
                </div>
                <div class="card-body p-0">
                    @{ var paid = Model.HoaDons.Where(x => x.TrangThai == "Đã thanh toán").ToList(); }
                    @if (paid.Any())
                    {
                        <table class="table mb-0">
                            <tbody>
                                @foreach (var hd in paid)
                                {
                                    <tr>
                                        <td class="pl-4">#@hd.MaHoaDon</td>
                                        <td class="text-success font-weight-bold">@hd.TongTien.ToString("N0")₫</td>
                                        <td class="text-right pr-4">
                                            <a asp-controller="HoaDon" asp-action="Details" asp-route-id="@hd.MaHoaDon" class="text-muted"><i class="fas fa-eye"></i></a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0 small">Chưa có lịch sử giao dịch.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>