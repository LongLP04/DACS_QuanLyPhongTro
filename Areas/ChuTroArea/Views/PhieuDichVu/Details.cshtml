@model DACS_QuanLyPhongTro.Models.PhieuDangKyDichVu
@{
    ViewData["Title"] = "Chi tiết Phiếu đăng ký dịch vụ";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card Style */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. Detail Card - Khung bo tròn viền xanh nhạt */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px; /* Dãn rộng vùng đệm nội dung */
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.1);
    }

    .group-title {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 25px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
    }

    .info-label {
        font-weight: 700;
        color: #718096;
        font-size: 0.95rem;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
        transition: 0.3s;
        margin-bottom: 20px;
    }

        .info-value-box:hover {
            border-color: var(--p-blue);
            background-color: #ffffff !important;
            transform: translateX(5px);
        }

    /* 4. Table Styling */
    .table-custom {
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid #edf2f7;
    }

        .table-custom thead th {
            background-color: #f8fafc;
            border-bottom: 2px solid #edf2f7;
            color: #64748b;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1px;
            padding: 20px;
        }

        .table-custom tbody td {
            padding: 20px;
            vertical-align: middle;
            font-weight: 600;
            color: var(--text-dark);
        }

    /* 5. Buttons */
    .btn-action-lg {
        border-radius: 18px;
        font-weight: 800;
        padding: 16px 40px;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }

    .status-pill-lg {
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Chi tiết Đăng ký Dịch vụ</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Xem thông tin chi tiết các dịch vụ bổ sung của khách hàng <strong>@Model.KhachThue.HoTen</strong>
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-concierge-bell fa-5x text-white opacity-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-chevron-left mr-2"></i> TRỞ VỀ DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom">
                <div class="card-body p-0 text-left">

                    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom">
                        <div>
                            <h3 class="fw-bold text-dark mb-1" style="font-weight: 900; font-size: 2.2rem; letter-spacing: -1px;">
                                Phiếu DV #@Model.MaDangKyDichVu
                            </h3>
                            <p class="text-muted mb-0 font-weight-500">Trạng thái xử lý hiện tại</p>
                        </div>
                        <div>
                            @{
                                var isConfirmed = Model.TrangThai == "Đã xác nhận";
                                var statusBg = isConfirmed ? "var(--p-green)" : "var(--p-yellow)";
                                var statusColor = isConfirmed ? "#2d6a4f" : "#856404";
                            }
                            <span class="badge status-pill-lg" style="background-color: @statusBg; color: @statusColor;">
                                <i class="fas @(isConfirmed ? "fa-check-circle" : "fa-clock") mr-2"></i> @Model.TrangThai.ToUpper()
                            </span>
                        </div>
                    </div>

                    <div class="row g-5">
                        <div class="col-lg-6">
                            <h5 class="group-title text-primary">
                                <i class="fas fa-user-circle mr-3 opacity-50"></i> Thông tin chủ thể
                            </h5>

                            <label class="info-label">Khách hàng thuê</label>
                            <div class="info-value-box">
                                <i class="fas fa-id-card text-primary mr-3"></i> @Model.KhachThue.HoTen
                            </div>

                            <label class="info-label">Số phòng</label>
                            <div class="info-value-box">
                                <i class="fas fa-door-open text-success mr-3"></i>
                                <span class="fw-bold">@Model.KhachThue.PhongTros.FirstOrDefault()?.SoPhong</span>
                            </div>

                            <label class="info-label">Số điện thoại</label>
                            <div class="info-value-box">
                                <i class="fas fa-phone-alt text-info mr-3"></i> @Model.KhachThue.SoDienThoai
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <h5 class="group-title text-success">
                                <i class="fas fa-calendar-alt mr-3 opacity-50"></i> Thời gian & Tài chính
                            </h5>

                            <label class="info-label">Ngày đăng ký hệ thống</label>
                            <div class="info-value-box">
                                <i class="fas fa-clock text-warning mr-3"></i> @Model.NgayBatDau.ToString("dd/MM/yyyy")
                            </div>

                            <label class="info-label">Tổng thanh toán dự kiến</label>
                            @{
                                decimal totalAmount = Model.ChiTietPhieuDangKyDichVus.Sum(ct => ct.TongTienDichVu);
                            }
                            <div class="info-value-box shadow-sm" style="background-color: var(--p-red) !important; border: none;">
                                <i class="fas fa-money-bill-wave text-danger mr-3"></i>
                                <span class="fs-4 fw-bold text-danger">@totalAmount.ToString("N0")</span>
                                <small class="ml-2 text-danger font-weight-bold">VNĐ</small>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <h5 class="group-title text-purple">
                                <i class="fas fa-list-ul mr-3 opacity-50"></i> Chi tiết các dịch vụ sử dụng
                            </h5>
                            <div class="table-responsive table-custom">
                                <table class="table table-hover mb-0">
                                    <thead>
                                        <tr>
                                            <th>Tên Dịch Vụ</th>
                                            <th class="text-center">Số Lượng</th>
                                            <th class="text-right">Thành Tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ct in Model.ChiTietPhieuDangKyDichVus)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="bg-light p-2 rounded-circle mr-3" style="width: 35px; height: 35px; display: flex; align-items: center; justify-content: center;">
                                                            <i class="fas fa-tag text-purple small"></i>
                                                        </div>
                                                        @ct.DichVu.TenDichVu
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <span class="badge bg-light text-dark px-3 py-2" style="border-radius: 8px;">x @ct.SoLuong</span>
                                                </td>
                                                <td class="text-right fw-bold text-primary">
                                                    @ct.TongTienDichVu.ToString("N0") đ
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot style="background-color: #f8fafc;">
                                        <tr>
                                            <td colspan="2" class="text-right fw-bold text-muted">TỔNG CỘNG PHIẾU:</td>
                                            <td class="text-right fw-bold text-danger fs-5">@totalAmount.ToString("N0") VNĐ</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-5 border-top d-flex justify-content-end gap-4">
                        @if (Model.TrangThai == "Chờ xác nhận")
                        {
                            <form asp-action="XacNhan" asp-route-id="@Model.MaDangKyDichVu" method="post">
                                <button type="submit" class="btn btn-action-lg shadow-sm" style="background: var(--p-green); color: #2d6a4f; border: none; min-width: 220px;">
                                    <i class="fas fa-check-circle mr-2"></i> XÁC NHẬN PHIẾU
                                </button>
                            </form>
                        }

                        <a asp-action="Index" class="btn btn-action-lg shadow-sm" style="background: #f1f5f9; color: #64748b; border: none; min-width: 200px; display: inline-flex; align-items: center; justify-content: center;">
                            <i class="fas fa-undo mr-2"></i> QUAY LẠI
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>