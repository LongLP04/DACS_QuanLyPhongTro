@model DACS_QuanLyPhongTro.Models.PhieuDangKyDichVu
@{
    ViewData["Title"] = "Chi tiết Phiếu đăng ký dịch vụ";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0"><i class="fas fa-wrench me-2 text-primary"></i> @ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay Lại
            </a>
            <button class="btn btn-success btn-sm"><i class="fas fa-check me-1"></i> Xác nhận Phiếu</button>
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-12 col-md-10 col-lg-8">
        
        <div class="card card-teal card-outline shadow-lg phieudichvu-detail-card">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">Phiếu DV số: @Model.MaDangKyDichVu</h4>
                
                <div>
                    @{
                        // LOGIC: Màu trạng thái Phiếu Dịch vụ
                        var statusClass = Model.TrangThai == "Đã xác nhận" ? "bg-success" : 
                                          Model.TrangThai == "Đang chờ" ? "bg-warning text-dark" : 
                                          "bg-secondary";
                        var iconClass = Model.TrangThai == "Đã xác nhận" ? "fas fa-check-circle" : "fas fa-clock";
                    }
                    <span class="badge @statusClass px-3 py-2 fs-6"><i class="@iconClass me-1"></i> @Model.TrangThai</span>
                </div>
            </div>
            
            <div class="card-body p-4">
                
                <div class="row mb-4">
                    <div class="col-lg-6 border-right pr-4">
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-user-tag me-2"></i> Khách thuê</h5>
                        <dl class="row">
                            <dt class="col-sm-4 text-muted">Họ tên:</dt>
                            <dd class="col-sm-8 fw-bold text-info">@Model.KhachThue.HoTen</dd>

                            <dt class="col-sm-4 text-muted">Phòng:</dt>
                            <dd class="col-sm-8 fw-bold text-success">@Model.KhachThue.PhongTros.FirstOrDefault()?.SoPhong</dd>
                            
                            <dt class="col-sm-4 text-muted">Liên hệ:</dt>
                            <dd class="col-sm-8">@Model.KhachThue.SoDienThoai</dd>
                        </dl>
                    </div>

                    <div class="col-lg-6 pl-4"> 
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-calendar-alt me-2"></i> Thời gian</h5>
                        <dl class="row">
                            <dt class="col-sm-5 text-muted">Ngày Đăng ký:</dt>
                            <dd class="col-sm-7 fw-bold">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>
                            
                            <hr class="mt-2 mb-2">
                            
                            <dt class="col-sm-5 text-muted">Tổng thành tiền:</dt>
                            @{
                                decimal totalAmount = Model.ChiTietPhieuDangKyDichVus.Sum(ct => ct.TongTienDichVu);
                            }
                            <dd class="col-sm-7 fw-bold text-danger">@totalAmount.ToString("N0") VNĐ</dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-list-alt me-2"></i> Danh sách Dịch vụ</h5>
                        <div class="border rounded bg-white overflow-hidden">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50%;">Tên Dịch vụ</th>
                                        <th style="width: 15%;">Số lượng</th>
                                        <th style="width: 35%;" class="text-right">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ct in Model.ChiTietPhieuDangKyDichVus)
                                    {
                                        <tr>
                                            <td><i class="fas fa-tag me-1 text-teal"></i> @ct.DichVu.TenDichVu</td>
                                            <td>@ct.SoLuong</td>
                                            <td class="text-right fw-bold">@ct.TongTienDichVu.ToString("N0") VNĐ</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" class="fw-bold text-right">TỔNG CỘNG:</td>
                                        <td class="text-right fw-bold text-danger">@totalAmount.ToString("N0") VNĐ</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-light border-top d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 py-1">
                    <i class="fas fa-arrow-left me-1"></i> Quay Lại Danh Sách
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS CŨ ĐƯỢC GIỮ LẠI VÀ CHỈNH SỬA */
    .phieudichvu-detail-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 20px;
        background-color: #f8ffff; 
        border: 1px solid #dee2e6;
    }
    .phieudichvu-detail-card:hover {
        transform: translateY(-2px); 
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .card-header {
        background-color: #f7f9fc !important;
    }
    .card-title {
        color: #2c3e50 !important;
    }
    
    /* Tối ưu hóa dl/dt/dd cho bố cục */
    .row dt, .row dd {
        padding-top: 5px;
        padding-bottom: 5px;
    }
    .row dd {
        font-size: 1rem; 
    }
    
    /* Đường phân cách dọc giữa 2 cột thông tin */
    .border-right {
        border-right: 1px solid #e9ecef;
    }
    .table tfoot td {
        border-top: 2px solid #dee2e6;
    }
</style>