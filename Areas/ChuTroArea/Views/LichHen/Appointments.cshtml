@model List<DACS_QuanLyPhongTro.Models.LichHen>

@{
    ViewData["Title"] = "Quản lý lịch hẹn";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalAppointments = Model?.Count ?? 0;
    var pendingAppointments = Model?.Count(a => a.TrangThai == "Pending") ?? 0;
    var acceptedAppointments = Model?.Count(a => a.TrangThai == "Accepted") ?? 0;
    var rejectedAppointments = Model?.Count(a => a.TrangThai == "Rejected") ?? 0;
    var currentDateTime = DateTime.Now;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    /* 3. 4 CARDS THỐNG KÊ */
    .custom-box-tenant {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .custom-box-tenant:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

        .custom-box-tenant .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-box-tenant:hover .icon-wrapper {
            transform: rotate(15deg) scale(1.1);
        }

        .custom-box-tenant h3 {
            font-weight: 800;
            font-size: 1.6rem;
            margin-bottom: 5px;
        }

        .custom-box-tenant p {
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

    /* 4. APPOINTMENT CARDS - DÃN RỘNG NỘI DUNG */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-blue) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important; /* Dãn rộng */
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .card-title-lg {
        font-weight: 850 !important;
        font-size: 1.5rem !important;
        color: #1a202c;
        margin-bottom: 12px;
    }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.4rem;
        transition: 0.3s;
    }

    .count-badge {
        font-size: 0.85rem;
        font-weight: 700;
        color: #4a5568;
        background: #f1f5f9;
        padding: 6px 14px;
        border-radius: 10px;
        margin-right: 8px;
    }

    /* Phân loại màu viền pastel */
    .appointment-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .appointment-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-yellow) !important;
    }

    .appointment-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .appointment-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-red) !important;
    }

    .filter-section {
        background: white;
        padding: 20px 30px;
        border-radius: 24px;
        margin-bottom: 35px;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .note-box {
        background: #f8fafc;
        padding: 12px;
        border-radius: 12px;
        font-size: 0.9rem;
        color: #718096;
        border-left: 4px solid var(--p-blue);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Lịch hẹn xem phòng </h2>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-calendar-alt fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-list-alt"></i></div>
                <h3>@totalAppointments</h3>
                <p>Tổng lịch hẹn</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-yellow)"><i class="fas fa-clock"></i></div>
                <h3>@pendingAppointments</h3>
                <p>Chờ xác nhận</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-check-circle"></i></div>
                <h3>@acceptedAppointments</h3>
                <p>Đã chấp nhận</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-red)"><i class="fas fa-times-circle"></i></div>
                <h3>@rejectedAppointments</h3>
                <p>Đã từ chối</p>
            </div>
        </div>
    </div>

    <div class="filter-section d-flex align-items-center justify-content-between flex-wrap gap-3 mt-2">
        <div class="d-flex align-items-center gap-3">
            <input id="searchBox" type="text" class="form-control border-0 bg-light shadow-sm" style="border-radius: 12px; width: 350px; height: 50px;" placeholder="Tìm theo tên khách, số phòng...">
            <select id="sortSelect" class="form-select border-0 bg-light shadow-sm" style="width:220px; border-radius: 12px; height: 50px; font-weight: 600;">
                <option value="date">Ngày hẹn (Mới nhất)</option>
                <option value="room">Số phòng (A-Z)</option>
                <option value="status">Trạng thái</option>
            </select>
        </div>
    </div>

    <div class="row mt-4" id="appointmentsGrid">
        @foreach (var appointment in Model)
        {
            <div class="col-12 col-md-6 col-xl-4 appointment-item mb-5"
                 data-room="@appointment.PhongTro?.SoPhong"
                 data-tenant="@appointment.KhachThue?.HoTen"
                 data-date="@appointment.NgayHen.ToString("yyyy-MM-dd")"
                 data-status="@appointment.TrangThai">
                <div class="card building-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-4">
                            <div class="minimal-icon-box shadow-sm mr-4">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden text-left">
                                <h4 class="card-title-lg mb-1">Phòng @appointment.PhongTro?.SoPhong</h4>
                                <span class="text-muted small text-truncate d-block">
                                    <i class="fas fa-building mr-1 opacity-50"></i>@appointment.PhongTro?.ToaNha?.TenToaNha
                                </span>
                            </div>
                        </div>

                        <div class="mb-4 text-left">
                            <div class="mb-3">
                                <div class="text-muted small fw-bold text-uppercase mb-1">Khách hẹn:</div>
                                <div class="fw-bold text-dark fs-5">@(appointment.KhachThue?.HoTen ?? "N/A")</div>
                            </div>

                            <div class="d-flex gap-2 mb-3">
                                <span class="count-badge"><i class="far fa-calendar-alt mr-1"></i>@appointment.NgayHen.ToString("dd/MM/yyyy")</span>
                                <span class="count-badge"><i class="far fa-clock mr-1"></i>@appointment.GioHen.ToString(@"hh\:mm")</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(appointment.GhiChu))
                            {
                                <div class="note-box mb-3 italic">
                                    <i class="fas fa-comment-dots mr-2 opacity-50"></i>@appointment.GhiChu
                                </div>
                            }

                            <div>
                                @if (appointment.TrangThai == "Pending")
                                {
                                    <span class="badge text-dark px-3 py-2" style="background-color: var(--p-yellow); border-radius:10px;">Chờ xác nhận</span>
                                }
                                else if (appointment.TrangThai == "Accepted")
                                {
                                    <span class="badge text-dark px-3 py-2" style="background-color: var(--p-green); border-radius:10px;">Đã chấp nhận</span>
                                }
                                else
                                {
                                    <span class="badge text-white px-3 py-2" style="background-color: var(--p-red); border-radius:10px;">Đã từ chối</span>
                                }
                            </div>
                        </div>

                        <div class="mt-auto pt-4 border-top">
                            <div class="d-flex gap-2">
                                @if (appointment.TrangThai == "Pending")
                                {
                                    <button class="btn btn-success flex-fill fw-bold btn-accept" data-id="@appointment.MaLichHen" style="border-radius:12px; background-color: var(--p-green); color: #2d6a4f; border:none;">
                                        Chấp nhận
                                    </button>
                                    <button class="btn btn-danger flex-fill fw-bold btn-reject" data-id="@appointment.MaLichHen" style="border-radius:12px; background-color: var(--p-red); color: #742a2a; border:none;">
                                        Từ chối
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-danger w-100 fw-bold btn-delete" data-id="@appointment.MaLichHen" style="border-radius:12px;">
                                        <i class="fas fa-trash-alt mr-2"></i>Xóa hồ sơ
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        (function(){
            const grid = document.getElementById('appointmentsGrid');
            const searchBox = document.getElementById('searchBox');
            const sortSelect = document.getElementById('sortSelect');

            function filter() {
                const q = (searchBox?.value || '').trim().toLowerCase();
                const items = grid.querySelectorAll('.appointment-item');
                items.forEach(el => {
                    const room = (el.dataset.room || '').toLowerCase();
                    const tenant = (el.dataset.tenant || '').toLowerCase();
                    el.style.display = (!q || room.includes(q) || tenant.includes(q)) ? '' : 'none';
                });
            }

            function sort() {
                const items = Array.from(grid.querySelectorAll('.appointment-item'));
                const type = sortSelect.value;
                items.sort((a,b)=>{
                    if(type==='room') return (a.dataset.room||'').localeCompare(b.dataset.room||'');
                    if(type==='status') return (a.dataset.status||'').localeCompare(b.dataset.status||'');
                    return new Date(b.dataset.date||'') - new Date(a.dataset.date||'');
                });
                items.forEach(i=>grid.appendChild(i));
            }

            searchBox?.addEventListener('input', filter);
            sortSelect?.addEventListener('change', sort);
            sort();
        })();

        document.addEventListener('DOMContentLoaded', function() {
            document.addEventListener('click', function(event) {
                const btnAccept = event.target.closest('.btn-accept');
                const btnReject = event.target.closest('.btn-reject');
                const btnDelete = event.target.closest('.btn-delete');

                if (btnAccept) acceptAppointment(btnAccept.dataset.id);
                if (btnReject) rejectAppointment(btnReject.dataset.id);
                if (btnDelete) deleteAppointment(btnDelete.dataset.id);
            });
        });

        function acceptAppointment(id) {
            if (confirm("Xác nhận chấp nhận lịch hẹn này?")) {
                fetch('@Url.Action("AcceptAppointment", "LichHen", new { area = "ChuTroArea" })', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ id: id })
                }).then(r => r.json()).then(data => data.success ? location.reload() : alert(data.message));
            }
        }

        function rejectAppointment(id) {
            if (confirm("Xác nhận từ chối lịch hẹn này?")) {
                fetch('@Url.Action("RejectAppointment", "LichHen", new { area = "ChuTroArea" })', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ id: id })
                }).then(r => r.json()).then(data => data.success ? location.reload() : alert(data.message));
            }
        }

        function deleteAppointment(id) {
            if (confirm("Bạn có chắc chắn muốn xóa lịch hẹn này?")) {
                fetch('@Url.Action("DeleteAppointment", "LichHen", new { area = "ChuTroArea" })', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ id: id })
                }).then(r => r.json()).then(data => data.success ? location.reload() : alert(data.message));
            }
        }
    </script>
}