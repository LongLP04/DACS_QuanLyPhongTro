@model List<DACS_QuanLyPhongTro.Models.PhieuHienTrangNhanPhong>

@{
    ViewData["Title"] = "Danh Sách Phiếu Hiện Trạng Nhận Phòng";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalRecords = Model?.Count() ?? 0;
    var thisMonthRecords = Model?.Count(p => p.NgayNhanPhong.Month == DateTime.Now.Month && p.NgayNhanPhong.Year == DateTime.Now.Year) ?? 0;
    var pendingRecords = Model?.Count(p => p.TinhTrang == "Chưa xác nhận") ?? 0;
    var completedRecords = Model?.Count(p => p.TinhTrang == "Đã xác nhận") ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    /* 3. STATS CARDS - ĐỒNG BỘ TRANG LỊCH HẸN */
    .custom-box-stats {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .custom-box-stats:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

        .custom-box-stats .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-box-stats:hover .icon-wrapper {
            transform: rotate(15deg) scale(1.1);
        }

    /* 4. PHIẾU CARDS - DÃN RỘNG NỘI DUNG */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-blue) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important;
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        transition: 0.4s;
    }

    .building-card:hover .minimal-icon-box {
        transform: rotate(15deg);
    }

    .info-group-box {
        background: #f8fafc;
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 20px;
        border: 1px solid #edf2f7;
    }

    /* Phân loại màu viền pastel */
    .phieuhientrang-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .phieuhientrang-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-yellow) !important;
    }

    .phieuhientrang-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .phieuhientrang-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-red) !important;
    }

    /* NÚT BẤM */
    .btn-password-verify {
        background: var(--text-dark);
        color: white;
        border-radius: 15px;
        padding: 15px;
        font-weight: 700;
        width: 100%;
        transition: 0.3s;
    }

        .btn-password-verify:hover {
            background: black;
            transform: scale(1.02);
        }

    .custom-table-lofi {
        background: white;
        border-radius: 15px;
        overflow: hidden;
        font-size: 0.9rem;
    }
</style>

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4 text-left">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Hiện Trạng Nhận Phòng</h2>
                            <p class="text-white opacity-90 mb-0">Kiểm soát cơ sở vật chất khi bàn giao phòng cho khách thuê.</p>
                        </div>
                        <div class="col-md-3 text-right">
                            <button class="btn btn-dark shadow px-4" style="border-radius:12px; height: 50px; font-weight: 700;" onclick="showPasswordModal(event)">
                                + TẠO PHIẾU MỚI
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-clipboard-list"></i></div>
                <h3>@totalRecords</h3>
                <p>Tổng phiếu</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-purple)"><i class="fas fa-calendar-alt"></i></div>
                <h3>@thisMonthRecords</h3>
                <p>Tháng này</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-yellow); color:#856404"><i class="fas fa-clock"></i></div>
                <h3>@pendingRecords</h3>
                <p>Chờ xác nhận</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-check-circle"></i></div>
                <h3>@completedRecords</h3>
                <p>Đã xác nhận</p>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2" id="phieuhientrangGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="card p-5 border-0 shadow-sm" style="border-radius:30px;">
                    <i class="fas fa-folder-open fa-4x text-muted opacity-25 mb-3"></i>
                    <h4 class="text-muted">Không có phiếu hiện trạng nào.</h4>
                </div>
            </div>
        }
        else
        {
            @foreach (var phieu in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 phieuhientrang-item mb-5">
                    <div class="card building-card shadow-sm h-100 text-left">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-4">
                                <div class="minimal-icon-box shadow-sm mr-3">
                                    <i class="fas fa-key"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h4 class="card-title-lg mb-0" style="font-size: 1.25rem;">@phieu.KhachThue?.HoTen</h4>
                                    <span class="text-muted small fw-bold">Ngày nhận: @phieu.NgayNhanPhong.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                                <span class="badge px-3 py-2" style="background: @(phieu.TinhTrang == "Đã xác nhận" ? "var(--p-green)" : "var(--p-yellow)"); color: @(phieu.TinhTrang == "Đã xác nhận" ? "#2d6a4f" : "#856404"); border-radius: 10px;">
                                    @phieu.TinhTrang
                                </span>
                            </div>

                            <div class="info-group-box mb-4">
                                <p class="small fw-bold text-muted text-uppercase mb-1">Ghi chú bàn giao:</p>
                                <div class="text-dark">@(string.IsNullOrEmpty(phieu.GhiChu) ? "Không có ghi chú." : phieu.GhiChu)</div>
                            </div>

                            <div class="flex-grow-1">
                                <p class="small fw-bold text-muted text-uppercase mb-2"><i class="fas fa-couch mr-2"></i>Vật dụng liệt kê:</p>
                                <div class="table-responsive custom-table-lofi border">
                                    <table class="table table-hover mb-0">
                                        <thead class="bg-light">
                                            <tr>
                                                <th class="py-2 border-0">Vật dụng</th>
                                                <th class="py-2 border-0">Tình trạng</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (phieu.HienTrangVatDungs != null && phieu.HienTrangVatDungs.Any())
                                            {
                                                @foreach (var v in phieu.HienTrangVatDungs)
                                                {
                                                    <tr>
                                                        <td class="py-2 border-top">@v.TenVatDung</td>
                                                        <td class="py-2 border-top"><span class="text-primary font-weight-bold">@v.TinhTrang</span></td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="2" class="text-center text-muted py-3">Danh sách trống</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 30px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5 text-center">
                <i class="fas fa-shield-alt fa-3x text-warning mb-3"></i>
                <h5 class="modal-title font-weight-bold">XÁC MINH DANH TÍNH</h5>
                <p class="text-muted small">Vui lòng nhập mật khẩu để tạo phiếu mới.</p>
            </div>
            <div class="modal-body px-5 pb-4">
                <input type="password" class="form-control border-0 bg-light text-center shadow-sm" id="confirmPassword" placeholder="Mật khẩu của bạn" style="border-radius:15px; height:60px;">
                <div id="passwordError" class="text-danger mt-2 text-center small"></div>
            </div>
            <div class="modal-footer border-0 px-5 pb-5 pt-0">
                <button type="button" class="btn btn-password-verify shadow" onclick="verifyPasswordAndRedirect()">XÁC NHẬN</button>
                <button type="button" class="btn btn-link text-muted mt-2 mx-auto w-100" data-bs-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // LOGIC GIỮ NGUYÊN 100%
        function showPasswordModal(e) {
            e.preventDefault();
            document.getElementById('confirmPassword').value = '';
            document.getElementById('passwordError').innerText = '';
            new bootstrap.Modal(document.getElementById('passwordModal')).show();
        }

        function verifyPasswordAndRedirect() {
            var password = document.getElementById('confirmPassword').value;
            var errorDiv = document.getElementById('passwordError');
            errorDiv.innerText = '';
            if (!password) {
                errorDiv.innerText = 'Vui lòng nhập mật khẩu.';
                return;
            }
            fetch('/ChuTroArea/PhieuHienTrang/VerifyPassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name=__RequestVerificationToken]')?.value || ''
                },
                body: JSON.stringify({ password: password })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.href = '/ChuTroArea/PhieuHienTrang/ChonPhong';
                } else {
                    errorDiv.innerText = data.message || 'Mật khẩu không đúng.';
                }
            })
            .catch(() => {
                errorDiv.innerText = 'Có lỗi xảy ra khi xác thực.';
            });
        }
    </script>
}