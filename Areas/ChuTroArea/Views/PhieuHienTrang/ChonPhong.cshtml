@model List<DACS_QuanLyPhongTro.Models.PhongTro>
@{
    ViewData["Title"] = "Chọn phòng để tạo phiếu hiện trạng";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 35px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.3rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. PHÒNG CARDS - DÃN RỘNG NỘI DUNG */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-blue) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important; /* Dãn rộng */
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.4rem;
        transition: 0.4s;
    }

    /* Hiệu ứng xoay icon khi hover card */
    .building-card:hover .minimal-icon-box {
        transform: rotate(15deg);
    }

    /* Phân loại màu viền pastel */
    .chonphong-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .chonphong-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-yellow) !important;
    }

    .chonphong-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .chonphong-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-purple) !important;
    }

    /* 4. BUTTON STYLE */
    .btn-create-phieu {
        background-color: var(--p-blue);
        color: #2c5282;
        border: none;
        border-radius: 15px;
        font-weight: 800;
        padding: 12px 25px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        width: 100%;
        margin-top: 20px;
    }

        .btn-create-phieu:hover {
            background-color: #94c8db;
            transform: scale(1.05);
            box-shadow: 0 8px 15px rgba(168, 213, 226, 0.4);
        }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }

    .info-tenant-box {
        background: #f8fafc;
        border-radius: 15px;
        padding: 15px;
        margin-top: 15px;
        border: 1px solid #edf2f7;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4 text-left">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Chọn Phòng Bàn Giao</h2>
                            <p class="text-white opacity-90 mb-0">Hệ thống chỉ hiển thị những phòng có hợp đồng đã được xác nhận.</p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-door-open fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" asp-controller="Home" asp-area="ChuTroArea" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> QUAY LẠI TRANG CHỦ
    </a>

    <div class="row g-4" id="chonphongGrid">
        @foreach (var phong in Model)
        {
            var hopDong = phong.HopDongs
            .FirstOrDefault(h =>
            !string.IsNullOrEmpty(h.TrangThai) &&
            h.TrangThai.Trim().Equals("Đã Xác Nhận", StringComparison.OrdinalIgnoreCase));

            <div class="col-12 col-md-6 col-xl-3 chonphong-item mb-4">
                <div class="card building-card shadow-sm text-left h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-center mb-3">
                            <div class="minimal-icon-box shadow-sm mr-3">
                                <i class="fas fa-home"></i>
                            </div>
                            <div>
                                <h4 class="fw-bold text-dark mb-0">Phòng @phong.SoPhong</h4>
                                <span class="text-muted small fw-bold">ID: #@phong.MaPhong</span>
                            </div>
                        </div>

                        <div class="info-tenant-box flex-grow-1">
                            <p class="small fw-bold text-muted text-uppercase mb-1" style="letter-spacing: 0.5px;">Khách thuê hiện tại:</p>
                            <div class="d-flex align-items-center">
                                <i class="fas fa-user-circle mr-2 text-primary"></i>
                                <span class="fw-bold text-dark">@(hopDong?.KhachThue?.HoTen ?? "N/A")</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            <a asp-action="HienThiFormTaoPhieu" asp-route-maPhong="@phong.MaPhong" class="btn btn-create-phieu shadow-sm">
                                <i class="fas fa-plus-circle mr-2"></i> LẬP PHIẾU
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (!Model.Any())
{
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 text-center">
            <div class="card p-5 border-0 shadow-sm" style="border-radius: 30px;">
                <i class="fas fa-search fa-4x text-muted opacity-25 mb-4"></i>
                <h4 class="text-muted">Không tìm thấy phòng khả dụng để tạo phiếu.</h4>
                <p class="small text-muted">Vui lòng kiểm tra lại các hợp đồng đã xác nhận.</p>
            </div>
        </div>
    </div>
}