@model DACS_QuanLyPhongTro.Models.PhongTro

@{
    ViewData["Title"] = "Thêm Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    var toaNhaSoTangJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ToaNhaSoTang ?? new Dictionary<int, int>());
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
        margin-bottom: 5px;
    }

    /* 3. Form Card - Khung bo tròn viền xanh nhạt đồng bộ Index Toa Nha */
    .card-custom {
        background: var(--surface);
        border-radius: 28px !important;
        padding: 20px;
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 8px 25px rgba(168, 213, 226, 0.15);
    }

    .form-label {
        font-weight: 700;
        color: var(--text-dark);
        margin-bottom: 8px;
        font-size: 0.95rem;
    }

    .form-control-custom {
        border-radius: 15px !important;
        border: 1.5px solid #edf2f7 !important;
        padding: 12px 20px !important;
        transition: all 0.3s ease;
    }

        .form-control-custom:focus {
            border-color: var(--p-blue) !important;
            box-shadow: 0 0 0 4px rgba(168, 213, 226, 0.2) !important;
            outline: none;
        }

    /* 4. Buttons */
    .btn-custom-save {
        background: var(--p-blue);
        color: #2c5282;
        border-radius: 15px;
        font-weight: 800;
        padding: 12px 40px;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-custom-save:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(168, 213, 226, 0.4);
            background: #94c8db;
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 15px;
        font-weight: 700;
        padding: 12px 40px;
        border: 2px solid #edf2f7;
        transition: all 0.3s ease;
    }

        .btn-custom-cancel:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
            color: var(--text-dark);
        }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 8px 20px;
        transition: 0.3s;
    }

        .btn-back-minimal:hover {
            border-color: var(--p-blue);
            color: var(--text-dark);
        }

    .alert {
        border-radius: 15px;
        border: none;
    }
</style>

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Thêm Phòng trọ</h2>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-bed fa-4x text-white" style="opacity: 0.3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
            <i class="fas fa-chevron-left mr-2"></i> QUAY LẠI DANH SÁCH
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card card-custom shadow-sm">
                <div class="card-body p-md-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="border-radius: 15px;" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="SoPhong" class="form-label">
                                    <i class="fas fa-door-open mr-2 text-primary"></i>SỐ PHÒNG
                                </label>
                                <input asp-for="SoPhong" class="form-control form-control-custom" placeholder="Ví dụ: 101, A202..." />
                                <span asp-validation-for="SoPhong" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="MaToaNha" class="form-label">
                                    <i class="fas fa-building mr-2 text-success"></i>TÊN TÒA NHÀ
                                </label>
                                <select asp-for="MaToaNha" class="form-control form-control-custom" asp-items="ViewBag.MaToaNha" id="selectToaNha">
                                    <option value="">-- Chọn tòa nhà --</option>
                                </select>
                                <span asp-validation-for="MaToaNha" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Tang" class="form-label">
                                    <i class="fas fa-layer-group mr-2 text-warning"></i>TẦNG
                                </label>
                                <select asp-for="Tang" class="form-control form-control-custom" id="selectTang">
                                    <option value="">-- Chọn tầng --</option>
                                </select>
                                <span asp-validation-for="Tang" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="DienTich" class="form-label">
                                    <i class="fas fa-ruler-combined mr-2 text-info"></i>DIỆN TÍCH (m²)
                                </label>
                                <input asp-for="DienTich" class="form-control form-control-custom" type="number" step="0.01" min="0" placeholder="Nhập diện tích" />
                                <span asp-validation-for="DienTich" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="GiaThue" class="form-label">
                                    <i class="fas fa-money-bill-wave mr-2 text-success"></i>GIÁ THUÊ (VND)
                                </label>
                                <input asp-for="GiaThue" class="form-control form-control-custom" type="number" step="1000" min="0" placeholder="Nhập giá thuê" />
                                <span asp-validation-for="GiaThue" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="TrangThai" class="form-label">
                                    <i class="fas fa-info-circle mr-2 text-warning"></i>TRẠNG THÁI
                                </label>
                                <select asp-for="TrangThai" class="form-control form-control-custom">
                                    <option value="Trống">Trống</option>
                                    <option value="Đã thuê">Đã thuê</option>
                                </select>
                                <span asp-validation-for="TrangThai" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <label asp-for="Hinhanh" class="form-label">
                                    <i class="fas fa-image mr-2 text-danger"></i>HÌNH ẢNH PHÒNG
                                </label>
                                <input type="file" name="Hinhanh" class="form-control form-control-custom" accept=".jpg,.jpeg,.png" />
                                <small class="form-text text-muted mt-2">
                                    <i class="fas fa-info-circle mr-1"></i>Chỉ hỗ trợ định dạng .jpg, .jpeg, .png
                                </small>
                            </div>

                            <div class="col-12 mb-4">
                                <label asp-for="MoTa" class="form-label">
                                    <i class="fas fa-comment-alt mr-2 text-info"></i>MÔ TẢ PHÒNG
                                </label>
                                <textarea asp-for="MoTa" class="form-control form-control-custom" rows="4" placeholder="Nhập mô tả chi tiết về phòng trọ"></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>

                        <div class="text-center pb-3">
                            <button type="submit" class="btn btn-custom-save shadow-sm mr-3">
                                <i class="fas fa-save mr-2"></i> THÊM PHÒNG TRỌ
                            </button>
                            <a asp-action="Index" class="btn btn-custom-cancel">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // LOGIC GIỮ NGUYÊN
        var toaNhaSoTang = @Html.Raw(toaNhaSoTangJson);

        function capNhatTang(maToaNha) {
            var selectTang = document.getElementById("selectTang");
            selectTang.innerHTML = '<option value="">-- Chọn tầng --</option>';

            if (maToaNha && toaNhaSoTang[maToaNha]) {
                for (var i = 1; i <= toaNhaSoTang[maToaNha]; i++) {
                    var option = document.createElement("option");
                    option.value = i;
                    option.text = "Tầng " + i;
                    selectTang.appendChild(option);
                }
            }
        }

        document.getElementById("selectToaNha").addEventListener("change", function () {
            capNhatTang(this.value);
        });

        $(document).ready(function () {
            var defaultToaNha = $("#selectToaNha").val();
            if (defaultToaNha) {
                capNhatTang(defaultToaNha);
            }
        });
    </script>
}