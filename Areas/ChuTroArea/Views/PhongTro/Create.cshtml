@model DACS_QuanLyPhongTro.Models.PhongTro

@{
    ViewData["Title"] = "Thêm Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    var toaNhaSoTangJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ToaNhaSoTang ?? new Dictionary<int, int>());
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 35px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.3rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. Form Card - Dãn cách rộng rãi */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 40px !important; /* Dãn cách lề trong lớn hơn */
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.15);
    }

    .form-label {
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 12px; /* Dãn cách nhãn và ô nhập */
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
    }

    .form-control-custom {
        border-radius: 18px !important;
        border: 1.5px solid #edf2f7 !important;
        padding: 15px 25px !important; /* Dãn rộng khung chữ bên trong */
        height: auto !important;
        transition: all 0.3s ease;
        background-color: #fbfcfe;
        font-size: 1rem;
    }

        .form-control-custom:focus {
            border-color: var(--p-blue) !important;
            box-shadow: 0 0 0 5px rgba(168, 213, 226, 0.25) !important;
            background-color: #fff;
            outline: none;
        }

    /* 4. Buttons */
    .btn-custom-save {
        background: var(--p-blue);
        color: #2c5282;
        border-radius: 18px;
        font-weight: 800;
        padding: 15px 50px;
        border: none;
        transition: all 0.4s ease;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-custom-save:hover {
            transform: translateY(-5px);
box-shadow: 0 10px 20px rgba(168, 213, 226, 0.4);
            background: #94c8db;
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 18px;
        font-weight: 700;
        padding: 15px 50px;
        border: 2px solid #edf2f7;
        transition: 0.3s;
        text-transform: uppercase;
    }

    .btn-back-minimal {
        border-radius: 15px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 25px;
        display: inline-flex;
        align-items: center;
    }

        .btn-back-minimal:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
        }
</style>

<div class="container-fluid text-left">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4 p-3 d-flex align-items-center" style="border-radius: 20px;">
            <i class="fas fa-exclamation-triangle mr-3"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Khởi tạo không gian mới ✨</h2>
                            <p class="mb-0 text-white opacity-80" style="font-size: 1.1rem;">Điền các thông tin chi tiết để thêm phòng trọ vào hệ thống quản lý.</p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-door-open fa-5x text-white" style="opacity: 0.2;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-chevron-left mr-2"></i> TRỞ VỀ DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card card-custom shadow-sm mb-5">
                <div class="card-body p-2">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate autocomplete="off">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-5" style="border-radius: 20px;"></div>

                        <div class="row gx-5">
                            <div class="col-md-6 mb-5">
                                <label asp-for="SoPhong" class="form-label text-primary">
                                    <i class="fas fa-hashtag mr-2"></i>Số Phòng / Mã Phòng
                                </label>
<input asp-for="SoPhong" class="form-control form-control-custom" placeholder="Ví dụ: A.101, Phòng 202..." />
                                <span asp-validation-for="SoPhong" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-5">
                                <label asp-for="MaToaNha" class="form-label text-success">
                                    <i class="fas fa-building mr-2"></i>Tòa Nhà Trực Thuộc
                                </label>
                                <select asp-for="MaToaNha" class="form-control form-control-custom" asp-items="ViewBag.MaToaNha" id="selectToaNha">
                                    <option value="">-- Chọn tòa nhà --</option>
                                </select>
                                <span asp-validation-for="MaToaNha" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-5">
                                <label asp-for="Tang" class="form-label text-warning">
                                    <i class="fas fa-layer-group mr-2"></i>Vị Trí Tầng
                                </label>
                                <select asp-for="Tang" class="form-control form-control-custom" id="selectTang">
                                    <option value="">-- Chọn tầng --</option>
                                </select>
                                <span asp-validation-for="Tang" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-5">
                                <label asp-for="DienTich" class="form-label text-info">
                                    <i class="fas fa-vector-square mr-2"></i>Diện Tích Sử Dụng (m²)
                                </label>
                                <input asp-for="DienTich" class="form-control form-control-custom" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="DienTich" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-5">
                                <label asp-for="GiaThue" class="form-label text-danger">
                                    <i class="fas fa-hand-holding-usd mr-2"></i>Giá Thuê Hàng Tháng (VND)
                                </label>
                                <input asp-for="GiaThue" class="form-control form-control-custom fw-bold" type="number" step="1000" placeholder="Ví dụ: 3500000" />
                                <span asp-validation-for="GiaThue" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-md-6 mb-5">
<label asp-for="TrangThai" class="form-label text-dark">
                                    <i class="fas fa-toggle-on mr-2"></i>Trạng Thái Phòng
                                </label>
                                <select asp-for="TrangThai" class="form-control form-control-custom">
                                    <option value="Trống">Trống (Sẵn sàng cho thuê)</option>
                                    <option value="Đã thuê">Đã thuê (Đang sử dụng)</option>
                                </select>
                                <span asp-validation-for="TrangThai" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>

                            <div class="col-12 mb-5">
                                <label class="form-label text-purple">
                                    <i class="fas fa-camera-retro mr-2"></i>Hình Ảnh Minh Họa
                                </label>
                                <div class="p-4 border-dashed rounded-4 text-center bg-light" style="border: 2px dashed #cbd5e1; border-radius: 20px;">
                                    <input type="file" name="Hinhanh" class="form-control-file d-block mx-auto" accept=".jpg,.jpeg,.png" />
                                    <p class="text-muted small mt-2 mb-0">Hỗ trợ định dạng: .jpg, .png, .jpeg</p>
                                </div>
                            </div>

                            <div class="col-12 mb-5">
                                <label asp-for="MoTa" class="form-label text-muted">
                                    <i class="fas fa-align-left mr-2"></i>Mô Tả Tiện Nghi & Ghi Chú
                                </label>
                                <textarea asp-for="MoTa" class="form-control form-control-custom" rows="5" placeholder="Nhập các tiện nghi như: Có máy lạnh, ban công, giờ giấc tự do..."></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small font-weight-bold mt-2 d-block"></span>
                            </div>
                        </div>

                        <div class="text-center pt-4 border-top mt-2">
                            <button type="submit" class="btn btn-custom-save shadow-sm mr-4">
                                <i class="fas fa-check-circle mr-2"></i> XÁC NHẬN LƯU
                            </button>
                            <a asp-action="Index" class="btn btn-custom-cancel shadow-sm">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var toaNhaSoTang = @Html.Raw(toaNhaSoTangJson);

        function capNhatTang(maToaNha) {
            var selectTang = document.getElementById("selectTang");
selectTang.innerHTML = '<option value="">-- Chọn tầng --</option>';

            if (maToaNha && toaNhaSoTang[maToaNha]) {
                for (var i = 1; i <= toaNhaSoTang[maToaNha]; i++) {
                    var option = document.createElement("option");
                    option.value = i;
                    option.text = "Tầng " + i;
                    selectTang.appendChild(option);
                }
            }
        }

        document.getElementById("selectToaNha").addEventListener("change", function () {
            capNhatTang(this.value);
        });

        $(document).ready(function () {
            var defaultToaNha = $("#selectToaNha").val();
            if (defaultToaNha) {
                capNhatTang(defaultToaNha);
            }
        });
    </script>
}