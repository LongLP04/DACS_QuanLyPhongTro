@model DACS_QuanLyPhongTro.Models.PhongTro

@{
    ViewData["Title"] = "Chỉnh sửa Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card Style */
    .welcome-card-edit {
        background: linear-gradient(135deg, var(--p-yellow), var(--p-blue)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(253, 253, 150, 0.3);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: var(--text-dark);
        margin-bottom: 5px;
    }

    /* 3. Form Card - Dãn rộng khung */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px; /* Dãn rộng vùng đệm nội dung */
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.1);
    }

    .form-label {
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 15px;
        font-size: 0.9rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .form-control-custom {
        border-radius: 18px !important;
        border: 1.5px solid #edf2f7 !important;
        padding: 15px 25px !important;
        height: auto;
        transition: all 0.3s ease;
        background-color: #fbfcfe;
    }

        .form-control-custom:focus {
            border-color: var(--p-blue) !important;
            box-shadow: 0 0 0 5px rgba(168, 213, 226, 0.25) !important;
            background-color: #fff;
            outline: none;
        }

    /* 4. Image Section - Dãn cách hình ảnh */
    .image-edit-wrapper {
        border: 2px dashed var(--p-blue);
        border-radius: 25px;
        padding: 40px;
        background-color: #f8faff;
        margin-top: 10px;
        margin-bottom: 30px;
    }

    .current-img-preview {
        height: 200px;
        width: 200px;
        border-radius: 22px;
        border: 5px solid white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        object-fit: cover;
    }

    /* 5. Buttons */
    .btn-custom-save {
        background: var(--p-blue);
        color: #2c5282;
        border-radius: 18px;
        font-weight: 800;
        padding: 16px 60px;
        border: none;
        transition: all 0.4s ease;
        letter-spacing: 1px;
    }

        .btn-custom-save:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 20px rgba(168, 213, 226, 0.45);
            background: #94c8db;
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 18px;
        font-weight: 700;
        padding: 16px 60px;
        border: 2.5px solid #edf2f7;
        transition: all 0.3s ease;
    }

        .btn-custom-cancel:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
        }

    .btn-back-minimal {
        border-radius: 15px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 12px 30px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }

        .btn-back-minimal:hover {
            transform: translateX(-5px);
            border-color: var(--p-blue);
        }
</style>

<div class="container-fluid">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4 p-3" style="border-radius: 20px; border: none;">
            <i class="fas fa-exclamation-circle mr-2 pl-2"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm mb-4 p-3" style="border-radius: 20px; border: none;">
            <i class="fas fa-check-circle mr-2 pl-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-edit shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Chỉnh sửa Phòng @Model.SoPhong </h2>
                    
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-tools fa-5x text-dark opacity-10"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> TRỞ VỀ DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card card-custom shadow-sm mb-5">
                <div class="card-body p-0">
                    <form asp-controller="PhongTro" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate id="editForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" style="border-radius: 15px;" role="alert"></div>
                        <input type="hidden" asp-for="MaPhong" />

                        <div class="row g-information" style="--bs-gutter-y: 2.5rem;">
                            <div class="col-md-6">
                                <label asp-for="SoPhong" class="form-label text-primary">
                                    <i class="fas fa-door-open mr-3"></i> Số hiệu phòng
                                </label>
                                <input asp-for="SoPhong" class="form-control form-control-custom" />
                                <span asp-validation-for="SoPhong" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaToaNha" class="form-label text-success">
                                    <i class="fas fa-building mr-3"></i> Thuộc cơ sở
                                </label>
                                <select asp-for="MaToaNha" class="form-control form-control-custom" asp-items="ViewBag.MaToaNha">
                                    <option value="">-- Chọn tòa nhà --</option>
                                </select>
                                <span asp-validation-for="MaToaNha" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Tang" class="form-label text-warning">
                                    <i class="fas fa-layer-group mr-3"></i> Tầng số
                                </label>
                                <input asp-for="Tang" class="form-control form-control-custom" type="number" />
                                <span asp-validation-for="Tang" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="DienTich" class="form-label text-info">
                                    <i class="fas fa-ruler-combined mr-3"></i> Diện tích (m²)
                                </label>
                                <input asp-for="DienTich" class="form-control form-control-custom" type="number" />
                                <span asp-validation-for="DienTich" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="GiaThue" class="form-label text-danger">
                                    <i class="fas fa-money-bill-wave mr-3"></i> Giá thuê
                                </label>
                                <input asp-for="GiaThue" class="form-control form-control-custom" type="number" />
                                <span asp-validation-for="GiaThue" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TrangThai" class="form-label text-primary">
                                    <i class="fas fa-info-circle mr-3"></i> Trạng thái
                                </label>
                                <select asp-for="TrangThai" class="form-control form-control-custom">
                                    <option value="Trống">Trống</option>
                                    <option value="Đã thuê">Đã thuê</option>
                                </select>
                                <span asp-validation-for="TrangThai" class="text-danger small font-weight-bold"></span>
                            </div>

                            <div class="col-12 mt-2">
                                <label class="form-label text-danger">
                                    <i class="fas fa-image mr-3"></i> Hình ảnh phòng hiện tại
                                </label>
                                <div class="image-edit-wrapper shadow-sm">
                                    <div class="row align-items-center">
                                        <div class="col-md-auto text-center">
                                            @if (!string.IsNullOrEmpty(Model.Hinhanh))
                                            {
                                                <img src="@Url.Content("~/" + Model.Hinhanh)" alt="Room" class="current-img-preview" />
                                                <p class="mt-3 small text-muted font-weight-bold">ẢNH ĐANG SỬ DỤNG</p>
                                            }
                                            else
                                            {
                                                <div class="current-img-preview d-flex align-items-center justify-content-center bg-white border">
                                                    <i class="fas fa-image fa-3x text-muted opacity-20"></i>
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md pl-md-5 mt-4 mt-md-0">
                                            <div class="p-4 bg-white rounded-lg border shadow-xs">
                                                <h6 class="fw-bold mb-3"><i class="fas fa-cloud-upload-alt mr-2 text-primary"></i>Thay đổi ảnh phòng</h6>
                                                <input type="file" name="Hinhanh" class="form-control-file mb-2" accept=".jpg,.jpeg,.png" />
                                                <p class="mb-0 x-small text-muted italic">* Giữ trống nếu không muốn cập nhật hình ảnh mới.</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTa" class="form-label text-purple">
                                    <i class="fas fa-pen-fancy mr-3"></i> Mô tả chi tiết & Tiện ích
                                </label>
                                <textarea asp-for="MoTa" class="form-control form-control-custom" rows="5" placeholder="Ví dụ: Có máy lạnh, nội thất cơ bản..."></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small font-weight-bold"></span>
                            </div>
                        </div>

                        <div class="text-center mt-5 pt-4">
                            <button type="button" class="btn btn-custom-save shadow-sm mr-4" data-toggle="modal" data-target="#passwordConfirmModal">
                                <i class="fas fa-save mr-2"></i> LƯU THAY ĐỔI
                            </button>
                            <a asp-action="Index" class="btn btn-custom-cancel shadow-sm">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="passwordConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 30px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5 pb-0">
                <i class="fas fa-shield-alt fa-3x text-warning mb-4"></i>
                <h5 class="modal-title font-weight-bold" style="letter-spacing: 1px;">XÁC MINH DANH TÍNH</h5>
            </div>
            <div class="modal-body px-5 py-4">
                <p class="text-center text-muted small mb-4">Nhập mật khẩu chủ trọ để thực hiện lưu thay đổi.</p>
                <input type="password" class="form-control shadow-sm" id="confirmPassword" placeholder="Nhập mật khẩu..."
                       style="border-radius: 18px; height: 60px; text-align: center; border: 2px solid #edf2f7; font-size: 1.1rem;">
                <div class="invalid-feedback text-center mt-2" id="passwordError">Mật khẩu không đúng!</div>
            </div>
            <div class="modal-footer px-5 border-0 pb-5">
                <button type="button" class="btn btn-custom-save w-100" id="confirmPasswordBtn">XÁC NHẬN LƯU</button>
                <button type="button" class="btn btn-link text-muted mt-2 mx-auto" data-dismiss="modal">Đóng lại</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const confirmPasswordBtn = document.getElementById('confirmPasswordBtn');
            const passwordInput = document.getElementById('confirmPassword');
            const passwordError = document.getElementById('passwordError');

            confirmPasswordBtn.addEventListener('click', function() {
                const password = passwordInput.value.trim();
                if (!password) {
                    passwordInput.classList.add('is-invalid');
                    passwordError.textContent = 'Vui lòng nhập mật khẩu.';
                    return;
                }

                confirmPasswordBtn.disabled = true;
                confirmPasswordBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Đang xác thực...';

                fetch('/ChuTroArea/PhongTro/VerifyPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: password })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        $('#passwordConfirmModal').modal('hide');
                        document.getElementById('editForm').submit();
                    } else {
                        passwordInput.classList.add('is-invalid');
                        passwordError.textContent = data.message || 'Mật khẩu không đúng.';
                        confirmPasswordBtn.disabled = false;
                        confirmPasswordBtn.innerHTML = 'XÁC NHẬN';
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    confirmPasswordBtn.disabled = false;
                    confirmPasswordBtn.innerHTML = 'XÁC NHẬN';
                });
            });

            $('#passwordConfirmModal').on('hidden.bs.modal', function() {
                passwordInput.value = '';
                passwordInput.classList.remove('is-invalid');
            });
        });
    </script>
}