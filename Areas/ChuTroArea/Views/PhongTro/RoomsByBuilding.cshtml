@model DACS_QuanLyPhongTro.Models.ViewModels.RoomsByBuildingViewModel
@{
    ViewData["Title"] = "Phòng trọ theo tòa nhà";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD (Thông tin tòa nhà) */
    .welcome-card-building {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 24px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 30px;
    }

    .building-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
        margin-bottom: 5px;
    }

    .building-address {
        font-weight: 500;
        font-size: 1.1rem;
        color: rgba(255, 255, 255, 0.95);
    }

    /* 3. CARD TẦNG - Bo tròn viền màu Pastel (Đồng bộ Index Tòa nhà) */
    .floor-item-container {
        margin-bottom: 40px;
    }

    .floor-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
    }

        .floor-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.04) !important;
        }

    .floor-header-custom {
        padding: 25px 40px !important;
        background: transparent !important;
        border-bottom: 1px solid #edf2f7 !important;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .floor-title-text {
        font-weight: 850 !important;
        font-size: 1.4rem !important;
        color: #1a202c;
        margin: 0;
        letter-spacing: 0.5px;
    }

    .floor-body-custom {
        padding: 40px !important;
        background-color: #ffffff;
        border-radius: 0 0 28px 28px;
    }

    .floor-count-badge {
        font-size: 0.85rem;
        font-weight: 700;
        color: #64748b;
        background: #f1f5f9;
        padding: 8px 18px;
        border-radius: 12px;
    }

    /* Phân loại màu viền trên cho các tầng (Giống Index Tòa nhà) */
    .floor-item-container:nth-child(4n+1) .floor-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .floor-item-container:nth-child(4n+2) .floor-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .floor-item-container:nth-child(4n+3) .floor-card {
        border-top: 8px solid var(--p-purple) !important;
    }

    .floor-item-container:nth-child(4n+4) .floor-card {
        border-top: 8px solid var(--p-red) !important;
    }

    /* 4. NÚT QUAY LẠI */
    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        .btn-back-minimal:hover {
            border-color: var(--p-blue);
            color: var(--text-dark);
            transform: translateX(-5px);
        }

</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-building shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="building-title">@Model.TenToaNha ✨</h2>
                            <p class="building-address mb-0">
                                <i class="fas fa-map-marker-alt mr-2 opacity-75"></i>@Model.DiaChi
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-city fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-chevron-left mr-2"></i> Quay lại danh sách phòng
    </a>

    <div class="row">
        @if (Model.Floors == null || !Model.Floors.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="card p-5 shadow-sm" style="border-radius: 30px; border: 2px dashed var(--p-blue); background: #fff;">
                    <i class="fas fa-door-closed fa-4x text-muted mb-4 opacity-25"></i>
                    <h4 class="text-dark fw-bold">Chưa có dữ liệu phòng</h4>
                    <p class="text-muted">Tòa nhà này hiện tại đang trống.</p>
                </div>
            </div>
        }
        else
        {
            foreach (var floor in Model.Floors.OrderByDescending(k => k.Key))
            {
                <div class="col-12 floor-item-container">
                    <div class="card floor-card shadow-sm">
                        <div class="card-header floor-header-custom">
                            <h5 class="floor-title-text">
                                <i class="fas fa-layer-group mr-3 text-primary opacity-50"></i>TẦNG @floor.Key
                            </h5>
                            <span class="floor-count-badge">@floor.Value.Count() Phòng ở</span>
                        </div>

                        <div class="card-body floor-body-custom">
                            <div class="row g-4">
                                @foreach (var room in floor.Value)
                                {
                                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                        <div class="h-100" style="transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                                            @await Html.PartialAsync("~/Views/Shared/_RoomCard.cshtml", room)
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tự động căn chỉnh chiều cao các phòng bên trong để bằng nhau nếu nội dung dài ngắn khác nhau
            var syncHeights = function() {
                $('.floor-body-custom').each(function() {
                    var items = $(this).find('.room-card'); // Đảm bảo class này khớp với class trong _RoomCard.cshtml
                    if(items.length > 0) {
                        items.css('height', 'auto');
                        var max = 0;
                        items.each(function() {
                            if($(this).outerHeight() > max) max = $(this).outerHeight();
                        });
                        items.css('height', max + 'px');
                    }
                });
            };

            $(window).on('resize', syncHeights);
            setTimeout(syncHeights, 300);
        });
    </script>
}