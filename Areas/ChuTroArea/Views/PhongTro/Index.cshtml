@model IEnumerable<DACS_QuanLyPhongTro.Models.PhongTro>
@{
    ViewData["Title"] = "Danh sách Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalRooms = Model?.Count() ?? 0;
    var totalEmptyRooms = Model?.Count(p => p.TrangThai == "Trống") ?? 0;
    var totalRentedRooms = Model?.Count(p => p.TrangThai == "Đã Thuê") ?? 0;
    var totalRevenue = Model?.Where(p => p.TrangThai == "Đã Thuê").Sum(p => p.GiaThue) ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    /* 3. 4 CARDS THỐNG KÊ */
    .custom-box-tenant {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    .custom-box-tenant:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
    }

    .custom-box-tenant .icon-wrapper {
        width: 70px;
        height: 70px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-bottom: 15px;
        color: white;
    }

    .custom-box-tenant h3 { font-weight: 800; font-size: 1.6rem; margin-bottom: 5px; }
    .custom-box-tenant p { color: #64748b; font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; }

    /* 4. ROOM CARDS */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .building-card:hover {
        transform: translateY(-12px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
        border-color: var(--p-blue) !important;
    }

    .building-card .card-body { padding: 2.2rem !important; flex: 1 1 auto; display: flex; flex-direction: column; }
    .card-title-lg { font-weight: 850 !important; font-size: 1.5rem !important; color: #1a202c; margin-bottom: 12px; }
    .text-address { font-size: 1rem; color: #718096; font-weight: 500; }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.4rem;
    }

    .count-badge { font-size: 0.85rem; font-weight: 700; color: #4a5568; background: #f1f5f9; padding: 6px 14px; border-radius: 10px; margin-right: 8px; }
    .price-text { font-size: 1.25rem; font-weight: 800; color: #2d6a4f; margin-top: 15px; display: block; }

    /* 5. NÚT THAO TÁC */
    .btn-circle-action {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #edf2f7;
        background: white;
        color: #94a3b8;
        transition: 0.3s;
        margin-left: 10px !important;
    }

    .btn-circle-action:hover { background: var(--p-blue); color: white; transform: scale(1.1); border-color: transparent; }

    /* Phân loại màu viền pastel */
    .room-item:nth-child(4n+1) .building-card { border-top: 8px solid var(--p-blue) !important; }
    .room-item:nth-child(4n+2) .building-card { border-top: 8px solid var(--p-green) !important; }
    .room-item:nth-child(4n+3) .building-card { border-top: 8px solid var(--p-purple) !important; }
    .room-item:nth-child(4n+4) .building-card { border-top: 8px solid var(--p-red) !important; }

    .filter-section {
        background: white;
        padding: 20px 30px;
        border-radius: 24px;
        margin-bottom: 35px;
        border: 1px solid #edf2f7;
    }
</style>

<div class="container-fluid">
    <input type="text" style="display:none;" aria-hidden="true">
    <input type="password" style="display:none;" aria-hidden="true">

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Quản lý Phòng Trọ ✨</h2>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-bed fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-bed"></i></div>
                <h3>@totalRooms</h3>
                <p>Tổng phòng</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-door-closed"></i></div>
                <h3>@totalEmptyRooms</h3>
                <p>Phòng trống</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-purple)"><i class="fas fa-door-open"></i></div>
                <h3>@totalRentedRooms</h3>
                <p>Đã cho thuê</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-red)"><i class="fas fa-money-bill-wave"></i></div>
                <h3>@string.Format("{0:N0}", totalRevenue)</h3>
                <p>Doanh thu (đ)</p>
            </div>
        </div>
    </div>

    <div class="filter-section d-flex align-items-center justify-content-between flex-wrap gap-3 mt-2 shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <input id="searchBox" type="text" 
                   class="form-control border-0 bg-light shadow-sm" 
                   style="border-radius: 12px; width: 350px; height: 50px;" 
                   placeholder="Tìm theo số phòng, tòa nhà..." 
                   readonly 
                   onfocus="this.removeAttribute('readonly');" 
                   autocomplete="new-password" 
                   name="phongtroSearch_@(Guid.NewGuid().ToString("N"))">

            <select id="sortSelect" class="form-select border-0 bg-light shadow-sm" style="width:180px; border-radius: 12px; height: 50px; font-weight: 600;">
                <option value="room">Số phòng (A→Z)</option>
                <option value="price">Giá thuê</option>
                <option value="status">Trạng thái</option>
            </select>
        </div>
        <button class="btn btn-dark shadow" style="border-radius: 12px; font-weight: 700; padding: 12px 30px;" data-toggle="modal" data-target="#passwordConfirmModal">
            + THÊM PHÒNG TRỌ
        </button>
    </div>

    <div class="row mt-4" id="roomsGrid">
        @foreach (var room in Model)
        {
            <div class="col-12 col-md-6 col-xl-4 room-item mb-5"
                 data-room="@room.SoPhong"
                 data-building="@room.ToaNha?.TenToaNha"
                 data-price="@room.GiaThue"
                 data-status="@room.TrangThai">
                <div class="card building-card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start mb-4">
                            <div class="minimal-icon-box shadow-sm mr-4">
                                <i class="fas fa-door-closed"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h4 class="card-title-lg mb-1">Phòng @room.SoPhong</h4>
                                <span class="text-address text-truncate">
                                    <i class="fas fa-building mr-1 opacity-50"></i>@room.ToaNha?.TenToaNha
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="count-badge">Tầng @room.Tang</span>
                                <span class="count-badge">@room.DienTich m²</span>
                                @{
                                    var statusColor = room.TrangThai == "Trống" ? "hsla(184, 80%, 48%, 0.8)" : "hsla(128, 83%, 40%, 0.8)";
                                }
                                <span class="badge text-white px-3 py-2 shadow-sm" style="background-color:@statusColor !important; border-radius:10px;">@room.TrangThai</span>
                            </div>

                            <span class="price-text">@string.Format("{0:N0}", room.GiaThue) VND</span>

                            @if (room.KhachThue != null)
                            {
                                <div class="mt-3 text-muted">
                                    <i class="fas fa-user-circle mr-2"></i>Khách: <strong>@room.KhachThue.HoTen</strong>
                                </div>
                            }
                        </div>

                        <div class="mt-auto pt-4 border-top">
                            <div class="d-flex justify-content-end align-items-center">
                                <a asp-action="Details" asp-route-id="@room.MaPhong" class="btn-circle-action btn-view-minimal" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@room.MaPhong" class="btn-circle-action" title="Sửa">
                                    <i class="fas fa-pen-nib"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@room.MaPhong" class="btn-circle-action text-danger" title="Xóa">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@Html.AntiForgeryToken()

<div class="modal fade" id="passwordConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 28px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5">
                <i class="fas fa-shield-alt fa-3x text-warning mb-3"></i>
                <h5 class="modal-title font-weight-bold">XÁC MINH BẢO MẬT</h5>
            </div>
            <div class="modal-body px-5">
                <p class="text-center text-muted small mb-4">Vui lòng nhập mật khẩu chủ trọ để tạo phòng trọ mới.</p>
                <input type="password" class="form-control shadow-sm" id="confirmPassword" 
                       placeholder="Nhập mật khẩu..." 
                       style="border-radius: 15px; height: 55px; text-align: center; border: 1px solid #eee;"
                       readonly onfocus="this.removeAttribute('readonly');" autocomplete="new-password">
                <div class="invalid-feedback text-center" id="passwordError">Mật khẩu không đúng!</div>
            </div>
            <div class="modal-footer px-5 border-0 pb-5 justify-content-center">
                <button type="button" class="btn btn-primary btn-confirm-lg shadow" id="confirmPasswordBtn" style="min-width: 150px; border-radius: 15px; font-weight: 700; height: 50px;">XÁC NHẬN</button>
                <button type="button" class="btn btn-link text-muted mt-2 w-100" data-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Xóa sạch giá trị rác trình duyệt tự điền khi vừa load trang
            setTimeout(function() {
                $('#searchBox').val('');
            }, 50);

            const grid = document.getElementById('roomsGrid');
            const searchBox = document.getElementById('searchBox');
            const sortSelect = document.getElementById('sortSelect');

            function filter() {
                const q = (searchBox?.value || '').trim().toLowerCase();
                const items = grid.querySelectorAll('.room-item');
                items.forEach(el => {
                    const room = (el.dataset.room || '').toLowerCase();
                    const building = (el.dataset.building || '').toLowerCase();
                    el.style.display = (!q || room.includes(q) || building.includes(q)) ? '' : 'none';
                });
            }

            function sort() {
                const items = Array.from(grid.querySelectorAll('.room-item'));
                const type = sortSelect.value;
                items.sort((a,b)=>{
                    if(type==='price') return (parseInt(b.dataset.price||'0') - parseInt(a.dataset.price||'0'));
                    if(type==='status') return (a.dataset.status||'').localeCompare(b.dataset.status||'');
                    return (a.dataset.room||'').localeCompare(b.dataset.room||'', undefined, {numeric: true});
                });
                items.forEach(i=>grid.appendChild(i));
            }

            searchBox?.addEventListener('input', filter);
            sortSelect?.addEventListener('change', sort);
            sort();

            // Logic xác thực mật khẩu
            const confirmPasswordBtn = document.getElementById('confirmPasswordBtn');
            const passwordInput = document.getElementById('confirmPassword');
            const passwordError = document.getElementById('passwordError');

            confirmPasswordBtn?.addEventListener('click', function() {
                const password = passwordInput.value.trim();
                if (!password) {
                    passwordInput.classList.add('is-invalid');
                    return;
                }
                confirmPasswordBtn.disabled = true;
                confirmPasswordBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang xác thực...';

                fetch('/ChuTroArea/PhongTro/VerifyPassword', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: JSON.stringify({ password: password })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) window.location.href = '/ChuTroArea/PhongTro/Create';
                    else {
                        passwordInput.classList.add('is-invalid');
                        passwordError.textContent = data.message || 'Mật khẩu không đúng.';
                        confirmPasswordBtn.disabled = false;
                        confirmPasswordBtn.innerHTML = 'XÁC NHẬN';
                    }
                })
                .catch(() => {
                    confirmPasswordBtn.disabled = false;
                    confirmPasswordBtn.innerHTML = 'XÁC NHẬN';
                });
            });
        });
    </script>
}