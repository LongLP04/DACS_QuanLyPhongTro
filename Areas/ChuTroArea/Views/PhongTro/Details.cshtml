@model DACS_QuanLyPhongTro.Models.PhongTro

@{
    ViewData["Title"] = "Chi tiết Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card Style - Tăng Margin Bottom */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 40px; /* Tăng dãn cách xuống phần nội dung */
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. Detail Card - Tăng Padding */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px; /* Tăng padding cực đại để dãn khung */
        border: 1px solid #f1f5f9 !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    }

    .info-label {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 15px; /* Tăng khoảng cách label tới box */
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 18px 25px !important; /* Tăng padding trong box */
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 65px; /* Tăng chiều cao box */
        transition: 0.4s;
    }

        .info-value-box:hover {
            border-color: var(--p-blue);
            background-color: #ffffff !important;
            transform: translateX(5px);
        }

    /* 4. Hình ảnh và Hiệu ứng */
    .img-wrapper-full {
        height: 100%;
        min-height: 500px; /* Tăng chiều cao ảnh */
        border-radius: 28px;
        overflow: hidden;
        border: 8px solid white;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        position: relative;
    }

    .room-detail-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s ease;
    }

    /* 5. Nút bấm tối giản */
    .btn-minimal {
        width: 55px;
        height: 55px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #edf2f7;
        background: white;
        color: #94a3b8;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .btn-minimal:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

    .row.g-information {
        --bs-gutter-y: 2.5rem; /* Tăng dãn cách dọc giữa các hàng thông tin */
    }

</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Chi tiết không gian</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Cung cấp cái nhìn toàn diện về <strong>Phòng @Model.SoPhong</strong>
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-fingerprint fa-5x text-white opacity-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom">
                <div class="card-body p-0">
                    <div class="row g-5 align-items-stretch">

                        <div class="col-lg-5">
                            <div class="img-wrapper-full">
                                @if (!string.IsNullOrEmpty(Model.Hinhanh))
                                {
                                    <img src="@Url.Content("~/" + Model.Hinhanh)" alt="Room Interior" class="room-detail-img" />
                                }
                                else
                                {
                                    <div class="h-100 d-flex align-items-center justify-content-center bg-light">
                                        <i class="fas fa-image fa-6x text-muted opacity-10"></i>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-lg-7 d-flex flex-column pl-md-5">
                            <div class="mb-auto">
                                <div class="d-flex justify-content-between align-items-start mb-5 pb-4 border-bottom">
                                    <div>
                                        <h3 class="fw-bold text-dark mb-2" style="font-weight: 900; font-size: 2.8rem; letter-spacing: -2px;">
                                            P.@Model.SoPhong
                                        </h3>
                                        <div class="badge bg-light text-muted px-3 py-2" style="border-radius: 8px;">Mã định danh: #@Model.MaPhong</div>
                                    </div>

                                    <div class="d-flex gap-3">
                                        <a asp-action="Index" class="btn-minimal btn-back" title="Về danh sách">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@Model.MaPhong" class="btn-minimal btn-edit" title="Chỉnh sửa">
                                            <i class="fas fa-pen-nib"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@Model.MaPhong" class="btn-minimal btn-delete" title="Xóa bỏ">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </div>

                                <div class="row g-information">
                                    <div class="col-md-6">
                                        <label class="info-label text-success">Phân loại & Trạng thái</label>
                                        @{
                                            var isTrong = Model.TrangThai == "Trống";
                                            var statusColor = isTrong ? "#38b2ac" : "#48bb78";
                                            var statusBg = isTrong ? "rgba(168, 213, 226, 0.25)" : "rgba(193, 225, 193, 0.25)";
                                        }
                                        <div class="info-value-box" style="background-color: @statusBg !important; border-color: transparent !important; color: @statusColor;">
                                            <i class="fas @(isTrong ? "fa-door-closed" : "fa-user-check") mr-3"></i> @Model.TrangThai
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="info-label text-danger">Chi phí thuê tháng</label>
                                        <div class="info-value-box">
                                            <i class="fas fa-money-bill-wave text-danger mr-3"></i>
                                            <span style="font-size: 1.2rem; font-weight: 800;">@string.Format("{0:N0}", Model.GiaThue)</span>
                                            <small class="ml-2 opacity-50">VND</small>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="info-label text-warning">Vị trí mặt bằng</label>
                                        <div class="info-value-box">
                                            <i class="fas fa-layer-group text-warning mr-3"></i> Tầng @Model.Tang
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="info-label text-info">Diện tích khả dụng</label>
                                        <div class="info-value-box">
                                            <i class="fas fa-ruler-combined text-info mr-3"></i> @Model.DienTich m²
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="info-label text-purple">Chủ thể thuê</label>
                                        <div class="info-value-box" style="background-color: #f8faff !important;">
                                            <i class="fas fa-id-badge text-purple mr-3"></i>
                                            <span style="font-size: 1.1rem;">@(Model.KhachThue?.HoTen ?? "Chưa có dữ liệu khách thuê")</span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                                    {
                                        <div class="col-12 mt-4">
                                            <label class="info-label text-secondary">Ghi chú bổ sung</label>
                                            <div class="p-4" style="background-color: #fdfdfd; border-radius: 20px; border-left: 6px solid var(--p-blue); color: #718096; line-height: 1.8;">
                                                <i class="fas fa-quote-left mr-2 opacity-20"></i>
                                                @Model.MoTa
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>