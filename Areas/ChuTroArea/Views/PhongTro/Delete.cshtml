@model DACS_QuanLyPhongTro.Models.PhongTro

@{
    ViewData["Title"] = "Xóa Phòng Trọ";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card (Danger Style) */
    .welcome-card-danger {
        background: linear-gradient(135deg, var(--p-red), #ff9a9e) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. Card Custom & Layout */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px;
        border: 1px solid #f1f5f9 !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    }

    .info-label {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 12px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
        transition: 0.3s;
    }

    /* 4. Hình ảnh full chiều cao & Chuyển động */
    .img-wrapper-full {
        height: 100%;
        min-height: 500px;
        border-radius: 28px;
        overflow: hidden;
        border: 8px solid white;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        position: relative;
        background-color: #f8f9fa;
    }

    .room-preview-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.8s ease;
    }

    .img-wrapper-full:hover .room-preview-img {
        transform: scale(1.1);
    }

    /* 5. Nút thao tác tối giản */
    .btn-action-minimal {
        width: 55px;
        height: 55px;
        border-radius: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #edf2f7;
        background: white;
        color: #94a3b8;
        transition: 0.3s;
        font-size: 1.2rem;
    }

        .btn-action-minimal:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0,0,0,0.05);
            color: white;
        }

    .btn-back-hover:hover {
        background-color: var(--p-blue);
        color: #2c5282;
    }

    /* 6. Nút Xóa Chính */
    .btn-delete-main {
        background: var(--p-red);
        color: #742a2a;
        border-radius: 18px;
        font-weight: 800;
        padding: 16px 50px;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-delete-main:hover {
            transform: scale(1.05);
            box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
            background: #ff9a9e;
        }

    .row.g-info-item {
        --bs-gutter-y: 2.2rem;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-danger shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Gỡ bỏ phòng trọ</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Bạn đang thực hiện thao tác xóa <strong>Phòng @Model.SoPhong</strong> khỏi hệ thống.
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-trash-alt fa-5x text-white opacity-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom">
                <div class="card-body p-0">
                    <form method="post" asp-controller="PhongTro" asp-action="Delete" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaPhong" />

                        <div class="row g-5 align-items-stretch">
                            <div class="col-lg-5">
                                <div class="img-wrapper-full">
                                    @if (!string.IsNullOrEmpty(Model.Hinhanh))
                                    {
                                        <img src="@Url.Content("~/" + Model.Hinhanh)" alt="Room Preview" class="room-preview-img" />
                                    }
                                    else
                                    {
                                        <div class="h-100 d-flex flex-column align-items-center justify-content-center">
                                            <i class="fas fa-image fa-6x text-muted opacity-10"></i>
                                            <p class="text-muted mt-3 font-weight-bold">Không có hình ảnh</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-lg-7 d-flex flex-column pl-md-5">
                                <div class="mb-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom">
                                        <h3 class="fw-bold text-dark mb-0" style="font-weight: 900; font-size: 2.8rem; letter-spacing: -2px;">
                                            P.@Model.SoPhong
                                        </h3>
                                        <a asp-action="Index" class="btn-action-minimal btn-back-hover" title="Hủy và quay lại">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    </div>

                                    <div class="row g-info-item">
                                        <div class="col-md-6">
                                            <label class="info-label text-primary">Vị trí tòa nhà</label>
                                            <div class="info-value-box">
                                                <i class="fas fa-building text-primary mr-3"></i> @Model.ToaNha?.TenToaNha
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="info-label text-warning">Tầng số</label>
                                            <div class="info-value-box">
                                                <i class="fas fa-layer-group text-warning mr-3"></i> Tầng @Model.Tang
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="info-label text-info">Diện tích</label>
                                            <div class="info-value-box">
                                                <i class="fas fa-ruler-combined text-info mr-3"></i> @Model.DienTich m²
                                            </div>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="info-label text-success">Giá đang thuê</label>
                                            <div class="info-value-box">
                                                <i class="fas fa-money-bill-wave text-success mr-3"></i> @string.Format("{0:N0}", Model.GiaThue) <small class="ml-2">VND</small>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="alert alert-warning alert-modern shadow-sm d-flex align-items-center p-4">
                                                <i class="fas fa-exclamation-triangle fa-2x mr-4 text-orange"></i>
                                                <div>
                                                    Hành động xóa sẽ gỡ bỏ toàn bộ dữ liệu lịch sử của phòng này.
                                                    Bạn không thể khôi phục sau khi xác nhận.
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-5 pt-4 text-right">
                                    <button type="button" class="btn-delete-main shadow-sm" data-toggle="modal" data-target="#passwordConfirmModal">
                                        <i class="fas fa-trash-alt mr-2"></i> XÁC NHẬN XÓA VĨNH VIỄN
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="passwordConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 30px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5 pb-0">
                <div class="icon-circle bg-light-red mb-3" style="width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff5f5;">
                    <i class="fas fa-shield-alt fa-3x text-danger"></i>
                </div>
                <h5 class="modal-title font-weight-bold" style="letter-spacing: 1px;">XÁC THỰC CHỦ TRỌ</h5>
            </div>
            <div class="modal-body px-5 py-4">
                <p class="text-center text-muted mb-4">Nhập mật khẩu để xác nhận bạn có quyền xóa tài sản này.</p>
                <input type="password" class="form-control shadow-sm" id="confirmPassword" placeholder="Mật khẩu của bạn..."
                       style="border-radius: 18px; height: 60px; text-align: center; border: 2px solid #edf2f7; font-size: 1.1rem;">
                <div class="invalid-feedback text-center mt-2" id="passwordError">Mật khẩu không chính xác!</div>
            </div>
            <div class="modal-footer px-5 border-0 pb-5">
                <button type="button" class="btn-delete-main w-100" id="confirmPasswordBtn">XÁC NHẬN XÓA</button>
                <button type="button" class="btn btn-link text-muted mt-2 mx-auto" data-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const confirmPasswordBtn = document.getElementById('confirmPasswordBtn');
            const passwordInput = document.getElementById('confirmPassword');
            const passwordError = document.getElementById('passwordError');

            confirmPasswordBtn.addEventListener('click', function() {
                const password = passwordInput.value.trim();
                if (!password) {
                    passwordInput.classList.add('is-invalid');
                    return;
                }

                confirmPasswordBtn.disabled = true;
                confirmPasswordBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Đang xử lý...';

                fetch('/ChuTroArea/PhongTro/VerifyPassword', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password: password })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        $('#passwordConfirmModal').modal('hide');
                        document.getElementById('deleteForm').submit();
                    } else {
                        passwordInput.classList.add('is-invalid');
                        passwordError.textContent = data.message || 'Mật khẩu sai.';
                        confirmPasswordBtn.disabled = false;
                        confirmPasswordBtn.innerHTML = 'XÁC NHẬN XÓA';
                    }
                })
                .catch(() => {
                    confirmPasswordBtn.disabled = false;
                    confirmPasswordBtn.innerHTML = 'XÁC NHẬN XÓA';
                });
            });

            $('#passwordConfirmModal').on('hidden.bs.modal', function() {
                passwordInput.value = '';
                passwordInput.classList.remove('is-invalid');
                confirmPasswordBtn.disabled = false;
            });
        });
    </script>
}