<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chu Tro Admin</title>

    <!-- AdminLTE 3 + deps (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@@5.15.4/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@@1.13.3/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@@3.2/dist/css/adminlte.min.css">
    <!-- Datatables + Toastr (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs4@@1.13.5/css/dataTables.bootstrap4.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastr@@2.1.4/build/toastr.min.css">
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed ">
    <div class="wrapper">
        <style>
            .content-wrapper { background: #f6f7fb; }
            .card, .table { border-radius: 0.5rem; }
            .btn { border-radius: .35rem; }
            /* Sidebar width customization */
            :root { --sidebar-width: 270px; --sidebar-mini-width: 4.6rem; }
            .layout-fixed .main-sidebar,
            .layout-fixed .main-sidebar::before { width: var(--sidebar-width); }
            .layout-fixed .content-wrapper,
            .layout-fixed .main-footer,
            .layout-fixed .main-header { margin-left: var(--sidebar-width); }
            /* Fix navbar positioning - NO MORE OVERLAP */
            .layout-navbar-fixed .main-header { 
                position: fixed;
                top: 0;
                left: var(--sidebar-width);
                right: 0;
                width: calc(100% - var(--sidebar-width));
                z-index: 1030;
                background: white;
            }
            /* Sidebar positioning */
            .main-sidebar { 
                z-index: 1040; 
                position: fixed;
                top: 0;
                left: 0;
                height: 100vh;
                width: var(--sidebar-width);
            }
            /* Remove top spacing from sidebar */
            .sidebar {
                padding-top: 0 !important;
                margin-top: 0 !important;
            }
            .sidebar .user-panel {
                margin-top: 0 !important;
                padding-top: 1rem !important;
            }
            /* Fix sidebar collapse behavior */
            .sidebar-mini.sidebar-collapse .main-sidebar,
            .sidebar-mini.sidebar-collapse .main-sidebar::before { width: var(--sidebar-mini-width); }
            .sidebar-mini.sidebar-collapse .content-wrapper,
            .sidebar-mini.sidebar-collapse .main-footer,
            .sidebar-mini.sidebar-collapse .main-header { margin-left: var(--sidebar-mini-width); }
            .sidebar-mini.sidebar-collapse .layout-navbar-fixed .main-header { 
                left: var(--sidebar-mini-width);
                width: calc(100% - var(--sidebar-mini-width));
            }
            /* Make navbar sit beside sidebar on desktop */
            @@media (min-width: 992px){
                .layout-navbar-fixed .wrapper .main-header { 
                    margin-left: var(--sidebar-width) !important;
                    width: calc(100% - var(--sidebar-width));
                }
                .sidebar-collapse.layout-navbar-fixed .wrapper .main-header {
                    margin-left: var(--sidebar-mini-width) !important;
                    width: calc(100% - var(--sidebar-mini-width));
                }
            }
            @@media (min-width: 992px){
                .sidebar-collapse .main-sidebar,
                .sidebar-collapse .main-sidebar::before { width: var(--sidebar-mini-width); }
                .sidebar-collapse .content-wrapper,
                .sidebar-collapse .main-footer,
                .sidebar-collapse .main-header { margin-left: var(--sidebar-mini-width); }
            }
            @@media (max-width: 991.98px){
                .layout-fixed .content-wrapper,
                .layout-fixed .main-footer,
                .layout-fixed .main-header { margin-left: 0 !important; }
                .layout-navbar-fixed .main-header { left: 0 !important; right: 0; width: 100%; }
                .main-sidebar { position: fixed; }
            }

            /* Floating chat widget */
            #landlordChatFloating {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 2147483600;
                display: flex;
                flex-direction: column;
                align-items: flex-end;
                gap: 12px;
            }

            .ld-chat-toggle {
                width: 58px;
                height: 58px;
                border-radius: 50%;
                border: none;
                background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
                color: #fff;
                box-shadow: 0 12px 30px rgba(37, 117, 252, 0.35);
                position: relative;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: transform .2s ease, box-shadow .2s ease;
            }

            .ld-chat-toggle:hover {
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 16px 36px rgba(37, 117, 252, 0.45);
            }

            .ld-unread-dot {
                position: absolute;
                top: 10px;
                right: 10px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #ff6b6b;
                box-shadow: 0 0 12px rgba(255, 107, 107, 0.8);
                display: none;
            }

            .ld-unread-dot.show {
                display: inline-block;
            }

            .ld-chat-panel {
                width: 420px;
                max-width: calc(100vw - 32px);
                max-height: calc(100vh - 120px);
                background: #fff;
                border-radius: 18px;
                box-shadow: 0 25px 60px rgba(15, 23, 42, 0.25);
                border: 1px solid #e3e8f0;
                overflow: hidden;
                display: flex;
                flex-direction: column;
            }

            .ld-chat-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 14px 16px;
                border-bottom: 1px solid #edf2f7;
                background: linear-gradient(90deg, rgba(106,17,203,0.08), rgba(37,117,252,0.08));
            }

            .ld-chat-body {
                display: flex;
                gap: 12px;
                padding: 14px 16px;
                min-height: 300px;
                overflow: hidden;
                flex: 1;
            }

            .ld-chat-tenants {
                flex: 0 0 42%;
                max-width: 160px;
                border-right: 1px solid #f1f2f6;
                padding-right: 12px;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .ld-tenant-list {
                flex: 1;
                overflow-y: auto;
                padding-right: 6px;
            }

            .ld-tenant-item {
                display: flex;
                flex-direction: column;
                border: 1px solid transparent;
                border-radius: 12px;
                padding: 8px 10px;
                background: #f8fafc;
                margin-bottom: 8px;
                cursor: pointer;
                transition: background .2s ease, border-color .2s ease;
                width: 100%;
                text-align: left;
                color: #0f172a;
                outline: none;
            }

            .ld-tenant-item:focus {
                outline: none;
                box-shadow: none;
            }

            .ld-tenant-item.active {
                border-color: #4c6fff;
                background: rgba(76, 111, 255, 0.08);
            }

            .ld-tenant-item.ld-unread::after {
                content: '';
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #ff6b6b;
                align-self: flex-end;
            }

            .ld-tenant-name {
                font-weight: 600;
                font-size: .9rem;
            }

            .ld-tenant-meta {
                font-size: .75rem;
                color: #94a3b8;
            }

            .ld-chat-conversation {
                flex: 1;
                display: flex;
                flex-direction: column;
                min-width: 0;
                overflow: hidden;
            }

            .ld-chat-messages {
                flex: 1;
                overflow-y: auto;
                padding-right: 6px;
                display: none;
                min-height: 0;
            }

            .ld-chat-empty {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                color: #94a3b8;
                font-size: .9rem;
                gap: 6px;
            }

            .ld-chat-empty i {
                font-size: 2rem;
                color: #8b5cf6;
            }

            .ld-chat-input {
                display: flex;
                gap: 8px;
                margin-top: 10px;
            }

            .ld-chat-message {
                border-radius: 12px;
                padding: 8px 12px;
                margin-bottom: 6px;
                font-size: .85rem;
                max-width: 85%;
                position: relative;
                box-shadow: 0 3px 8px rgba(15,23,42,0.08);
            }

            .ld-chat-message.you {
                margin-left: auto;
                background: #4c6fff;
                color: #fff;
            }

            .ld-chat-message.them {
                margin-right: auto;
                background: #f1f5f9;
                color: #0f172a;
            }

            .ld-chat-time {
                display: block;
                font-size: .7rem;
                margin-top: 4px;
                opacity: .7;
            }

            .ld-tenant-empty {
                font-size: .85rem;
                color: #94a3b8;
                text-align: center;
                margin-top: 12px;
            }

            .ld-chat-footer {
                border-top: 1px solid #edf2f7;
                padding: 8px 16px;
                background: #f8fafc;
            }

            @@media (max-width: 576px) {
                #landlordChatFloating { right: 12px; bottom: 12px; }
                .ld-chat-panel { width: calc(100vw - 24px); }
                .ld-chat-body { flex-direction: column; }
                .ld-chat-tenants {
                    flex: none;
                    max-width: 100%;
                    border-right: none;
                    border-bottom: 1px solid #f1f2f6;
                    padding-right: 0;
                    padding-bottom: 10px;
                }
            }
        </style>
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a asp-area="ChuTroArea" asp-controller="Home" asp-action="Index" class="nav-link">Dashboard</a>
                </li>
            </ul>

            <!-- Right navbar -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <partial name="_LoginPartial" />
                </li>
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user panel -->
                <div class="user-panel pb-3 d-flex">
                    <div class="image">
                        <img src="https://ui-avatars.com/api/?name=@(ViewData["ChuTroHoTen"] ?? "Chu tro")" class="img-circle elevation-2" alt="User Image">
                    </div>
                    <div class="info">
                        <a href="#" class="d-block">@ViewData["ChuTroHoTen"]</a>
                    </div>
                </div>

                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="Home" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-home"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="KhachThue" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-users"></i>
                                <p>Quản lý khách thuê</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="ToaNha" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-city"></i>
                                <p>Tòa nhà</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="PhongTro" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-door-open"></i>
                                <p>Phòng trọ</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="LichHen" asp-action="Appointments" class="nav-link">
                                <i class="nav-icon fas fa-calendar-check"></i>
                                <p>Lịch hẹn</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="HopDong" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-file-contract"></i>
                                <p>Hợp đồng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="PhieuDichVu" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-concierge-bell"></i>
                                <p>Dịch vụ</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="ChiSoDienNuoc" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Chỉ số điện nước</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="HoaDon" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-file-invoice"></i>
                                <p>Hóa đơn</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="PhieuSuCo" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-tools"></i>
                                <p>Sự cố</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="PhieuHienTrang" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-clipboard-check"></i>
                                <p>Hiện trạng</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-area="ChuTroArea" asp-controller="Chat" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-clipboard-check"></i>
                                <p>Chat với khách thuê</p>
