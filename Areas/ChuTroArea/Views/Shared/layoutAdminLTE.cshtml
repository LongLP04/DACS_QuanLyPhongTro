                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <section class="content pt-3">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Main Footer -->
        <footer class="main-footer text-sm">
            <div class="float-right d-none d-sm-inline">
                v1
            </div>
            <strong>&copy; @(DateTime.Now.Year) QuanLyPhongTro.</strong>
        </footer>
    </div>

    <div id="landlordChatFloating">
        <button type="button" class="ld-chat-toggle" id="landlordChatToggle" title="Chat nhanh với khách thuê">
            <i class="fas fa-comments"></i>
            <span class="ld-unread-dot" id="landlordChatUnread"></span>
        </button>
        <div class="ld-chat-panel d-none" id="landlordChatPanel">
            <div class="ld-chat-header">
                <div>
                    <strong>Chat nhanh</strong>
                    <small class="text-muted d-block">Trao đổi tức thì với khách thuê</small>
                </div>
                <button type="button" class="btn btn-sm btn-light ld-chat-close" id="landlordChatClose">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="ld-chat-body">
                <div class="ld-chat-tenants">
                    <div class="input-group input-group-sm mb-2">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" class="form-control" placeholder="Tìm khách..." id="landlordChatSearch" autocomplete="off" />
                    </div>
                    <div class="ld-tenant-list" id="landlordTenantList"></div>
                </div>
                <div class="ld-chat-conversation">
                    <div class="ld-chat-empty" id="landlordChatEmpty">
                        <i class="fas fa-comments"></i>
                        <p class="mb-0">Chọn khách thuê để bắt đầu trò chuyện.</p>
                    </div>
                    <div class="ld-chat-messages" id="landlordChatMessages"></div>
                    <form id="landlordChatForm" class="ld-chat-input">
                        <input type="text" class="form-control" placeholder="Nhập tin nhắn..." autocomplete="off" id="landlordChatMessage" disabled />
                        <button type="submit" class="btn btn-primary" id="landlordChatSend" disabled>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>
            <div class="ld-chat-footer">
                <a href="@Url.Action("Index", "Chat", new { area = "ChuTroArea" })" class="btn btn-link btn-sm p-0">Mở trang chat đầy đủ</a>
            </div>
        </div>
    </div>

    <!-- Scripts (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@@3.6.4/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@@1.13.3/js/OverlayScrollbars.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@@3.2/dist/js/adminlte.min.js"></script>
    <!-- Datatables + Toastr (CDN) -->
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@@1.13.5/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs4@@1.13.5/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastr@@2.1.4/build/toastr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        // Toastr default config
        toastr.options = { positionClass: 'toast-bottom-right', timeOut: 3000 };
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('landlordChatToggle');
            const panel = document.getElementById('landlordChatPanel');
            const closeBtn = document.getElementById('landlordChatClose');
            const tenantListEl = document.getElementById('landlordTenantList');
            const searchInput = document.getElementById('landlordChatSearch');
            const messagesEl = document.getElementById('landlordChatMessages');
            const emptyState = document.getElementById('landlordChatEmpty');
            const form = document.getElementById('landlordChatForm');
            const messageInput = document.getElementById('landlordChatMessage');
            const sendBtn = document.getElementById('landlordChatSend');
            const unreadDot = document.getElementById('landlordChatUnread');

            if (!toggleBtn || !panel || typeof signalR === 'undefined') {
                return;
            }

            let tenants = [];
            let selectedTenantId = null;
            let selectedTenantName = '';
            const unreadMap = new Map();

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chathub')
                .withAutomaticReconnect()
                .build();

            connection.start().catch(err => console.error('SignalR error', err));

            connection.on('ReceiveMessage', (senderId, message) => {
                if (senderId === selectedTenantId) {
                    appendMessage(message, false);
                    if (panel.classList.contains('d-none')) {
                        unreadDot?.classList.add('show');
                    }
                    return;
                }

                unreadMap.set(senderId, true);
                updateUnreadIndicators();
            });

            const togglePanel = () => {
                panel.classList.toggle('d-none');
                if (!panel.classList.contains('d-none')) {
                    unreadDot?.classList.remove('show');
                }
            };

            const closePanel = () => {
                panel.classList.add('d-none');
            };

            toggleBtn.addEventListener('click', togglePanel);
            closeBtn?.addEventListener('click', closePanel);

            function updateUnreadIndicators() {
                const items = tenantListEl?.querySelectorAll('[data-user-id]') || [];
                items.forEach(item => {
                    const id = item.getAttribute('data-user-id');
                    if (unreadMap.has(id)) {
                        item.classList.add('ld-unread');
                    } else {
                        item.classList.remove('ld-unread');
                    }
                });
                if (unreadMap.size > 0) {
                    unreadDot?.classList.add('show');
                } else {
                    unreadDot?.classList.remove('show');
                }
            }

            function appendMessage(content, isSender, timestamp = null) {
                const timeLabel = timestamp ? new Date(timestamp) : new Date();
                const msg = document.createElement('div');
                msg.className = `ld-chat-message ${isSender ? 'you' : 'them'}`;
                msg.innerHTML = `${escapeHtml(content)}<span class="ld-chat-time">${timeLabel.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>`;
                messagesEl.appendChild(msg);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }

            function escapeHtml(text) {
                const map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };
                return text.replace(/[&<>"']/g, m => map[m]);
            }

            async function loadTenants() {
                try {
                    const res = await fetch('/ChuTroArea/Chat/GetTenantList');
                    const json = await res.json();
                    if (!json.success) {
                        tenantListEl.innerHTML = `<div class="ld-tenant-empty">${json.message || 'Không tải được danh sách khách thuê.'}</div>`;
                        return;
                    }
                    tenants = (json.data || []).map(t => ({
                        userId: t.userId ?? t.UserId,
                        tenantName: t.tenantName ?? t.TenantName,
                        phone: t.phone ?? t.Phone,
                        roomLabel: t.roomLabel ?? t.RoomLabel
                    }));
                    renderTenantList();
                }
                catch (err) {
                    tenantListEl.innerHTML = '<div class="ld-tenant-empty">Không thể tải danh sách khách thuê.</div>';
                    console.error(err);
                }
            }

            function renderTenantList(filter = '') {
                if (!tenantListEl) return;
                tenantListEl.innerHTML = '';
                const keyword = filter.trim().toLowerCase();
                const filtered = tenants.filter(t =>
                    t.tenantName?.toLowerCase().includes(keyword) ||
                    t.phone?.toLowerCase().includes(keyword) ||
                    t.roomLabel?.toLowerCase().includes(keyword)
                );

                if (filtered.length === 0) {
                    tenantListEl.innerHTML = '<div class="ld-tenant-empty">Không có khách thuê phù hợp.</div>';
                    return;
                }

                filtered.forEach(t => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'ld-tenant-item';
                    btn.setAttribute('data-user-id', t.userId);
                    btn.innerHTML = `<span class="ld-tenant-name">${t.tenantName}</span><span class="ld-tenant-meta">${t.roomLabel} · ${t.phone}</span>`;
                    if (t.userId === selectedTenantId) {
                        btn.classList.add('active');
                    }
                    if (unreadMap.has(t.userId)) {
                        btn.classList.add('ld-unread');
                    }
                    btn.addEventListener('click', () => selectTenant(t.userId));
                    tenantListEl.appendChild(btn);
                });
            }

            searchInput?.addEventListener('input', (e) => {
                renderTenantList(e.target.value);
            });

            async function selectTenant(userId) {
                if (selectedTenantId === userId) return;
                selectedTenantId = userId;
                const tenant = tenants.find(t => t.userId === userId);
                selectedTenantName = tenant ? tenant.tenantName : '';
                messageInput.disabled = false;
                sendBtn.disabled = false;
                messagesEl.innerHTML = '';
                if (messagesEl) {
                    messagesEl.style.display = 'block';
                }
                if (emptyState) {
                    emptyState.style.display = 'none';
                }

                unreadMap.delete(userId);
                updateUnreadIndicators();
                renderTenantList(searchInput?.value || '');
                await loadChatHistory();
            }

            async function loadChatHistory() {
                if (!selectedTenantId) return;
                messagesEl.innerHTML = '<div class="ld-tenant-empty py-3">Đang tải lịch sử...</div>';
                try {
                    const res = await fetch(`/ChuTroArea/Chat/GetChatHistory?userId=${selectedTenantId}`);
                    if (!res.ok) throw new Error('failed');
                    const data = await res.json();
                    messagesEl.innerHTML = '';
                    data.forEach(msg => {
                        const senderId = msg.senderId ?? msg.SenderId;
                        const content = msg.content ?? msg.Content;
                        const timestamp = msg.timestamp ?? msg.Timestamp;
                        const isSender = senderId !== selectedTenantId;
                        appendMessage(content, isSender, timestamp);
                    });
                }
                catch (err) {
                    messagesEl.innerHTML = '<div class="ld-tenant-empty py-3">Không thể tải lịch sử chat.</div>';
                }
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const content = messageInput.value.trim();
                if (!content || !selectedTenantId || connection.state !== 'Connected') {
                    return;
                }
                try {
                    await connection.invoke('SendPrivateMessage', selectedTenantId, content);
                    appendMessage(content, true);
                    messageInput.value = '';
                    messageInput.focus();
                }
                catch (err) {
                    console.error('send failed', err);
                }
            });

            loadTenants();
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>

