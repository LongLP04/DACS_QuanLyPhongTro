@model List<DACS_QuanLyPhongTro.Models.HopDong>
@{
    ViewData["Title"] = "Danh Sách Hợp Đồng";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalContracts = Model?.Count() ?? 0;
    var signedContracts = Model?.Count(h => h.TrangThai == "Đã Xác Nhận") ?? 0;
    var validContracts = Model?.Count(h => h.NgayKetThuc >= DateTime.Now && h.TrangThai == "Đã Xác Nhận") ?? 0;
    var expiredContracts = Model?.Count(h => h.NgayKetThuc < DateTime.Now && h.TrangThai == "Đã Xác Nhận") ?? 0;
    var allContracts = Model?.ToList() ?? new List<DACS_QuanLyPhongTro.Models.HopDong>();
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    .custom-box-tenant {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .custom-box-tenant:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

        .custom-box-tenant .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-box-tenant:hover .icon-wrapper {
            transform: rotate(15deg) scale(1.1);
        }

        .custom-box-tenant h3 {
            font-weight: 800;
            font-size: 1.6rem;
            margin-bottom: 5px;
        }

        .custom-box-tenant p {
            color: #64748b;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-blue) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important;
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .card-title-lg {
        font-weight: 850 !important;
        font-size: 1.3rem !important;
        color: #1a202c;
        margin-bottom: 12px;
    }

    .minimal-icon-box {
        width: 50px;
        height: 50px;
        background: #f8fafc;
        color: #3182ce;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.2rem;
    }

    .count-badge {
        font-size: 0.85rem;
        font-weight: 700;
        color: #4a5568;
        background: #f1f5f9;
        padding: 6px 14px;
        border-radius: 10px;
        margin-right: 8px;
    }

    .contract-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .contract-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .contract-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-red) !important;
    }

    .contract-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-purple) !important;
    }

    .filter-section {
        background: white;
        padding: 20px 30px;
        border-radius: 24px;
        margin-bottom: 35px;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .btn-circle-action {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #edf2f7;
        background: white;
        color: #94a3b8;
        transition: 0.3s;
    }

        .btn-circle-action:hover {
            background: var(--p-blue);
            color: white;
            transform: scale(1.1);
        }
</style>

<div class="container-fluid">
    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert" style="border-radius:15px; border:none;">
            <i class="fas fa-check-circle me-2"></i> @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4 text-left">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Quản lý Hợp Đồng </h2>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-file-contract fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-file-signature"></i></div>
                <h3>@totalContracts</h3>
                <p>Tổng hợp đồng</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-check-circle"></i></div>
                <h3>@validContracts</h3>
                <p>Còn thời hạn</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-red)"><i class="fas fa-exclamation-triangle"></i></div>
                <h3>@expiredContracts</h3>
                <p>Đã hết hạn</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-tenant shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-purple)"><i class="fas fa-calendar-alt"></i></div>
                <h3>@DateTime.Now.ToString("MM/yyyy")</h3>
                <p>Tháng hiện tại</p>
            </div>
        </div>
    </div>

    <div class="filter-section d-flex align-items-center justify-content-between flex-wrap gap-3 mt-2 shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-light shadow-sm" style="border-radius: 12px; height: 50px; font-weight: 700; padding: 0 25px;" data-bs-toggle="modal" data-bs-target="#filterModal">
                <i class="fas fa-filter mr-2 opacity-50"></i> BỘ LỌC
            </button>
        </div>
        <button class="btn btn-dark shadow" style="border-radius: 12px; font-weight: 700; padding: 12px 30px;" onclick="showPasswordModal('create')">
            + TẠO HỢP ĐỒNG MỚI
        </button>
    </div>

    <div class="row mt-4" id="contractsGrid">
        @foreach (var hopDong in Model)
        {
            <div class="col-12 col-md-6 col-xl-4 contract-item mb-5"
                 data-tenant="@hopDong.KhachThue?.HoTen"
                 data-room="@hopDong.PhongTro?.SoPhong"
                 data-status="@hopDong.TrangThai"
                 data-date="@hopDong.NgayBatDau.ToString("yyyy-MM-dd")">
                <div class="card building-card shadow-sm h-100">
                    <div class="card-body text-left">
                        <div class="d-flex align-items-center mb-4">
                            <div class="minimal-icon-box shadow-sm mr-4">
                                <i class="fas fa-file-contract"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h4 class="card-title-lg mb-1">Số: @hopDong.MaHopDong</h4>
                                <span class="text-muted small text-truncate d-block">
                                    <i class="fas fa-door-open mr-1"></i>Phòng @hopDong.PhongTro?.SoPhong
                                </span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="mb-3">
                                <div class="text-muted small fw-bold text-uppercase mb-1">Khách thuê:</div>
                                <div class="fw-bold text-dark fs-5">@(hopDong.KhachThue?.HoTen ?? "N/A")</div>
                            </div>
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="count-badge w-100 m-0"><i class="far fa-calendar-alt mr-1"></i>@hopDong.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6">
                                    <div class="count-badge w-100 m-0 contract-end-date"><i class="far fa-calendar-check mr-1"></i>@hopDong.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-3">
                                <div class="text-success fw-bold">Cọc: @hopDong.TienCoc.ToString("N0") đ</div>
                                @{
                                    var isXacNhan = hopDong.TrangThai == "Đã Xác Nhận";
                                    var statusBg = isXacNhan ? "var(--p-green)" : "var(--p-yellow)";
                                }
                                <span class="badge text-dark px-3 py-2" style="background-color:@statusBg !important; border-radius:10px;">@hopDong.TrangThai</span>
                            </div>
                        </div>

                        <div class="mt-auto pt-4 border-top">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Details" asp-route-id="@hopDong.MaHopDong" class="btn-circle-action" title="Chi tiết" style="background: rgba(59, 130, 246, 0.08); color: #3b82f6; border:none;">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button type="button" class="btn-circle-action text-danger" onclick="showPasswordModal('delete', '@hopDong.MaHopDong')" title="Xóa" style="background: rgba(239, 68, 68, 0.08); border:none;">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="filterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:28px;">
            <div class="modal-header border-0 pt-4 px-4">
                <h5 class="modal-title fw-bold"><i class="fas fa-filter mr-2"></i>LỌC HỢP ĐỒNG</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                <div class="row g-4">
                    <div class="col-12 text-left">
                        <label class="form-label fw-bold small text-muted">CHỌN THÁNG</label>
                        <select id="filterMonth" class="form-select border-0 bg-light" style="border-radius:12px; height:50px;">
                            <option value="0">Tất cả tháng</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">Tháng @i</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 text-left">
                        <label class="form-label fw-bold small text-muted">CHỌN NĂM</label>
                        <select id="filterYear" class="form-select border-0 bg-light" style="border-radius:12px; height:50px;">
                            <option value="0">Tất cả năm</option>
                            @for (int year = DateTime.Now.Year - 2; year <= DateTime.Now.Year + 1; year++)
                            {
                                if (year == DateTime.Now.Year)
                                {
                                    <option value="@year" selected>@year</option>
                                }
                                else
                                {
                                    <option value="@year">@year</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-4">
                <button type="button" class="btn btn-light flex-fill fw-bold" onclick="clearFilter()" style="border-radius:12px; height:50px;">XÓA LỌC</button>
                <button type="button" class="btn btn-primary flex-fill fw-bold" onclick="applyFilter()" style="border-radius:12px; height:50px; background:var(--p-blue); color:#2c5282; border:none;">ÁP DỤNG</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="passwordModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 30px;">
            <div class="modal-header d-flex flex-column align-items-center border-0 pt-5 pb-0">
                <i class="fas fa-shield-alt fa-3x text-warning mb-4"></i>
                <h5 class="modal-title font-weight-bold">XÁC MINH BẢO MẬT</h5>
            </div>
            <div class="modal-body px-5 py-4 text-center">
                <p class="text-muted small mb-4">Nhập mật khẩu chủ trọ để tiếp tục thao tác.</p>
                <input type="password" id="verifyPassword" class="form-control shadow-sm" placeholder="Mật khẩu của bạn..."
                       style="border-radius: 18px; height: 60px; text-align: center; border: 2px solid #edf2f7; font-size: 1.1rem;">
                <div id="passwordError" class="text-danger mt-2 small" style="display:none;"></div>
            </div>
            <div class="modal-footer px-5 border-0 pb-5">
                <button type="button" class="btn btn-primary w-100 fw-bold shadow" onclick="submitPassword()" style="border-radius:12px; height:50px; background:var(--p-blue); color:#2c5282; border:none;">XÁC NHẬN</button>
                <button type="button" class="btn btn-link text-muted mt-2 mx-auto w-100" data-bs-dismiss="modal">Hủy bỏ</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let actionType = null;
        let deleteId = null;

        function showPasswordModal(type, id = null) {
            actionType = type;
            deleteId = id;
            document.getElementById("verifyPassword").value = "";
            document.getElementById("passwordError").style.display = "none";
            new bootstrap.Modal(document.getElementById('passwordModal')).show();
        }

        function submitPassword() {
            const password = document.getElementById("verifyPassword").value;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            fetch("/ChuTroArea/HopDong/VerifyPassword", {
                method: "POST",
                headers: { "Content-Type": "application/json", "RequestVerificationToken": token },
                body: JSON.stringify({ password: password })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (actionType === "create") window.location.href = "/ChuTroArea/HopDong/Create";
                    else if (actionType === "delete" && deleteId) window.location.href = "/ChuTroArea/HopDong/Delete/" + deleteId;
                } else {
                    const err = document.getElementById("passwordError");
                    err.innerText = data.message;
                    err.style.display = "block";
                }
            });
        }

        function applyFilter() {
            const month = document.getElementById('filterMonth').value;
            const year = document.getElementById('filterYear').value;
            const contracts = document.querySelectorAll('.contract-item');
            contracts.forEach(contract => {
                const date = new Date(contract.getAttribute('data-date'));
                let show = true;
                if (month !== '0' && (date.getMonth() + 1) != month) show = false;
                if (year !== '0' && date.getFullYear() != year) show = false;
                contract.style.display = show ? 'block' : 'none';
            });
            bootstrap.Modal.getInstance(document.getElementById('filterModal')).hide();
        }

        function clearFilter() {
            document.getElementById('filterMonth').value = '0';
            document.getElementById('filterYear').value = '0';
            document.querySelectorAll('.contract-item').forEach(c => c.style.display = 'block');
            bootstrap.Modal.getInstance(document.getElementById('filterModal')).hide();
        }
    </script>
}