@model DACS_QuanLyPhongTro.Models.HopDong
@{
    ViewData["Title"] = "Chi Tiết Hợp Đồng";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0"><i class="fas fa-file-contract me-2 text-primary"></i> @ViewData["Title"]</h2>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Quay Lại
            </a>
            
        </div>
    </div>
</div>

<div class="row justify-content-center mt-3">
    <div class="col-12 col-md-10 col-lg-9"> @* Tăng chiều rộng cột lên col-lg-9 *@
        
        <div class="card card-primary card-outline shadow-lg contract-detail-card">
            <div class="card-header border-bottom d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0 fw-bold">Hợp đồng số: @Model.MaHopDong</h4>
                <div>
                    @if (Model.TrangThai == "Đã Xác Nhận")
                    {
                        <span class="badge bg-success text-white px-3 py-2 fs-6"><i class="fas fa-check-circle me-1"></i> Đã Ký</span>
                    }
                    
                    else
                    {
                        <span class="badge bg-danger text-white px-3 py-2 fs-6"><i class="fas fa-times-circle me-1"></i> Đã Hủy</span>
                    }
                </div>
            </div>
            
            <div class="card-body p-4">
                
                <div class="row mb-4">
                    <div class="col-lg-6 border-right pr-4"> 
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-info-circle me-2"></i> Thông tin chung</h5>
                        <dl class="row">
                            <dt class="col-sm-4 text-muted">Mã HĐ:</dt>
                            <dd class="col-sm-8 fw-bold text-dark">@Model.MaHopDong</dd>

                            <dt class="col-sm-4 text-muted">Phòng thuê:</dt>
                            <dd class="col-sm-8"><span class="fw-bold text-success">@Model.PhongTro?.SoPhong</span> (@Model.PhongTro?.ToaNha?.TenToaNha)</dd>

                            <dt class="col-sm-4 text-muted">Khách thuê:</dt>
                            <dd class="col-sm-8"><span class="fw-bold text-info">@Model.KhachThue?.HoTen</span></dd>

                            <dt class="col-sm-4 text-muted">Ngày lập:</dt>
                            <dd class="col-sm-8">@Model.NgayLap.ToString("dd/MM/yyyy")</dd>
                        </dl>
                    </div>

                    <div class="col-lg-6 pl-4"> 
                        <h5 class="fw-bold mb-3 text-primary"><i class="fas fa-calendar-alt me-2"></i> Thời hạn & Tài chính</h5>
                        <dl class="row">
                            <dt class="col-sm-5 text-muted">Ngày bắt đầu:</dt>
                            <dd class="col-sm-7 fw-bold">@Model.NgayBatDau.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-5 text-muted">Ngày kết thúc:</dt>
                            <dd class="col-sm-7 fw-bold text-danger">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</dd>
                            
                            <hr class="mt-2 mb-2">
                            
                            <dt class="col-sm-5 text-muted">Tiền cọc:</dt>
                            <dd class="col-sm-7 fw-bold text-warning">@Model.TienCoc.ToString("N0") VNĐ</dd>
                            
                            <dt class="col-sm-5 text-muted">Giá thuê gốc:</dt>
                            <dd class="col-sm-7 fw-bold text-success">@Model.PhongTro?.GiaThue.ToString("N0") VNĐ</dd>
                        </dl>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <h5 class="fw-bold mb-2 text-primary"><i class="fas fa-pencil-alt me-2"></i> Nội dung Hợp đồng</h5>
                        <div class="border rounded p-3 bg-white" style="min-height:100px; white-space: pre-wrap;">
                            @if (!string.IsNullOrEmpty(Model.NoiDungHopDong))
                            {
                                @Model.NoiDungHopDong
                            }
                            else
                            {
                                <i class="text-muted">Không có nội dung chi tiết.</i>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-light border-top d-flex justify-content-end">
                <a asp-action="ExportPdf" asp-route-id="@Model.MaHopDong" class="btn btn-primary btn-sm" target="_blank">
                <i class="fas fa-print me-1"></i> In hợp đồng
                </a>
                <a asp-action="Delete" asp-route-id="@Model.MaHopDong" class="btn btn-danger btn-sm px-3 py-2 delete-btn">
                    <i class="fas fa-trash me-1"></i> Xóa Hợp đồng
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    /* CSS CŨ ĐƯỢC GIỮ LẠI VÀ CHỈNH SỬA */
    .contract-detail-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 20px;
        background-color: #f8ffff; /* Nền trắng xanh nhạt hơn */
        border: 1px solid #dee2e6;
    }
    .contract-detail-card:hover {
        transform: translateY(-2px); /* Giảm hiệu ứng hover */
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
    }
    .card-header {
        background-color: #f7f9fc !important; /* Header nhẹ nhàng */
    }
    .card-title {
        color: #2c3e50 !important;
    }
    
    /* Tối ưu hóa dl/dt/dd cho bố cục */
    .row dt, .row dd {
        padding-top: 5px;
        padding-bottom: 5px;
    }
    .row dd {
        font-size: 1.05rem; /* Tăng kích thước giá trị */
    }

    /* Đảm bảo nội dung hợp đồng hiển thị tốt */
    .bg-white {
        border-radius: 0.25rem !important;
        white-space: pre-wrap; /* Quan trọng để giữ định dạng dòng */
    }

    /* Nút xóa nổi bật */
    .delete-btn {
        background-color: #dc3545;
        color: white;
        border: none;
        transition: background-color 0.3s;
    }
    .delete-btn:hover {
        background-color: #c82333;
        color: white;
    }
    
    /* Đường phân cách dọc giữa 2 cột thông tin */
    .border-right {
        border-right: 1px solid #e9ecef;
    }
</style>