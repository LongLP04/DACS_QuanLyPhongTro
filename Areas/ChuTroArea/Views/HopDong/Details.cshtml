@model DACS_QuanLyPhongTro.Models.HopDong
@{
    ViewData["Title"] = "Chi Tiết Hợp Đồng";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. Đồng bộ Sidebar & Background */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. Welcome Card Style */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-blue), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(168, 213, 226, 0.3);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. Detail Card - Khung bo tròn viền xanh nhạt */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px; /* Dãn rộng vùng đệm nội dung */
        border: 2px solid var(--p-blue) !important;
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.1);
    }

    .group-title {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 25px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        display: flex;
        align-items: center;
    }

    .info-label {
        font-weight: 700;
        color: #718096;
        font-size: 0.95rem;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
        transition: 0.3s;
        margin-bottom: 20px;
    }

        .info-value-box:hover {
            border-color: var(--p-blue);
            background-color: #ffffff !important;
            transform: translateX(5px);
        }

    /* 4. Nội dung văn bản hợp đồng */
    .contract-content-area {
        background-color: #fdfdfd;
        border-radius: 25px;
        padding: 40px;
        border-left: 8px solid var(--p-blue);
        line-height: 1.8;
        color: #4a5568;
        font-size: 1.05rem;
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.02);
    }

    /* 5. Buttons */
    .btn-action-lg {
        border-radius: 18px;
        font-weight: 800;
        padding: 16px 40px;
        transition: 0.4s;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .btn-back-minimal {
        border-radius: 12px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 10px 25px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }

    .status-pill-lg {
        padding: 10px 25px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9 text-left">
                            <h2 class="welcome-title">Chi tiết Hồ sơ Thuê</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Xem toàn bộ thông báo và thỏa thuận pháp lý cho <strong>Phòng @Model.PhongTro?.SoPhong</strong>
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-file-invoice fa-5x text-white opacity-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-chevron-left mr-2"></i> TRỞ VỀ DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom">
                <div class="card-body p-0">

                    <div class="d-flex justify-content-between align-items-center mb-5 pb-4 border-bottom">
                        <div>
                            <h3 class="fw-bold text-dark mb-1" style="font-weight: 900; font-size: 2.2rem; letter-spacing: -1px;">
                                Hợp đồng #@Model.MaHopDong
                            </h3>
                            <p class="text-muted mb-0 font-weight-500">Khởi tạo vào: @Model.NgayLap.ToString("dd/MM/yyyy")</p>
                        </div>
                        <div>
                            @if (Model.TrangThai == "Đã Xác Nhận")
                            {
                                <span class="badge status-pill-lg" style="background-color: var(--p-green); color: #2d6a4f;">
                                    <i class="fas fa-check-circle mr-2"></i> ĐÃ XÁC NHẬN
                                </span>
                            }
                            else
                            {
                                <span class="badge status-pill-lg" style="background-color: var(--p-red); color: #742a2a;">
                                    <i class="fas fa-clock mr-2"></i> CHỜ XỬ LÝ
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row g-5">
                        <div class="col-lg-6">
                            <h5 class="group-title text-primary">
                                <i class="fas fa-id-card-alt mr-3 opacity-50"></i> Đối tượng & Địa điểm
                            </h5>

                            <label class="info-label">Khách hàng thuê</label>
                            <div class="info-value-box">
                                <i class="fas fa-user-circle text-primary mr-3"></i> @Model.KhachThue?.HoTen
                            </div>

                            <label class="info-label">Phòng trọ / Căn hộ</label>
                            <div class="info-value-box">
                                <i class="fas fa-door-open text-success mr-3"></i>
                                <span class="fw-bold">@Model.PhongTro?.SoPhong</span>
                                <span class="mx-2 opacity-25">|</span>
                                <small>@Model.PhongTro?.ToaNha?.TenToaNha</small>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <h5 class="group-title text-success">
                                <i class="fas fa-wallet mr-3 opacity-50"></i> Thời hạn & Tài chính
                            </h5>

                            <div class="row">
                                <div class="col-6 pr-2">
                                    <label class="info-label">Ngày bắt đầu</label>
                                    <div class="info-value-box">@Model.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-6 pl-2">
                                    <label class="info-label">Ngày kết thúc</label>
                                    <div class="info-value-box text-danger">@Model.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-6 pr-2">
                                    <label class="info-label">Tiền đặt cọc</label>
                                    <div class="info-value-box text-warning font-weight-bold">
                                        @Model.TienCoc.ToString("N0") <small class="ml-1">VND</small>
                                    </div>
                                </div>
                                <div class="col-6 pl-2">
                                    <label class="info-label">Giá thuê gốc</label>
                                    <div class="info-value-box text-success font-weight-bold">
                                        @Model.PhongTro?.GiaThue.ToString("N0") <small class="ml-1">VND</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 mt-4">
                            <h5 class="group-title text-purple">
                                <i class="fas fa-file-alt mr-3 opacity-50"></i> Nội dung văn bản thỏa thuận
                            </h5>
                            <div class="contract-content-area shadow-sm">
                                @if (!string.IsNullOrEmpty(Model.NoiDungHopDong))
                                {
                                    @Model.NoiDungHopDong
                                }
                                else
                                {
                                    <span class="text-muted italic"><i class="fas fa-info-circle mr-2"></i> Chưa có nội dung chi tiết cho hợp đồng này.</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-5 border-top">
                        <div class="d-flex flex-wrap justify-content-end align-items-center">

                            <a asp-action="ExportPdf" asp-route-id="@Model.MaHopDong"
                               class="btn btn-action-lg shadow-sm mr-4 mb-3"
                               target="_blank"
                               style="background: var(--p-blue); color: #2c5282; border: none; min-width: 240px; display: inline-flex; align-items: center; justify-content: center; height: 60px;">
                                <i class="fas fa-print mr-2"></i> XUẤT FILE PDF
                            </a>

                            <a asp-action="Delete" asp-route-id="@Model.MaHopDong"
                               class="btn btn-action-lg shadow-sm mb-3"
                               style="background: var(--p-red); color: #742a2a; border: none; min-width: 240px; display: inline-flex; align-items: center; justify-content: center; height: 60px;">
                                <i class="fas fa-trash-alt mr-2"></i> HỦY HỢP ĐỒNG
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>