@model DACS_QuanLyPhongTro.Models.HopDong
@{
    ViewData["Title"] = "Xóa Hợp Đồng";
    Layout = "~/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD (DANGER STYLE) */
    .welcome-card-danger {
        background: linear-gradient(135deg, var(--p-red), #ff9a9e) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
        margin-bottom: 40px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.2rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.1);
        margin-bottom: 5px;
    }

    /* 3. CARD CUSTOM & LAYOUT */
    .card-custom {
        background: var(--surface);
        border-radius: 35px !important;
        padding: 50px;
        border: 2px solid var(--p-red) !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
    }

    .info-label {
        font-weight: 800;
        color: #64748b;
        margin-bottom: 12px;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
    }

    .info-value-box {
        background-color: #fbfcfe !important;
        border: 1.5px solid #edf2f7 !important;
        border-radius: 18px !important;
        padding: 15px 25px !important;
        color: var(--text-dark);
        font-weight: 600;
        display: flex;
        align-items: center;
        min-height: 60px;
    }

    .form-control-custom {
        border-radius: 18px !important;
        border: 1.5px solid #edf2f7 !important;
        padding: 18px 25px !important;
        height: auto;
        background-color: #fbfcfe;
        font-size: 1rem;
        transition: 0.3s;
    }

        .form-control-custom:focus {
            border-color: var(--p-red) !important;
            box-shadow: 0 0 0 5px rgba(255, 183, 178, 0.25) !important;
            background-color: #fff;
            outline: none;
        }

    /* 4. BUTTONS */
    .btn-delete-main {
        background: var(--p-red);
        color: #742a2a;
        border-radius: 18px;
        font-weight: 800;
        padding: 18px 60px;
        border: none;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-delete-main:hover:not(:disabled) {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(255, 183, 178, 0.4);
            background: #ff9a9e;
        }

        .btn-delete-main:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-custom-cancel {
        background: white;
        color: #64748b;
        border-radius: 18px;
        font-weight: 700;
        padding: 18px 60px;
        border: 2.5px solid #edf2f7;
        transition: 0.3s;
    }

        .btn-custom-cancel:hover {
            background: #f8fafc;
            border-color: var(--p-blue);
        }

    .btn-back-minimal {
        border-radius: 15px;
        font-weight: 700;
        color: #64748b;
        background: white;
        border: 1.5px solid #edf2f7;
        padding: 12px 30px;
        transition: 0.3s;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
    }

    .row.g-info-item {
        --bs-gutter-y: 2.5rem;
    }
</style>

<div class="container-fluid text-left">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm mb-4" style="border-radius: 20px; border: none;">
            <i class="fas fa-exclamation-circle mr-2 pl-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card welcome-card-danger shadow-sm">
                <div class="card-body p-5">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Hủy bỏ hợp đồng</h2>
                            <p class="mb-0 text-white opacity-90" style="font-size: 1.1rem;">
                                Bạn đang thực hiện thao tác xóa <strong>Hợp đồng số #@Model.MaHopDong</strong>
                            </p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-file-excel fa-5x text-white opacity-20"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-back-minimal shadow-sm">
        <i class="fas fa-arrow-left mr-2"></i> QUAY LẠI DANH SÁCH
    </a>

    <div class="row justify-content-center">
        <div class="col-12 pb-5">
            <div class="card card-custom shadow-sm">
                <div class="card-body p-0">
                    <div class="alert alert-warning d-flex align-items-center mb-5 p-4" style="border-radius: 20px; border: none; background: #fff5f5;">
                        <i class="fas fa-exclamation-triangle fa-2x mr-4 text-danger"></i>
                        <div class="text-danger fw-bold">
                            CẢNH BÁO: Hành động này không thể hoàn tác. Mọi dữ liệu về lịch sử hợp đồng này sẽ bị xóa vĩnh viễn.
                        </div>
                    </div>

                    <div class="row g-info-item mb-5">
                        <div class="col-md-6">
                            <label class="info-label text-primary">Mã số hồ sơ</label>
                            <div class="info-value-box">
                                <i class="fas fa-hashtag text-primary mr-3"></i> @Model.MaHopDong
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-success">Khách hàng</label>
                            <div class="info-value-box">
                                <i class="fas fa-user-tag text-success mr-3"></i> @Model.KhachThue?.HoTen
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-warning">Phòng thuê</label>
                            <div class="info-value-box">
                                <i class="fas fa-door-open text-warning mr-3"></i> Phòng @Model.PhongTro?.SoPhong
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="info-label text-info">Ngày lập hợp đồng</label>
                            <div class="info-value-box">
                                <i class="fas fa-calendar-check text-info mr-3"></i> @Model.NgayLap.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="info-label text-secondary">Thời gian hiệu lực</label>
                            <div class="info-value-box">
                                <i class="fas fa-clock text-secondary mr-3"></i>
                                Từ @Model.NgayBatDau.ToString("dd/MM/yyyy") đến @Model.NgayKetThuc.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaHopDong" />

                        <div class="col-md-8 mx-auto">
                            <label class="form-label text-center d-block mb-3">Xác thực chủ trọ để xóa</label>
                            <input type="password" class="form-control form-control-custom text-center"
                                   id="confirmPassword" name="confirmPassword"
                                   placeholder="Nhập mật khẩu xác nhận" required />
                            <div class="text-danger mt-2 text-center" id="passwordError" style="display: none;">
                                Mật khẩu không đúng. Vui lòng thử lại.
                            </div>
                        </div>

                        <div class="text-center mt-5 pt-4">
                            <button type="button" class="btn btn-delete-main shadow-sm mr-4" id="deleteBtn" disabled>
                                <i class="fas fa-trash-alt mr-2"></i> XÓA HỢP ĐỒNG
                            </button>
                            <a asp-action="Index" class="btn btn-custom-cancel shadow-sm">
                                HỦY BỎ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // LOGIC GIỮ NGUYÊN HOÀN TOÀN
        document.addEventListener('DOMContentLoaded', function() {
            const passwordInput = document.getElementById('confirmPassword');
            const deleteBtn = document.getElementById('deleteBtn');
            const deleteForm = document.getElementById('deleteForm');
            const passwordError = document.getElementById('passwordError');

            passwordInput.addEventListener('input', function() {
                deleteBtn.disabled = this.value.length <= 0;
                passwordError.style.display = 'none';
            });

            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                if (!passwordInput.value) {
                    passwordInput.focus();
                    return;
                }

                if (confirm('Bạn có chắc chắn muốn xóa hợp đồng này? Hành động này không thể hoàn tác!')) {
                    deleteForm.submit();
                }
            });
        });
    </script>
}