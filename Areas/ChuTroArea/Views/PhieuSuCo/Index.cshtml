@model List<DACS_QuanLyPhongTro.Models.PhieuGhiNhanSuCo>
@{
    ViewData["Title"] = "Danh Sách Phiếu Sự Cố";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
    
    var totalRecords = Model?.Count() ?? 0;
    var pendingRecords = Model?.Count(p => p.TinhTrang == "Chưa xử lý") ?? 0;
    var processingRecords = Model?.Count(p => p.TinhTrang == "Đã tiếp nhận") ?? 0;
    var completedRecords = Model?.Count(p => p.TinhTrang == "Đã xử lý") ?? 0;
}

<div class="content-header px-2 px-md-3 pt-1 pb-0">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="h4 mb-0">@ViewData["Title"]</h2>
    </div>
</div>

<!-- Summary widgets -->
<div class="row px-2 px-md-3 mt-3 g-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-primary mb-0">
            <div class="inner">
                <h3>@totalRecords</h3>
                <p>Tổng phiếu sự cố</p>
            </div>
            <div class="icon"><i class="fas fa-exclamation-triangle"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-danger mb-0">
            <div class="inner">
                <h3>@pendingRecords</h3>
                <p>Chưa xử lý</p>
            </div>
            <div class="icon"><i class="fas fa-times-circle"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-warning mb-0">
            <div class="inner">
                <h3>@processingRecords</h3>
                <p>Đã tiếp nhận</p>
            </div>
            <div class="icon"><i class="fas fa-clock"></i></div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="small-box bg-gradient-success mb-0">
            <div class="inner">
                <h3>@completedRecords</h3>
                <p>Đã xử lý</p>
            </div>
            <div class="icon"><i class="fas fa-check-circle"></i></div>
        </div>
    </div>
    <div class="col-12"><hr class="my-2"></div>
</div>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" id="thongBao" role="alert">
        @TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.CoPhieuChuaXuLy == true)
{
    <div class="alert alert-warning mt-3">
        Có phiếu sự cố chưa xử lý. Vui lòng kiểm tra và xác nhận!
    </div>
}
@if (Model.Count == 0)
{
    <div class="alert alert-info mt-3">Không có phiếu sự cố nào.</div>
}
else
{
    <div class="row px-2 px-md-3 g-3 mt-3" id="phieusucoGrid">
        @foreach (var phieu in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3 phieusuco-item">
                <div class="card shadow-sm border-0 h-100 phieusuco-card d-flex flex-column">
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <div class="room-indicator">
                                <div class="room-icon bg-danger text-white rounded-circle d-flex align-items-center justify-content-center" style="width:35px;height:35px;">
                                    <i class="fas fa-exclamation "></i>
                                </div>
                                <span class="room-name ms-2 fw-bold text-dark fs-6">Mã phiếu: @phieu.MaPhieuSuCo</span>
                            </div>
                            <div>
                                @if (phieu.TinhTrang == "Đã xử lý")
                                {
                                    <span class="badge bg-success-soft text-success rounded-pill px-2 py-1 small border border-success"><i class="fas fa-check me-1"></i>Xong</span>
                                }
                                else if (phieu.TinhTrang == "Đã tiếp nhận")
                                {
                                    <span class="badge bg-warning-soft text-dark rounded-pill px-2 py-1 small border border-warning"><i class="fas fa-clock me-1"></i>Tiếp nhận</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-soft text-danger rounded-pill px-2 py-1 small border border-danger"><i class="fas fa-bolt me-1"></i>Cần xử lý</span>
                                }
                            </div>
                        </div>

                        <div class="info-block-tenant p-2 rounded mb-3 bg-light d-flex align-items-center">
                            
                            <div>
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Khách báo</div>
                                <div class="fw-bold small">@phieu.KhachThue?.HoTen</div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border-start border-primary border-4 h-100">
                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;"><i class="fas fa-door-open me-1"></i>Phòng</div>
                                    <div class="fw-bold small">P.@(phieu.KhachThue?.PhongTros != null && phieu.KhachThue.PhongTros.Any() ? phieu.KhachThue.PhongTros.First().SoPhong : "N/A")</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-light border-start border-info border-4 h-100">
                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;"><i class="far fa-calendar-alt me-1"></i>Ngày báo</div>
                                    <div class="fw-bold small">@phieu.NgayGhiNhan.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="p-2 rounded bg-light mb-3">
                            <div class="mb-2">
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Mô tả sự cố</div>
                                <div class="small">@phieu.MoTaSuCo</div>
                            </div>
                            <div>
                                <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Hiện trạng</div>
                                <div class="small fw-semibold text-danger">@phieu.HienTrang</div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(phieu.GhiChu))
                        {
                            <div class="p-2 rounded bg-light mb-3">
                                <div class="small font-italic text-muted"><i class="fas fa-comment-dots me-1"></i>@phieu.GhiChu</div>
                            </div>
                        }

                        <div class="mt-auto p-2 rounded bg-light bg-opacity-10 text-center border border-primary border-opacity-25 mb-2">
                            <div class="text-dark small fw-bold text-uppercase" style="font-size: 0.65rem; opacity: 0.8;">Tình trạng xử lý</div>
                            <div class="fw-bold text-primary">@phieu.TinhTrang</div>
                        </div>

                        @if (phieu.TinhTrang == "Chưa xử lý" || phieu.TinhTrang == "Đã tiếp nhận")
                        {
                            <div class="p-2 rounded bg-white border shadow-sm">
                                <form asp-action="XacNhan" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="id" value="@phieu.MaPhieuSuCo" />
                                    <select name="tinhTrang" class="form-select form-select-sm" required>
                                        <option value="">Cập nhật...</option>
                                        @if (phieu.TinhTrang == "Chưa xử lý")
                                        {
                                            <option value="Đã tiếp nhận">Đã tiếp nhận</option>
                                        }
                                        <option value="Đã xử lý">Đã xử lý</option>
                                    </select>
                                    <button type="submit" class="btn btn-primary btn-sm px-3 rounded-pill">OK</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var thongBao = document.getElementById("thongBao");
            if (thongBao) {
                setTimeout(function () {
                    thongBao.style.transition = "opacity 0.5s ease-out";
                    thongBao.style.opacity = "0";
                    setTimeout(function () {
                        thongBao.style.display = "none";
                    }, 500);
                }, 5000);
            }
        });
    </script>
}
<style>
    .phieusuco-card {
        transition: transform .15s ease, box-shadow .15s ease;
        margin-bottom: 0;
        background-color: #f0f8ff;
    }
    .phieusuco-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
    }
    .avatar {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
    }
    .phieusuco-card .card-title {
        font-size: 1.15rem;
        line-height: 1.3;
        color: #2c3e50;
    }
    .phieusuco-card .badge {
        font-size: 0.875rem;
        font-weight: 500;
        background-color: rgba(255, 255, 255, 0.8) ;
        backdrop-filter: blur(10px);
    }
    .phieusuco-carrd .badge-tinhtrang{
        background-color: rgba(81, 199, 26, 0.8) !important;
        backdrop-filter: blur(10px);
    }
    .phieusuco-card .btn {
        font-size: 0.875rem;
        font-weight: 500;
    }
    .phieusuco-card .card-body > * + * {
        margin-top: 1rem;
    }
    .phieusuco-item {
        margin-bottom: 1rem;
    }
    .phieusuco-item:nth-last-child(-n+4) {
        margin-bottom: 0;
    }
    .phieusuco-item:nth-child(4n+1) .phieusuco-card {
        background-color: #e3ffff;
    }
    .phieusuco-item:nth-child(4n+2) .phieusuco-card {
        background-color: #fff9f0;
    }
    .phieusuco-item:nth-child(4n+3) .phieusuco-card {
        background-color: #f0fff4;
    }
    .phieusuco-item:nth-child(4n+4) .phieusuco-card {
        background-color: #fff0f5;
    }
    .phieusuco-card .card-title,
    .phieusuco-card .text-muted,
    .phieusuco-card .text-secondary {
        color: #2c3e50 !important;
    }
    h5 {
        display: block;
    }

    .phieusuco-card .badge,
    .phieusuco-card .card-body,
    .phieusuco-card .card-title,
    .phieusuco-card .text-muted,
    .phieusuco-card .text-secondary,
    .phieusuco-card .form-select,
    .phieusuco-card .btn {
        word-break: break-word;
        white-space: normal !important;
        overflow-wrap: break-word;
    }
</style>
