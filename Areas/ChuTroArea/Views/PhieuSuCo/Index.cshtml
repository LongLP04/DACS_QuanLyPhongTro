@model List<DACS_QuanLyPhongTro.Models.PhieuGhiNhanSuCo>
@{
    ViewData["Title"] = "Danh Sách Phiếu Sự Cố";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";

    var totalRecords = Model?.Count() ?? 0;
    var pendingRecords = Model?.Count(p => p.TinhTrang == "Chưa xử lý") ?? 0;
    var processingRecords = Model?.Count(p => p.TinhTrang == "Đã tiếp nhận") ?? 0;
    var completedRecords = Model?.Count(p => p.TinhTrang == "Đã xử lý") ?? 0;
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. WELCOME CARD */
    .welcome-card {
        background: linear-gradient(135deg, var(--p-red), var(--p-purple)) !important;
        border: none !important;
        border-radius: 20px !important;
        box-shadow: 0 10px 20px rgba(255, 183, 178, 0.3);
        margin-bottom: 24px;
    }

    .welcome-title {
        font-family: "Pacifico", cursive !important;
        font-size: 2.5rem;
        color: #ffffff;
        text-shadow: 2px 3px 6px rgba(0,0,0,0.15);
    }

    /* 3. STATS CARDS - ĐỒNG BỘ TRANG LỊCH HẸN */
    .custom-box-stats {
        background: var(--surface);
        border-radius: 20px !important;
        padding: 30px 20px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        border: 1px solid rgba(168, 213, 226, 0.2);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

        .custom-box-stats:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(168, 213, 226, 0.4);
        }

        .custom-box-stats .icon-wrapper {
            width: 70px;
            height: 70px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-bottom: 15px;
            color: white;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .custom-box-stats:hover .icon-wrapper {
            transform: rotate(15deg) scale(1.1);
        }

    /* 4. PHIẾU CARDS - DÃN RỘNG NỘI DUNG */
    .building-card {
        border-radius: 28px !important;
        background: #ffffff;
        border: 1px solid #f1f5f9 !important;
        transition: all 0.4s ease;
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

        .building-card:hover {
            transform: translateY(-12px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06) !important;
            border-color: var(--p-red) !important;
        }

        .building-card .card-body {
            padding: 2.2rem !important;
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
        }

    .minimal-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: #fff5f5;
        color: #e53e3e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        transition: 0.4s;
    }

    .building-card:hover .minimal-icon-box {
        transform: rotate(15deg);
    }

    /* Phân loại màu viền pastel */
    .phieusuco-item:nth-child(4n+1) .building-card {
        border-top: 8px solid var(--p-blue) !important;
    }

    .phieusuco-item:nth-child(4n+2) .building-card {
        border-top: 8px solid var(--p-yellow) !important;
    }

    .phieusuco-item:nth-child(4n+3) .building-card {
        border-top: 8px solid var(--p-green) !important;
    }

    .phieusuco-item:nth-child(4n+4) .building-card {
        border-top: 8px solid var(--p-red) !important;
    }

    .issue-content-box {
        background: #f8fafc;
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 20px;
        border: 1px solid #edf2f7;
    }

    .status-update-box {
        background: white;
        border-radius: 15px;
        padding: 10px;
        border: 1.5px solid var(--p-blue);
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card welcome-card shadow-sm">
                <div class="card-body p-4 text-left">
                    <div class="row align-items-center">
                        <div class="col-md-9">
                            <h2 class="welcome-title">Quản Lý Sự Cố </h2>
                            <p class="text-white opacity-90 mb-0">Theo dõi và xử lý các yêu cầu sửa chữa từ khách thuê.</p>
                        </div>
                        <div class="col-md-3 text-right d-none d-md-block">
                            <i class="fas fa-tools fa-4x text-white opacity-25"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-blue)"><i class="fas fa-exclamation-triangle"></i></div>
                <h3>@totalRecords</h3>
                <p>Tổng phiếu</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-red)"><i class="fas fa-times-circle"></i></div>
                <h3>@pendingRecords</h3>
                <p>Chưa xử lý</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-yellow); color:#856404"><i class="fas fa-clock"></i></div>
                <h3>@processingRecords</h3>
                <p>Đã tiếp nhận</p>
            </div>
        </div>
        <div class="col-lg-3 col-6">
            <div class="custom-box-stats shadow-sm">
                <div class="icon-wrapper" style="background:var(--p-green)"><i class="fas fa-check-circle"></i></div>
                <h3>@completedRecords</h3>
                <p>Đã xử lý</p>
            </div>
        </div>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" id="thongBao" style="border-radius:15px; border:none;">
            <i class="fas fa-check-circle mr-2"></i> @TempData["ThongBao"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.CoPhieuChuaXuLy == true)
    {
        <div class="alert alert-warning shadow-sm d-flex align-items-center" style="border-radius:15px; border:none; background: var(--p-yellow)">
            <i class="fas fa-bell mr-3 fa-lg"></i>
            <span class="fw-bold text-dark">Có phiếu sự cố chưa xử lý. Vui lòng kiểm tra và xác nhận!</span>
        </div>
    }

    <div class="row g-4 mt-2" id="phieusucoGrid">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <div class="card p-5 border-0 shadow-sm" style="border-radius:30px;">
                    <i class="fas fa-coffee fa-4x text-muted opacity-25 mb-3"></i>
                    <h4 class="text-muted">Không có phiếu sự cố nào cần xử lý.</h4>
                </div>
            </div>
        }
        else
        {
            @foreach (var phieu in Model)
            {
                <div class="col-12 col-md-6 col-xl-4 phieusuco-item mb-5">
                    <div class="card building-card shadow-sm">
                        <div class="card-body text-left">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="minimal-icon-box shadow-sm mr-3">
                                    <i class="fas fa-wrench"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h4 class="card-title-lg mb-0">HĐ #@phieu.MaPhieuSuCo</h4>
                                    <span class="text-muted small fw-bold">P.@(phieu.KhachThue?.PhongTros?.FirstOrDefault()?.SoPhong ?? "N/A")</span>
                                </div>
                                @if (phieu.TinhTrang == "Đã xử lý")
                                {
                                    <span class="badge px-3 py-2" style="background: var(--p-green); color: #2d6a4f; border-radius: 10px;">XONG</span>
                                }
                                else if (phieu.TinhTrang == "Đã tiếp nhận")
                                {
                                    <span class="badge px-3 py-2" style="background: var(--p-yellow); color: #856404; border-radius: 10px;">ĐANG LÀM</span>
                                }
                                else
                                {
                                    <span class="badge px-3 py-2" style="background: var(--p-red); color: #742a2a; border-radius: 10px;">MỚI</span>
                                }
                            </div>

                            <div class="info-block-tenant p-2 rounded mb-3 bg-light d-flex align-items-center">
                                <div>
                                    <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Khách báo & Ngày nhận</div>
                                    <div class="fw-bold small text-dark">@(phieu.KhachThue?.HoTen) | @phieu.NgayGhiNhan.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="issue-content-box flex-grow-1 shadow-xs">
                                <p class="small fw-bold text-muted mb-1 text-uppercase">Nội dung sự cố:</p>
                                <div class="text-dark mb-3" style="font-size: 0.95rem;">@phieu.MoTaSuCo</div>
                                <p class="small fw-bold text-muted mb-1 text-uppercase">Hiện trạng:</p>
                                <div class="text-danger fw-bold">@phieu.HienTrang</div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(phieu.GhiChu))
                            {
                                <div class="small text-muted italic mb-4 px-2">
                                    <i class="fas fa-comment-dots mr-2"></i>@phieu.GhiChu
                                </div>
                            }

                            <div class="mt-auto pt-4 border-top">
                                @if (phieu.TinhTrang != "Đã xử lý")
                                {
                                    <form asp-action="XacNhan" method="post" class="status-update-box d-flex gap-2 shadow-sm">
                                        <input type="hidden" name="id" value="@phieu.MaPhieuSuCo" />
                                        <select name="tinhTrang" class="form-select border-0 bg-transparent fw-bold" style="font-size: 0.85rem;" required>
                                            <option value="">Cập nhật trạng thái...</option>
                                            @if (phieu.TinhTrang == "Chưa xử lý")
                                            {
                                                <option value="Đã tiếp nhận">Đã tiếp nhận</option>
                                            }
                                            <option value="Đã xử lý">Đã xử lý</option>
                                        </select>
                                        <button type="submit" class="btn btn-dark rounded-pill px-4 btn-sm fw-bold">LƯU</button>
                                    </form>
                                }
                                else
                                {
                                    <div class="text-center py-2 bg-light rounded-pill border">
                                        <span class="text-success fw-bold small"><i class="fas fa-check-double mr-2"></i>ĐÃ HOÀN THÀNH XỬ LÝ</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var thongBao = document.getElementById("thongBao");
            if (thongBao) {
                setTimeout(function () {
                    thongBao.style.transition = "opacity 0.8s ease-out";
                    thongBao.style.opacity = "0";
                    setTimeout(() => thongBao.style.display = "none", 800);
                }, 4000);
            }
        });
    </script>
}