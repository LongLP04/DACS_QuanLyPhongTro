@model IEnumerable<DACS_QuanLyPhongTro.Models.KhachThue>

@{
    ViewData["Title"] = "Chat với khách thuê";
    Layout = "/Areas/ChuTroArea/Views/Shared/layoutAdminLTE.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Pacifico&display=swap" rel="stylesheet">

<style>
    :root {
        --p-blue: #a8d5e2;
        --p-green: #c1e1c1;
        --p-yellow: #fdfd96;
        --p-red: #ffb7b2;
        --p-purple: #c7ceea;
        --text-dark: #2d3748;
        --surface: #ffffff;
    }

    /* 1. ĐỒNG BỘ SIDEBAR & BACKGROUND */
    .content-wrapper {
        margin-left: 255px !important;
        padding-top: 25px;
        background-color: #f8faff !important;
        font-family: "Montserrat", sans-serif !important;
    }

    /* 2. CHAT CONTAINER LAYOUT */
    .chat-main-card {
        border-radius: 30px !important;
        border: none !important;
        overflow: hidden;
        background: var(--surface);
        box-shadow: 0 15px 35px rgba(168, 213, 226, 0.2) !important;
        height: 750px;
    }

    /* 3. USER LIST COLUMN */
    #userListWrapper {
        background: #fbfcfe;
        border-right: 2px solid #f1f5f9;
        display: flex;
        flex-direction: column;
    }

    .search-box-container {
        padding: 25px;
        background: white;
    }

    #searchTenant {
        border-radius: 15px;
        border: 1.5px solid #edf2f7;
        padding: 12px 20px;
        background-color: #f8faff;
        font-weight: 500;
    }

    .tenant-item {
        border: none !important;
        margin: 8px 15px;
        border-radius: 20px !important;
        transition: all 0.3s ease;
        padding: 15px 20px !important;
        background: transparent;
    }

        .tenant-item:hover {
            background: rgba(168, 213, 226, 0.2) !important;
            transform: translateX(5px);
        }

        .tenant-item.active {
            background: var(--p-blue) !important;
            color: #2c5282 !important;
            box-shadow: 0 8px 15px rgba(168, 213, 226, 0.4);
        }

    .status-dot {
        width: 10px;
        height: 10px;
        border: 2px solid white;
        box-shadow: 0 0 5px rgba(0,0,0,0.1);
    }

    /* 4. CHAT WINDOW COLUMN */
    .chat-header {
        background: white !important;
        padding: 20px 30px;
        border-bottom: 2px solid #f1f5f9;
    }

    #chatWith {
        font-weight: 800;
        color: var(--text-dark);
        font-size: 1.1rem;
    }

    .chat-body-custom {
        flex-grow: 1;
        background: #fdfeff;
        background-image: radial-gradient(#e2e8f0 0.5px, transparent 0.5px);
        background-size: 20px 20px;
        padding: 30px;
        overflow-y: auto;
    }

    /* 5. MESSAGE BUBBLES */
    .chat-line {
        margin-bottom: 20px;
        display: flex;
        width: 100%;
    }

        .chat-line.right {
            justify-content: flex-end;
        }

        .chat-line.left {
            justify-content: flex-start;
        }

    .message {
        max-width: 65%;
        padding: 14px 20px;
        border-radius: 22px;
        font-weight: 500;
        position: relative;
        box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    }

        .message.you {
            background: var(--p-blue);
            color: #2c5282;
            border-bottom-right-radius: 5px;
        }

        .message.them {
            background: white;
            color: var(--text-dark);
            border-bottom-left-radius: 5px;
            border: 1.5px solid #f1f5f9;
        }

    .msg-time {
        font-size: 0.65rem;
        margin-top: 5px;
        display: block;
        opacity: 0.6;
        font-weight: 700;
    }

    /* 6. INPUT AREA */
    .chat-footer {
        padding: 25px 30px;
        background: white;
        border-top: 2px solid #f1f5f9;
    }

    #messageInput {
        border-radius: 20px;
        border: 2px solid #f1f5f9;
        padding: 15px 25px;
        background: #f8faff;
        transition: all 0.3s ease;
    }

        #messageInput:focus {
            border-color: var(--p-blue);
            background: white;
            box-shadow: none;
        }

    .btn-send-pastel {
        width: 55px;
        height: 55px;
        border-radius: 18px !important;
        background: var(--p-blue);
        color: #2c5282;
        border: none;
        transition: all 0.3s ease;
    }

        .btn-send-pastel:hover:not(:disabled) {
            transform: scale(1.1) rotate(-10deg);
            background: #94c8db;
        }

    /* Hiệu ứng xoay icon header chat */
    .avatar-header {
        width: 45px;
        height: 45px;
        background: var(--p-purple);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        margin-right: 15px;
        transition: transform 0.4s ease;
    }

    .chat-header:hover .avatar-header {
        transform: rotate(15deg);
    }
</style>

<div class="content px-2 px-md-4">
    <div class="card chat-main-card shadow-sm">
        <div class="row g-0 h-100">

            <div class="col-md-4 h-100 d-flex flex-column" id="userListWrapper">
                <div class="search-box-container border-bottom">
                    <h5 class="fw-bold mb-3" style="color: var(--text-dark)">Tin nhắn 💬</h5>
                    <input type="text" id="searchTenant" class="form-control" placeholder="Tìm tên khách thuê..." />
                </div>

                <div class="list-group list-group-flush flex-grow-1" id="userList" style="overflow-y:auto;">
                    @foreach (var user in Model)
                    {
                        <button type="button" class="list-group-item tenant-item d-flex align-items-center"
                                data-userid="@user.ApplicationUserId"
                                data-hotenkhach="@user.HoTen">
                            <div class="position-relative mr-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-light" style="width:50px; height:50px;">
                                    <i class="fas fa-user text-muted"></i>
                                </div>
                                <span class="badge bg-success rounded-circle position-absolute status-dot" style="bottom: 2px; right: 2px;"></span>
                            </div>
                            <div class="flex-grow-1 text-left">
                                <div class="fw-bold" style="font-size: 0.95rem;">@user.HoTen</div>
                                <small class="text-muted">@user.SoDienThoai</small>
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div class="col-md-8 h-100 d-flex flex-column" id="chatColumn">
                <div class="chat-header d-flex align-items-center">
                    <div class="avatar-header shadow-sm">
                        <i class="fas fa-comment-alt"></i>
                    </div>
                    <span id="chatWith">Chọn một cuộc trò chuyện để bắt đầu</span>
                </div>

                <div class="chat-body-custom d-flex flex-column" id="chatMessages">
                    <div class="text-center text-muted m-auto p-4 animate__animated animate__fadeIn">
                        <div class="mb-4">
                            <i class="fas fa-paper-plane fa-4x opacity-20"></i>
                        </div>
                        <h5 class="fw-bold">Hệ thống liên lạc nội bộ</h5>
                        <p class="small">Vui lòng chọn khách thuê từ danh sách bên trái để gửi tin nhắn hỗ trợ.</p>
                    </div>
                </div>

                <div class="chat-footer">
                    <form id="chatForm" class="d-flex align-items-center gap-3">
                        <input type="text" id="messageInput" class="form-control form-control-lg"
                               placeholder="Viết lời nhắn gửi đến khách thuê..." autocomplete="off" disabled />
                        <button type="submit" class="btn btn-send-pastel shadow-sm" disabled id="sendBtn">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        // GIỮ NGUYÊN TOÀN BỘ LOGIC CỦA BẠN
        let connection = new signalR.HubConnectionBuilder().withUrl("/chathub").build();
        let selectedUserId = null;
        let selectedUserName = "";
        const userList = document.getElementById('userList');
        const chatWith = document.getElementById('chatWith');
        const chatMessages = document.getElementById('chatMessages');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');

        connection.start().then(() => {
            console.log("✅ Đã kết nối SignalR");
        }).catch(err => console.error(err.toString()));

        function appendMessage(message, isSender, timestamp) {
            const time = timestamp ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const divLine = document.createElement('div');
            divLine.className = `chat-line ${isSender ? 'right' : 'left'}`;

            const bubble = document.createElement('div');
            bubble.className = `message ${isSender ? 'you animate__animated animate__fadeInRight' : 'them animate__animated animate__fadeInLeft'}`;

            const content = document.createElement('span');
            content.innerHTML = message;

            const timeSpan = document.createElement('small');
            timeSpan.className = 'msg-time';
            timeSpan.textContent = time;

            bubble.appendChild(content);
            bubble.appendChild(timeSpan);
            divLine.appendChild(bubble);

            chatMessages.appendChild(divLine);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        connection.on("ReceiveMessage", function (senderId, message) {
            if (senderId === selectedUserId) {
                appendMessage(message, false);
            }
        });

        userList.addEventListener('click', function (e) {
            const btn = e.target.closest('button[data-userid]');
            if (!btn) return;

            document.querySelectorAll('.tenant-item').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            selectedUserId = btn.getAttribute('data-userid');
            selectedUserName = btn.getAttribute('data-hotenkhach');
            chatWith.innerHTML = `Đang chat với <strong class="text-primary">${selectedUserName}</strong>`;

            messageInput.disabled = false;
            sendBtn.disabled = false;
            chatMessages.innerHTML = '<div class="text-center my-auto"><div class="spinner-border text-primary opacity-20" role="status"></div></div>';
            loadChatHistory();
        });

        function loadChatHistory() {
            if (!selectedUserId) return;
            fetch('/ChuTroArea/Chat/GetChatHistory?userId=' + selectedUserId)
                .then(res => res.json())
                .then(data => {
                    chatMessages.innerHTML = '';
                    data.forEach(m => {
                        const isSender = m.senderId !== selectedUserId;
                        appendMessage(m.content, isSender, m.timestamp);
                    });
                })
                .catch(err => {
                    chatMessages.innerHTML = '<div class="alert alert-danger mx-3">Không thể tải tin nhắn.</div>';
                });
        }

        document.getElementById('chatForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const msg = messageInput.value.trim();
            if (!msg || !selectedUserId || connection.state !== 'Connected') return;
            connection.invoke("SendPrivateMessage", selectedUserId, msg);
            appendMessage(msg, true);
            messageInput.value = '';
            messageInput.focus();
        });

        (function autoSelectFromServer() {
            const preUserId = '@(ViewData["SelectedUserId"] ?? "")';
            if (!preUserId) return;
            const btn = userList.querySelector(`button[data-userid="${preUserId}"]`);
            if (btn) btn.click();
        })();

        // Thêm filter tìm kiếm khách
        document.getElementById('searchTenant').addEventListener('input', function(e) {
            const val = e.target.value.toLowerCase();
            document.querySelectorAll('.tenant-item').forEach(item => {
                const name = item.dataset.hotenkhach.toLowerCase();
                item.style.display = name.includes(val) ? 'flex' : 'none';
            });
        });
    </script>
}